{
	"name": "dotfiles",
	"version": "1.0.0",
	"description": "Personal dotfiles and configuration management",
	"author": "",
	"license": "ISC",
	"private": true,
	"packageManager": "bun@1.4.0",
	"workspaces": [
		".agents/runtime/agent-native-state-machine-generator",
		".agents/runtime/agent-worktree",
		".agents/runtime/cli-command-facade",
		".agents/runtime/cli-test-fixtures",
		".agents/runtime/session-corpus",
		"config/agents/skills/personal/bitbucket",
		"config/agents/skills/personal/classic-cinema",
		"config/agents/skills/personal/session-recovery",
		"config/agents/skills/personal/test-runner",
		"config/agents/skills/personal/worktree",
		"config/agents/skills/personal/xero",
		"config/agents/plugins/proof",
		"apps/vscode/*"
	],
	"catalog": {
		"@types/bun": "1.4.0",
		"typescript": "7.0.2"
	},
	"keywords": [],
	"scripts": {
		"biome:check": "biome check --diagnostic-level=error .",
		"check": "git diff --check && bun run biome:check && bun run typecheck && bun run test && bun run test:hooks && bun run --silent test:plugins && bun run test:quality:repository && bun run --silent quality:fallow && bun run --silent quality:fallow:runtime",
		"check:write": "biome check --write .",
		"lint": "biome lint --diagnostic-level=error .",
		"lint:fix": "biome lint --write .",
		"lint:scripts": "find . -type f \\( -name '*.sh' -o -name '*.bash' \\) ! -path './node_modules/*' ! -path './.worktrees/*' ! -path './.claude/worktrees/*' ! -path './.husky/_/*' -print0 | xargs -0 shellcheck -e SC1071 -S error",
		"lint:workflows": "if [ -d .github/workflows ]; then actionlint; else echo 'no .github/workflows; skipping'; fi",
		"prepare:check": "bun run tooling/plugin-preparation.ts",
		"prepare": "husky",
		"quality:fallow": "node_modules/.bin/fallow audit --format json --quiet --type-aware --type-aware-require best-effort",
		"quality:fallow:runtime": "bun run tooling/fallow-runtime-audit.ts",
		"test": "bun run --filter '*' test",
		"test:hooks": "bun test config/agents/claude/hooks",
		"test:plugins": "bun run tooling/plugin-tests.ts",
		"test:quality:repository": "bun test tooling/repository-quality/workspace-manifest.test.ts tooling/fallow-runtime-audit.test.ts tooling/repository-quality/plugin-tests.test.ts tooling/repository-quality/plugin-preparation.test.ts tooling/plugin-preparation.test.ts tooling/repository-quality/typescript-ownership.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
		"validate": "bun run check && bun run lint:scripts && bun run lint:workflows"
	},
	"dependencies": {
		"puppeteer": "^24.32.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/bun": "catalog:",
		"commitlint-config-git-commit-emoji": "^1.0.0",
		"fallow": "3.19.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"typescript": "catalog:"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mts,cts,json,md}": [
			"biome check --diagnostic-level=error --no-errors-on-unmatched"
		]
	}
}
