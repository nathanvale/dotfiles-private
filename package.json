{
	"name": "dotfiles",
	"version": "1.0.0",
	"description": "Personal dotfiles and configuration management",
	"author": "",
	"license": "ISC",
	"private": true,
	"workspaces": [
		".agents/runtime/agent-worktree",
		".agents/runtime/browser-connect",
		".agents/runtime/browser-use-security",
		".agents/runtime/cli-command-facade",
		".agents/runtime/cli-test-fixtures",
		".agents/runtime/mcporter-transport",
		".agents/runtime/session-corpus",
		".agents/runtime/warm-chrome",
		".agents/skills/bft-booking",
		".agents/skills/bitbucket",
		".agents/skills/browser-use",
		".agents/skills/browser-use-support-ticket",
		".agents/skills/ce-work-inspect",
		".agents/skills/classic-cinema",
		".agents/skills/cli-author",
		".agents/skills/cli-execution-auditor",
		".agents/skills/domain-modeling-retrospective",
		".agents/skills/fallow",
		".agents/skills/record-decision",
		".agents/skills/session-recovery",
		".agents/skills/skill-feedback",
		".agents/skills/skills-sync",
		".agents/skills/test-runner",
		".agents/skills/vault-git",
		".agents/skills/worktree",
		".agents/skills/xero",
		"apps/vscode/*"
	],
	"catalog": {
		"@types/bun": "1.3.14",
		"typescript": "6.0.3"
	},
	"keywords": [],
	"scripts": {
		"check": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"lint:scripts": "find . -type f \\( -name '*.sh' -o -name '*.bash' \\) ! -path './node_modules/*' ! -path './.worktrees/*' ! -path './.claude/worktrees/*' ! -path './.husky/_/*' -print0 | xargs -0 shellcheck -e SC1071 -S error",
		"lint:workflows": "if [ -d .github/workflows ]; then actionlint; else echo 'no .github/workflows; skipping'; fi",
		"memory:qmd-federation": "bun run $HOME/.config/context/scripts/qmd-roster-sync.ts",
		"prepare": "husky",
		"validate": "bun run lint && bun run format:check && bun run lint:scripts && bun run lint:workflows"
	},
	"dependencies": {
		"puppeteer": "^24.32.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"commitlint-config-git-commit-emoji": "^1.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mts,cts,json,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
