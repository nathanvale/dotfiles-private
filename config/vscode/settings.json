{
	"explorer.compactFolders": false,
	"[javascript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[markdown]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"chat.agent.maxRequests": 300,
	"chat.commandCenter.enabled": false,
	// Prevent Copilot search from scanning noisy folders
	"chat.search.exclude": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.next/**",
		"**/.turbo/**",
		"**/coverage/**"
	],
	// ============================================================================
	// AGENTIC WORKFLOWS — Auto-Approval + Stable Copilot Experience
	// ============================================================================
	"chat.tools.global.autoApprove": true,
	"chat.tools.terminal.autoApprove": {
		"chmod": false,
		"chown": false,
		"curl": false,
		"del": false,
		"eval": false,
		"kill": false,
		"rm": false,
		"rmdir": false,
		"wget": false
	},
	"chat.tools.terminal.enableAutoApprove": true,
	"editor.codeActionsOnSave": {
		"source.fixAll": "explicit"
	},
	"editor.codeActionsOnSaveTimeout": 2000,
	"editor.cursorBlinking": "smooth",
	// ============================================================================
	// FORMATTING — Prettier First, ESLint Beside It, No Conflicts
	// ============================================================================
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.fontFamily": "MesloLGS NF, Menlo, Monaco, 'Courier New', monospace",
	"editor.formatOnSave": true,
	// Hover popups softened — less visual noise
	"editor.hover.delay": 600,
	"editor.inlineSuggest.enabled": true,
	"editor.minimap.enabled": false,
	// ============================================================================
	// KEYBOARD / FLOW — Optional “Emergency Reset” (Stabilises Agent Sessions)
	// ============================================================================
	// (Add the keybinding manually if you want it — VS Code stores keybindings separately)
	"editor.smoothScrolling": true,
	// ============================================================================
	// ESLINT — Flat Config-Friendly, Zero Surprises
	// ============================================================================
	"eslint.enable": true,
	"eslint.useFlatConfig": true,
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact"
	],
	"eslint.workingDirectories": [
		{
			"mode": "auto"
		}
	],
	"explorer.confirmDelete": false,
	"files.autoSave": "afterDelay",
	"files.eol": "\n",
	"files.exclude": {
		"**/.DS_Store": true,
		"**/.git": true,
		"**/node_modules": true
	},
	"files.insertFinalNewline": true,
	// ============================================================================
	// FILESYSTEM — Noise Reduction + Speed + CPU Relief
	// ============================================================================
	"files.trimTrailingWhitespace": true,
	"files.watcherExclude": {
		"**/.git/**": true,
		"**/.next/**": true,
		"**/.turbo/**": true,
		"**/coverage/**": true,
		"**/dist/**": true,
		"**/node_modules/**": true
	},
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	// ============================================================================
	// GIT COMMIT MESSAGE VALIDATION — Match commitlint rules
	// ============================================================================
	"git.inputValidation": true,
	"git.inputValidationLength": 100,
	"git.inputValidationSubjectLength": 100,
	// github.copilot.chat.commitMessageGeneration.instructions is intentionally unset:
	// setting it at all (any content) makes the internal gpt-4o-mini utility model
	// false-positive the RAI content filter, so the sparkle button 422s every time.
	// See https://github.com/microsoft/vscode/issues/330331 and #327973 (unresolved upstream).
	// commitlint's husky hook is the enforcement point for subject-case instead.
	"github.copilot.chat.showWelcomeMessage": false,
	"github.copilot.chat.view": "editor",
	"github.copilot.editor.enableAutoCompletions": true,
	"gitlens.ai.model": "vscode",
	"gitlens.ai.vscode.model": "copilot:gpt-4.1",
	"multiCommand.commands": [
		{
			// 14" Laptop Mode: editor-focused, only primary sidebar visible
			"command": "layout.laptopMode",
			"sequence": [
				"workbench.action.closePanel", // hide bottom panel
				"workbench.action.maximizeEditorHideSidebar", // editor full, no sidebars
				"workbench.action.toggleSidebarVisibility" // turn primary sidebar back on
			]
		},
		{
			// 40" Big Monitor Mode: both sidebars visible, tidy editor widths
			"command": "layout.bigMonitor",
			"sequence": [
				"workbench.action.closePanel", // hide bottom panel
				"workbench.action.maximizeEditorHideSidebar", // start from clean editor-only
				"workbench.action.toggleSidebarVisibility", // show primary sidebar (left)
				"workbench.action.toggleAuxiliaryBar", // show secondary sidebar (right)
				"workbench.action.evenEditorWidths" // balance editor groups
			]
		}
	],
	// ============================================================================
	// NOTIFICATIONS — No Popup Intrusions
	// ============================================================================
	"notifications.notificationToasts": "never",
	"prettier.requireConfig": true,
	"prettier.useEditorConfig": true,
	"search.exclude": {
		"**/.next": true,
		"**/.turbo": true,
		"**/coverage": true,
		"**/dist": true,
		"**/node_modules": true
	},
	"tab.lastPinnedTabsOverflow": true,
	"terminal.integrated.allowChording": false,
	// Terminals open in editor tabs (stable, predictable, never shove panels around)
	"terminal.integrated.defaultLocation": "editor",
	"terminal.integrated.defaultProfile.osx": "zsh",
	// VS Code inherits its environment from whatever launched it. When that is
	// a non-interactive command runner, NO_COLOR=1 and TERM=dumb leak into the
	// app process and then into every integrated terminal, so TUIs render
	// monochrome. Interactive zsh already repairs this at .zshrc:73, but a
	// terminal profile that runs a binary directly never sources .zshrc.
	// Clearing it here fixes every terminal, shell or not.
	// Documented since VS Code 1.18: null removes the variable.
	"terminal.integrated.env.osx": {
		"NO_COLOR": null
	},
	// Named terminal profile so a keybinding can launch lazygit directly.
	// Merges with VS Code's built-in profiles; it does not replace them.
	// Inherits terminal.integrated.defaultLocation ("editor") unless the
	// keybinding overrides it.
	"terminal.integrated.profiles.osx": {
		"lazygit": {
			"path": "lazygit",
			"icon": "git-branch",
			// This profile runs lazygit as the shell process, bypassing .zshrc,
			// so it declares the terminal capability that .zshrc:74 exports.
			"env": {
				"TERM": "xterm-256color",
				"COLORTERM": "truecolor"
			}
		}
	},
	// ============================================================================
	// TERMINAL STABILITY — Prevent Focus Stealing + Predictable Layout
	// ============================================================================
	"terminal.integrated.focusAfterExecution": false,
	"terminal.integrated.revealOnCommand": "never",
	"terminal.integrated.revealOnStartup": "never",
	"terminal.integrated.splitCwd": "inherited",
	"terminal.integrated.startInInteractiveShell": false,
	"window.commandCenter": false,
	"workbench.colorTheme": "Night Owl",
	"workbench.editor.enablePreviewFromQuickOpen": true,
	// Tabs easier to see + keep track of
	"workbench.editor.highlightModifiedTabs": true,
	"workbench.editor.wrapTabs": true,
	// Keep sidebar anchored, no layout surprises
	"workbench.layoutControl.enabled": false,
	"workbench.navigationControl.enabled": false,
	"workbench.sideBar.location": "left",
	"workbench.startupEditor": "none",
	// Calm animations
	"workbench.useExperimentalGridLayout": false,
	"zenMode.centerLayout": true,
	"zenMode.fullScreen": false,
	"zenMode.hideActivityBar": true,
	"zenMode.hideLineNumbers": false,
	"zenMode.hideStatusBar": true,
	"zenMode.restore": true,
	"zenMode.showTabs": "single",
	"zenMode.silentNotifications": true,
	"editor.stickyScroll.enabled": false,
	"claudeCode.preferredLocation": "panel",
	"github.copilot.chat.agent.autoFix": true,
	"github.copilot.chat.anthropic.tools.websearch.enabled": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": false,
		"markdown": true,
		"scminput": false
	},
	"github.copilot.nextEditSuggestions.enabled": true,
	"git.autofetch": true,
	"json.schemaDownload.trustedDomains": {
		"https://schemastore.azurewebsites.net/": true,
		"https://raw.githubusercontent.com/": true,
		"https://www.schemastore.org/": true,
		"https://json.schemastore.org/": true,
		"https://json-schema.org/": true,
		"https://biomejs.dev": true
	},
	// ============================================================================
	// MARKDOWN PREVIEW ENHANCED — GitHub Dark Mode
	// ============================================================================
	"markdown-preview-enhanced.frontMatterRenderingOption": "table",
	"markdown-preview-enhanced.previewTheme": "vscode.css",
	"markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
	"markdown-preview-enhanced.previewColorScheme": "systemColorScheme",
	"markdown-preview-enhanced.mermaidTheme": "dark",
	"markdown-preview-enhanced.automaticallyShowPreviewOfMarkdownBeingEdited": false,
	"markdown-preview-enhanced.enableScriptExecution": true,
	"markdown.preview.doubleClickToSwitchToEditor": true,
	// Markdown files open in VS Code's built-in preview by default
	// Keep last: VS Code bug #192954
	// Use "Reopen Editor With..." > Text Editor when editing one file directly
	"workbench.editorAssociations": {
		"*.copilotmd": "vscode.markdown.preview.editor",
		"*.md": "vscode.markdown.editor"
	},
	"diffEditor.renderSideBySide": true,
	"workbench.editor.showTabs": "multiple",
	"diffEditor.experimental.showMoves": true,
	"explorer.sortOrder": "modified",
	"explorer.fileNesting.enabled": true,
	// Keep the right-hand panel present so Ctrl+G G can restore the
	// Source Control Graph into it. View placement itself is workbench
	// state, not a setting, so a fresh machine needs one manual drag.
	"workbench.secondarySideBar.defaultVisibility": "visible",
	"search.sortOrder": "modified",
	"workbench.activityBar.compact": true,
	"workbench.secondarySideBar.showLabels": false,
	"editor.accessibilitySupport": "on"
}
