# =============================================================================
# SERVER PROFILE - Headless, containers, AI workloads
# =============================================================================
# Profile-owned OrbStack, Ollama, and the preexisting LM Studio CLI are declared
# by the shared requirement table appended below.
if profile == "server"
  # Browsers
  cask "google-chrome"         # Development/testing, headless automation

  # cask "ollama-app"            # Ollama GUI wrapper
  # brew "docker"                # Docker CLI
  # brew "colima"                # Lightweight container VM
