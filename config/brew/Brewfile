end

profile_requirements.each do |scope, _severity, package_type, package_name, _label, _check_kind, _check_value, _phase, _inactive_behavior|
  next unless scope == "all" || scope == profile
  next unless package_type == "cask" || package_type == "brew"

  send(package_type, package_name)
end
