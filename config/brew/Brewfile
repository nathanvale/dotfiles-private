# Brewfile - Unified package manifest with profile conditionals
#
# Profiles: desktop | headless server
#
# Usage:
#   HOMEBREW_DOTFILES_PROFILE=desktop brew bundle --file=~/code/dotfiles/config/brew/Brewfile
#   HOMEBREW_DOTFILES_PROFILE=server brew bundle --file=~/code/dotfiles/config/brew/Brewfile
#   HOMEBREW_DOTFILES_PROFILE=desktop HOMEBREW_DOTFILES_VM_HOST=1 brew bundle --file=~/code/dotfiles/config/brew/Brewfile
#
# NOTE: Environment variables must be prefixed with HOMEBREW_ to be passed through
# to Brewfile Ruby evaluation. Regular env vars are filtered out by Homebrew.
#
# Brewfiles are Ruby, so we can use conditionals for profile-specific packages.

# The verifier's profile-owned package requirements are kept in one tab-separated
# table. Homebrew evaluates the same rows that verify_install.sh consumes.
requirements_path = File.join(__dir__, "profile-requirements.tsv")
profile_requirements = File.readlines(requirements_path).each_with_object([]) do |raw_line, rows|
  line = raw_line.chomp
  next if line.empty? || line.start_with?("#")

  fields = line.split("\t", -1)
  raise "invalid profile requirement row" unless fields.length == 9

  scope, severity, package_type, package_name, label, check_kind, check_value, phase, inactive_behavior = fields
  valid = %w[all desktop server].include?(scope) &&
    %w[required warn].include?(severity) &&
    %w[cask brew preexisting].include?(package_type) &&
    !package_name.empty? && !label.empty? && !check_value.empty? &&
    %w[app command home-executable].include?(check_kind) &&
    %w[applications server].include?(phase) &&
    %w[omit skip].include?(inactive_behavior)
  raise "invalid profile requirement row" unless valid

  rows << fields
end

# Profile detection (defaults to desktop)
# MUST use HOMEBREW_ prefix for env vars to work in Brewfile context
profile = ENV.fetch("HOMEBREW_DOTFILES_PROFILE", "desktop")
raise "invalid HOMEBREW_DOTFILES_PROFILE: #{profile.inspect} (expected \"desktop\" or \"server\")" unless %w[desktop server].include?(profile)
vm_host = ENV.fetch("HOMEBREW_DOTFILES_VM_HOST", "0")
raise "invalid HOMEBREW_DOTFILES_VM_HOST: #{vm_host.inspect} (expected \"0\" or \"1\")" unless %w[0 1].include?(vm_host)

