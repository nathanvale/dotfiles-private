{
	"name": "session-recovery-scripts",
	"private": true,
	"type": "module",
	"scripts": {
		"session-recovery": "bun --no-install dist/cli.js",
		"lint": "biome check --diagnostic-level=error .",
		"test": "bun test src/*.test.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build:bundle": "NODE_ENV=production bun build --target bun --minify-whitespace src/cli.ts --outdir dist"
	},
	"dependencies": {
		"@side-quest/session-corpus": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"typescript": "catalog:"
	}
}
