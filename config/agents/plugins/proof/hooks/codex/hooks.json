{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/hooks/fallow-ci.ts\" --harness=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/hooks/biome-ci.ts\" --harness=codex",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/hooks/biome-ci.ts\" --harness=codex",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/hooks/fallow-ci.ts\" --harness=codex",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"${PLUGIN_ROOT}/hooks/typecheck-ci.ts\" --harness=codex",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
