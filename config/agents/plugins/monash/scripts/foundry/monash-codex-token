#!/usr/bin/env -S python3 -I -B
"""Codex provider auth command for the Monash Foundry Responses route.

Codex runs this installed file as `[model_providers.monash_foundry.auth].command`
and reads one bearer value from its stdout. It resolves the installed
config.json `codex.credential_ref` through the dotfiles 1Password wrapper and
writes that one value to a pipe. Never run it by hand: it refuses a terminal on
stdin or stdout, prints nothing to stdout on any failure, and exits non-zero so
Codex records the failure.

Codex does not stop a turn when this command fails: it sends the request without
an Authorization header and Azure answers 401. This command is therefore not the
only gate; see README.md, "Codex desktop provider".

Must stay runnable by the macOS system Python 3.9, which a GUI-launched Codex
may resolve first on PATH. The shebang runs Python isolated (-I), so nothing
beside this file, PYTHONPATH or user site code is imported before admission.
"""

from __future__ import annotations

import os
import stat
import subprocess
import sys
import types
from pathlib import Path


SCRIPT_DIR = Path(__file__).resolve().parent
LAUNCHER_PATH = SCRIPT_DIR / "monash-foundry"
CONFIG_PATH = SCRIPT_DIR / "config.json"
ENV_KEY = "AZURE_OPENAI_API_KEY"
PRINTENV = "/usr/bin/printenv"
# Below the provider table's timeout_ms (30000) so this command, not Codex,
# owns the bounded failure.
WRAPPER_TIMEOUT_SECONDS = 20
MAX_TOKEN_BYTES = 4096


class TokenRefusal(Exception):
    def __init__(self, message: str, repair: str, code: int = 3):
        super().__init__(message)
        self.message = message
        self.repair = repair
        self.code = code


# --- shared trust rules: keep byte-identical in monash-codex-token and monash-codex-desktop ---
class Untrusted(Exception):
    """A path is not admitted: wrong type, owner, mode, link, or enclosing directory."""


def _trusted_entry(info: os.stat_result) -> bool:
    """Owned by this user or root, and writable by no one else (a root sticky directory excepted)."""
    if info.st_uid not in (os.getuid(), 0):
        return False
    if info.st_mode & 0o022 and not (stat.S_ISDIR(info.st_mode) and info.st_mode & stat.S_ISVTX and info.st_uid == 0):
        return False
    return True


def trusted_directory(directory: Path) -> bool:
    """Every component, as written and as resolved, is a trusted entry."""
    if not directory.is_absolute():
        return False
    try:
        written = [os.lstat(component) for component in (directory, *directory.parents)]
        resolved_path = directory.resolve(strict=True)
        resolved = [os.stat(component) for component in (resolved_path, *resolved_path.parents)]
    except OSError:
        return False
    return stat.S_ISDIR(resolved[0].st_mode) and all(_trusted_entry(info) for info in (*written, *resolved))


def admit(path: Path, executable: bool = False) -> int:
    """A read-only no-follow descriptor on a private regular file in trusted directories."""
    if not path.is_absolute() or not trusted_directory(path.parent):
        raise Untrusted(str(path))
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise Untrusted(str(path)) from error
    info = os.fstat(descriptor)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_mode & 0o022
        or (executable and not info.st_mode & stat.S_IXUSR)
    ):
        os.close(descriptor)
        raise Untrusted(str(path))
    return descriptor


def trusted_file(path: Path, executable: bool = False) -> bool:
    try:
        os.close(admit(path, executable))
    except Untrusted:
        return False
    return True


def load_admitted_module(name: str, path: Path):
    """Execute only bytes read through an admitted descriptor, never a path-following import."""
    with os.fdopen(admit(path), "rb") as handle:
        source = handle.read()
    module = types.ModuleType(name)
    module.__file__ = str(path)
    sys.modules[name] = module
    exec(compile(source, str(path), "exec", dont_inherit=True), module.__dict__)
    return module


def load_admitted_config(launcher, path: Path):
    """Parse config.json from an admitted descriptor with the launcher's own parser."""
    descriptor = admit(path)
    try:
        return launcher.load_config(Path(f"/dev/fd/{descriptor}"))
    finally:
        os.close(descriptor)
# --- end shared trust rules ---


def resolve_wrapper(launcher, config) -> Path:
    """The configured absolute wrapper, else the dotfiles wrapper. Never a PATH or cwd lookup."""
    configured = config.commands.get("with_one_password_token")
    if configured is not None:
        wrapper = Path(configured).expanduser()
        if not wrapper.is_absolute():
            raise TokenRefusal(
                "commands.with_one_password_token must be an absolute path",
                "set an absolute wrapper path in config.json or remove the override",
            )
    else:
        wrapper = launcher.DEFAULT_WRAPPER
    if not trusted_file(wrapper, executable=True):
        raise TokenRefusal(
            "the 1Password wrapper is unavailable or not a private executable in trusted directories",
            "install bin/with-one-password-token owned by you and writable only by you",
        )
    return wrapper


def valid_token(stdout: bytes) -> bytes:
    value = stdout[:-1] if stdout.endswith(b"\n") else stdout
    if not value:
        raise TokenRefusal("the credential reference resolved to an empty value", "repair the 1Password item")
    if len(value) > MAX_TOKEN_BYTES or any(byte < 0x21 or byte > 0x7E for byte in value):
        raise TokenRefusal(
            "the credential reference did not resolve to one printable token",
            "repair the 1Password item so it holds only the API key",
        )
    return value


def resolve_token() -> bytes:
    try:
        launcher = load_admitted_module("monash_foundry_launcher", LAUNCHER_PATH)
    except Untrusted as error:
        raise TokenRefusal(
            "the installed launcher is not a private file in trusted directories",
            "reinstall the complete Foundry snapshot with scripts/foundry/install.py",
        ) from error
    except Exception as error:  # any import failure is a refusal, never a token
        raise TokenRefusal(
            f"the installed launcher could not be loaded ({type(error).__name__})",
            "reinstall the complete Foundry snapshot with scripts/foundry/install.py",
        ) from error
    try:
        config = load_admitted_config(launcher, CONFIG_PATH)
    except Untrusted as error:
        raise TokenRefusal(
            "the installed config.json is not a private file in trusted directories",
            "reinstall the complete Foundry snapshot with scripts/foundry/install.py",
        ) from error
    except launcher.LauncherError as error:
        raise TokenRefusal(error.message, error.repair or "repair the installed config.json") from error
    reference = config.codex.credential_ref
    if not reference.startswith("op://"):
        raise TokenRefusal("codex.credential_ref is not a 1Password reference", "set an op:// reference in config.json")
    wrapper = resolve_wrapper(launcher, config)
    environment = launcher.codex_wrapper_environment(launcher.sanitized_environment()[0])
    try:
        result = subprocess.run(
            [str(wrapper), "inject", ENV_KEY, reference, "--", PRINTENV, ENV_KEY],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            env=environment,
            timeout=WRAPPER_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise TokenRefusal("the 1Password wrapper timed out", "run `with-one-password-token check`") from error
    except OSError as error:
        raise TokenRefusal("the 1Password wrapper could not start", "run `with-one-password-token check`") from error
    if result.returncode != 0:
        raise TokenRefusal(
            f"the 1Password wrapper failed with exit status {result.returncode}",
            "run `with-one-password-token check`",
        )
    return valid_token(result.stdout)


def main(argv) -> int:
    try:
        if argv:
            raise TokenRefusal("this command takes no arguments", "configure it with args = []", code=2)
        if sys.stdin.isatty() or sys.stdout.isatty():
            raise TokenRefusal(
                "refusing to resolve a credential for a terminal",
                "this command is only for Codex's provider auth; do not run it by hand",
                code=2,
            )
        token = resolve_token()
    except Exception as error:  # every failure is a bounded refusal with nothing on stdout
        refusal = error if isinstance(error, TokenRefusal) else TokenRefusal(
            f"unexpected failure ({type(error).__name__})", "report this defect"
        )
        print(f"monash-codex-token: {refusal.message}", file=sys.stderr)
        print(f"repair: {refusal.repair}", file=sys.stderr)
        return refusal.code
    sys.stdout.buffer.write(token + b"\n")
    sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
