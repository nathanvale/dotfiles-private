#!/usr/bin/env python3
"""Hand one bounded unit to a non-interactive Monash Codex worker and check its handback.

`run` sends a brief as one `codex exec --profile monash-sol` turn in the worker
Codex home that install.py manages (~/.codex-monash-sol), enforces a
wall-clock bound, and writes a receipt from the worker's session record. `prepare`
writes the same prompt for a Herdr pane worker, which writes its own handback
file. `check` judges an output directory, such as a pane worker's.
One call is one unit; a coordinator fans out by running several calls at once.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import time
from typing import Optional


SCHEMA_VERSION = 1
SCRIPT_DIR = Path(__file__).resolve().parent
LAUNCHER = SCRIPT_DIR / "monash-foundry"
# install.py owns this home and its two files; see its worker home section.
WORKER_HOME_NAME = ".codex-monash-sol"
WORKER_PROFILE = "monash-sol"
WORKER_PROVIDER = "monash_foundry"
DEFAULT_MODEL = "gpt-6.1-sol"
DEFAULT_EFFORT = "high"
DEFAULT_TIMEOUT_SECONDS = 1800
KILL_GRACE_SECONDS = 10
SANDBOXES = ("read-only", "workspace-write")

BRIEF_FILE = "brief.md"
PROMPT_FILE = "prompt.md"
EVENTS_FILE = "events.jsonl"
CODEX_LOG_FILE = "codex.log"
HANDBACK_FILE = "last-message.md"
RECEIPT_FILE = "receipt.json"
# A pane run's own files: the script the pane runs, its process id, and codex's exit code.
RUN_SCRIPT = "run.sh"
PID_FILE = "worker.pid"
EXIT_CODE_FILE = "exit-code"
PANE_START_SECONDS = 30
PANE_POLL_SECONDS = 0.2
DEFAULT_HERDR_SESSION = "default"

# The handback convention has one owner: every prompt ends with this text.
HANDBACK_RULES = """
---
Handback rules (added by monash-worker):
- Stay inside this brief. Do not push, open or edit pull requests, post, or message anyone.
- Your final message is the handback. Cite evidence as path:line, or as a command and its output.
- End the final message with exactly one of these lines:
  HANDBACK: done
  HANDBACK: blocked: <one-line reason>
"""
# The final non-blank line must be exactly one marker; `done` takes no suffix.
HANDBACK_PREFIX = "HANDBACK:"
HANDBACK_LINE = re.compile(rf"^{HANDBACK_PREFIX} (?:(?P<done>done)|blocked: (?P<reason>\S.*))$")

# Exit codes are the public contract for callers that do not parse JSON.
EXIT = {"done": 0, "prepared": 0, "usage": 2, "blocked": 3, "timed_out": 4, "failed": 5, "interrupted": 130}


class UsageError(Exception):
    pass


def read_handback(out: Path) -> dict[str, Optional[str]]:
    path = out / HANDBACK_FILE
    text = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    if not text.strip():
        return {"status": None, "reason": "no final message was written"}
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    match = HANDBACK_LINE.match(lines[-1])
    if match and any(line.startswith(HANDBACK_PREFIX) for line in lines[:-1]):
        return {"status": None, "reason": "final message has more than one HANDBACK line"}
    if match:
        return {"status": "done" if match.group("done") else "blocked", "reason": match.group("reason")}
    if any(line.startswith(HANDBACK_PREFIX) for line in lines):
        return {"status": None, "reason": "final line is not an exact HANDBACK marker"}
    return {"status": None, "reason": "final message has no HANDBACK line"}


def worker_home() -> Path:
    return Path.home() / WORKER_HOME_NAME


def require_private_home(codex_home: Path) -> None:
    """The home and its managed files must be the installer's: owned, private, never links."""
    profile = codex_home / f"{WORKER_PROFILE}.config.toml"
    if not os.path.lexists(profile) and not codex_home.is_symlink():
        raise UsageError(f"{codex_home} has no {WORKER_PROFILE} profile; run scripts/foundry/install.py")
    checks = ((codex_home, stat.S_ISDIR, 0o700),
              (codex_home / "config.toml", stat.S_ISREG, 0o600), (profile, stat.S_ISREG, 0o600))
    for path, kind, mode in checks:
        try:
            info = os.lstat(path)
        except FileNotFoundError:
            info = None
        if info is None or not kind(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != mode:
            raise UsageError(f"{path} is not a private worker home entry (owned, mode {mode:o}, not a link); "
                             "run scripts/foundry/install.py")


def load_launcher():
    """monash-foundry owns which environment names a Codex worker may inherit."""
    if not LAUNCHER.is_file():
        raise UsageError(f"{LAUNCHER} is missing; reinstall with scripts/foundry/install.py")
    loader = importlib.machinery.SourceFileLoader("monash_foundry_for_worker", str(LAUNCHER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module  # its dataclasses resolve their module through sys.modules
    previous, sys.dont_write_bytecode = sys.dont_write_bytecode, True
    try:
        loader.exec_module(module)
    finally:
        sys.dont_write_bytecode = previous
    return module


def worker_environment(codex_home: Path) -> dict[str, str]:
    """Only the names the launcher route passed to Codex, plus the worker home; never credentials."""
    launcher = load_launcher()
    source = os.environ
    environment = {name: source[name] for name in (*launcher.WRAPPER_ENV_NAMES, *launcher.CODEX_ENV_HOP_NAMES)
                   if name in source}
    if environment.get("HERDR_AGENT") != "codex":
        environment.pop("HERDR_AGENT", None)
    for name in ("TERM", "SSH_CONNECTION"):
        value = launcher.safe_public_env_value(source.get(name))
        if value is not None:
            environment[name] = value
    environment["CODEX_HOME"] = str(codex_home)
    return environment


def read_route(codex_home: Path, thread_id: object) -> Optional[dict[str, object]]:
    """The settings Codex last applied to the thread, and any model reroutes, from its session record."""
    if not isinstance(thread_id, str) or not re.fullmatch(r"[0-9A-Za-z-]+", thread_id):
        return None
    route: Optional[dict[str, object]] = None
    reroutes: list[dict[str, object]] = []
    for path in sorted((codex_home / "sessions").glob(f"**/rollout-*-{thread_id}.jsonl")):
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            try:
                payload = json.loads(line).get("payload")
            except (json.JSONDecodeError, AttributeError):
                continue
            if not isinstance(payload, dict):
                continue
            if payload.get("type") == "thread_settings_applied":
                settings = payload.get("thread_settings") or {}
                permissions = settings.get("permission_profile") or {}
                route = {
                    "model": settings.get("model"),
                    "provider": settings.get("model_provider_id"),
                    "service_tier": settings.get("service_tier"),
                    "effort": settings.get("reasoning_effort"),
                    "network": permissions.get("network") if isinstance(permissions, dict) else None,
                    "session_file": str(path),
                }
            elif payload.get("type") == "model_reroute":
                reroutes.append({"from": payload.get("from_model"), "to": payload.get("to_model")})
    if route is not None:
        route["reroutes"] = reroutes
    return route


SESSION_ID_LINE = re.compile(r"^session id: (\S+)$")


def read_events(out: Path) -> dict[str, object]:
    found: dict[str, object] = {"thread_id": None, "usage": None, "errors": []}
    path = out / EVENTS_FILE
    if not path.is_file():
        # A pane run shows Codex's human output, whose header names the session.
        log = out / CODEX_LOG_FILE
        if log.is_file():
            for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
                match = SESSION_ID_LINE.match(line.strip())
                if match:
                    found["thread_id"] = match.group(1)
                    break
        return found
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        kind = event.get("type") if isinstance(event, dict) else None
        if kind == "thread.started":
            found["thread_id"] = event.get("thread_id")
        elif kind == "turn.completed":
            found["usage"] = event.get("usage")
        elif kind in ("error", "turn.failed"):
            found["errors"].append(event.get("message") or event.get("error"))
    return found


def judge(out: Path, model: str, launch: Optional[dict[str, object]],
          recorded_route: Optional[dict[str, object]] = None) -> dict[str, object]:
    """Build the receipt from files on disk; `launch` is None for a pane worker."""
    handback = read_handback(out)
    events = read_events(out)
    codex_home = launch.get("codex_home") if launch is not None else None
    if codex_home:
        route = read_route(Path(str(codex_home)), events["thread_id"])
    else:
        # A 0.2.x receipt has no session record to re-read; its recorded launcher route still counts.
        route = recorded_route if launch is not None else None
    problems: list[str] = []
    if launch is not None:
        if launch["start_error"]:
            problems.append(f"codex did not start: {launch['start_error']}")
        elif launch["timed_out"]:
            problems.append(f"no handback within {launch['timeout_seconds']} seconds")
        elif launch["exit_code"] is None:
            problems.append(f"codex ended without an exit code (was its pane closed?); read {CODEX_LOG_FILE}")
        elif launch["exit_code"] != 0:
            problems.append(f"codex exited {launch['exit_code']}; read {CODEX_LOG_FILE}")
        if codex_home and route is None:
            problems.append(f"no session record for thread {events['thread_id']} in {codex_home}")
        elif route is None:
            problems.append("receipt records no route")
        else:
            if route.get("model") != model:
                problems.append(f"route ran {route.get('model')}, not the requested {model}")
            for reroute in route.get("reroutes") or []:
                problems.append(f"session rerouted the model from {reroute['from']} to {reroute['to']}")
            if codex_home and route["provider"] != WORKER_PROVIDER:
                problems.append(f"route used provider {route['provider']}, not {WORKER_PROVIDER}")
    if handback["status"] is None:
        problems.append(str(handback["reason"]))
    if launch is not None and launch["timed_out"]:
        status = "timed_out"
    elif problems:
        status = "failed"
    else:
        status = str(handback["status"])
    return {
        "schema_version": SCHEMA_VERSION,
        "status": status,
        "problems": problems,
        "requested_model": model,
        "route": route,
        "thread_id": events["thread_id"],
        "usage": events["usage"],
        "worker_errors": events["errors"],
        "handback": handback,
        "launch": launch,
        "out": str(out),
        "handback_file": str(out / HANDBACK_FILE),
    }


def write_receipt(out: Path, receipt: dict[str, object]) -> int:
    (out / RECEIPT_FILE).write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(receipt))
    return EXIT[str(receipt["status"])]


def prepare_out(out: Path) -> None:
    if out.exists() and (not out.is_dir() or any(out.iterdir())):
        raise UsageError(f"--out {out} already holds results; choose a new directory per unit")
    out.mkdir(parents=True, exist_ok=True)


def signal_group(process: subprocess.Popen[bytes], sig: signal.Signals) -> None:
    try:
        os.killpg(process.pid, sig)
    except ProcessLookupError:
        pass


def stop(process: subprocess.Popen[bytes]) -> None:
    """Stop codex and every process left in its group, even ones that ignore SIGTERM."""
    signal_group(process, signal.SIGTERM)
    try:
        process.wait(timeout=KILL_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        pass
    signal_group(process, signal.SIGKILL)
    process.wait()


class Herdr:
    """The Herdr CLI for one named session; every call is explicit about its session."""

    def __init__(self, session: str):
        self.session = session
        binary = shutil.which("herdr")
        if binary is None:
            raise UsageError("herdr is not on PATH; install Herdr, or run without --pane and say "
                             "that no Herdr session was available")
        self.binary = binary

    def call(self, *args: str) -> dict[str, object]:
        result = subprocess.run([self.binary, "--session", self.session, *args], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
        if result.returncode != 0:
            raise OSError(0, f"herdr {' '.join(args[:2])} exited {result.returncode}")
        try:
            value = json.loads(result.stdout) if result.stdout.strip() else {}
        except json.JSONDecodeError as error:
            raise OSError(0, f"herdr {' '.join(args[:2])} returned unreadable output") from error
        return value if isinstance(value, dict) else {}

    def require_running(self) -> None:
        try:
            server = self.call("status", "--json").get("server") or {}
        except (OSError, subprocess.TimeoutExpired):
            server = {}
        if not (isinstance(server, dict) and server.get("running")):
            raise UsageError(f"no Herdr session '{self.session}' is running; start Herdr (or name a running "
                             "one with --herdr-session), or run without --pane and say that no Herdr "
                             "session was available")


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def stop_pane_group(pid: int) -> None:
    """Stop the pane's worker job (its own process group under the pane's shell)."""
    try:
        group = os.getpgid(pid)
    except ProcessLookupError:
        return
    for sig, grace in ((signal.SIGTERM, KILL_GRACE_SECONDS), (signal.SIGKILL, 0)):
        try:
            os.killpg(group, sig)
        except ProcessLookupError:
            return
        deadline = time.monotonic() + grace
        while alive(pid) and time.monotonic() < deadline:
            time.sleep(PANE_POLL_SECONDS)


def run_in_pane(herdr: Herdr, argv: list[str], environment: dict[str, str], out: Path, cwd: Path,
                timeout_seconds: int) -> tuple[bool, Optional[str], Optional[int], dict[str, object]]:
    """Run the same codex command in a new unfocused Herdr tab; close it once the result is captured."""
    q = shlex.quote
    exit_partial, exit_file, pid_file = out / f"{EXIT_CODE_FILE}.partial", out / EXIT_CODE_FILE, out / PID_FILE
    assignments = " ".join(q(f"{name}={value}") for name, value in environment.items() if name != "SSH_CONNECTION")
    # The pane's own SSH_CONNECTION (public metadata) tells the 1Password wrapper to use the desktop
    # keychain, as the launcher route forwards it; the caller's value describes a different shell.
    assignments += ' ${SSH_CONNECTION:+"SSH_CONNECTION=$SSH_CONNECTION"}'
    script = out / RUN_SCRIPT
    script.write_text("\n".join((
        "#!/bin/sh",
        f"# monash-worker pane unit: {out}",
        f"echo $$ > {q(str(pid_file))}",
        # env -i: the pane's own shell environment never reaches the worker.
        f"( env -i {assignments} {' '.join(q(arg) for arg in argv)} < {q(str(out / PROMPT_FILE))}; "
        f"echo $? > {q(str(exit_partial))} ) 2>&1 | tee {q(str(out / CODEX_LOG_FILE))}",
        f"mv {q(str(exit_partial))} {q(str(exit_file))}",
        "",
    )), encoding="utf-8")
    facts: dict[str, object] = {"session": herdr.session}
    timed_out, start_error, exit_code, pid = False, None, None, None
    started = time.monotonic()
    try:
        created = herdr.call("tab", "create", "--no-focus", "--label", f"sol: {out.name}", "--cwd", str(cwd))
        result = created.get("result") or {}
        facts["tab"] = (result.get("tab") or {}).get("tab_id")
        facts["pane"] = (result.get("root_pane") or {}).get("pane_id")
        if not facts["tab"] or not facts["pane"]:
            raise OSError(0, "herdr tab create returned no tab or pane")
        herdr.call("pane", "run", str(facts["pane"]), f"sh {q(str(script))}")
        while True:
            if exit_file.is_file():
                exit_code = int(exit_file.read_text().strip() or "-1")
                break
            if pid is None and pid_file.is_file() and pid_file.read_text().strip():
                pid = int(pid_file.read_text().strip())
            now = time.monotonic()
            if pid is None and now - started > min(PANE_START_SECONDS, timeout_seconds):
                start_error = f"the pane did not start the worker within {PANE_START_SECONDS} seconds"
                break
            if pid is not None and not alive(pid):
                if exit_file.is_file():
                    continue
                break
            if now - started >= timeout_seconds:
                timed_out = True
                if pid is not None:
                    stop_pane_group(pid)
                break
            time.sleep(PANE_POLL_SECONDS)
    except OSError as error:
        start_error = error.strerror or type(error).__name__
    except BaseException:
        if pid is not None:
            stop_pane_group(pid)
        raise
    finally:
        if facts.get("tab"):
            try:
                herdr.call("tab", "close", str(facts["tab"]))
            except (OSError, subprocess.TimeoutExpired) as error:
                facts["close_error"] = getattr(error, "strerror", None) or type(error).__name__
    return timed_out, start_error, exit_code, facts


def compose(brief_arg: str, out_arg: str, *, file_handback: bool) -> Path:
    """Copy the brief into a fresh out directory and write the prompt the worker receives."""
    brief = Path(brief_arg).expanduser()
    try:
        text = brief.read_text(encoding="utf-8") if brief.is_file() else ""
    except UnicodeDecodeError as error:
        raise UsageError(f"--brief {brief} is not UTF-8 text") from error
    if not text.strip():
        raise UsageError(f"--brief {brief} is missing or empty")
    out = Path(out_arg).expanduser().absolute()
    prepare_out(out)
    (out / BRIEF_FILE).write_text(text, encoding="utf-8")
    prompt = text.rstrip("\n") + "\n" + HANDBACK_RULES
    if file_handback:
        # A pane worker has no -o flag, so it writes the handback file itself.
        prompt += f"- Also write the complete final message to {out / HANDBACK_FILE}\n"
    (out / PROMPT_FILE).write_text(prompt, encoding="utf-8")
    return out


def prepare(args: argparse.Namespace) -> int:
    out = compose(args.brief, args.out, file_handback=True)
    print(json.dumps({"schema_version": SCHEMA_VERSION, "status": "prepared", "out": str(out),
                      "prompt_file": str(out / PROMPT_FILE),
                      "send": f"Read {out / PROMPT_FILE} and do exactly what it says."}))
    return EXIT["prepared"]


def run(args: argparse.Namespace) -> int:
    cwd = Path(args.cwd).expanduser()
    if not cwd.is_absolute() or not cwd.is_dir():
        raise UsageError(f"--cwd {cwd} must be an existing absolute directory")
    if args.timeout_seconds <= 0:
        raise UsageError("--timeout-seconds must be positive")
    codex_home = worker_home()
    require_private_home(codex_home)
    environment = worker_environment(codex_home)
    herdr = Herdr(args.herdr_session) if args.pane else None
    if herdr is not None:
        herdr.require_running()  # refuse before any unit file exists; never fall back to exec
    out = compose(args.brief, args.out, file_handback=False)

    codex = shutil.which("codex")
    argv = [codex or "codex", "exec", "--profile", WORKER_PROFILE, "-m", args.model,
            "-c", f"model_reasoning_effort={args.effort}",
            *(("-s", args.sandbox) if args.sandbox else ()),
            "-C", str(cwd), "--skip-git-repo-check", *(() if herdr else ("--json",)),
            "-o", str(out / HANDBACK_FILE), "-"]
    started = time.monotonic()
    pane_facts: Optional[dict[str, object]] = None
    if herdr is not None:
        if codex is None:
            timed_out, start_error, exit_code = False, "codex is not on PATH", None
        else:
            timed_out, start_error, exit_code, pane_facts = run_in_pane(
                herdr, argv, environment, out, cwd, args.timeout_seconds)
    else:
        timed_out, start_error, exit_code = run_exec(argv, codex, environment, out, args.timeout_seconds)
    launch = {
        "agent": "codex",
        "shape": "pane" if herdr is not None else "exec",
        **({"herdr": pane_facts} if pane_facts is not None else {}),
        "codex_home": str(codex_home),
        "profile": WORKER_PROFILE,
        "effort": args.effort,
        "sandbox": args.sandbox or "profile",
        "cwd": str(cwd),
        "exit_code": exit_code,
        "start_error": start_error,
        "timed_out": timed_out,
        "timeout_seconds": args.timeout_seconds,
        "duration_seconds": round(time.monotonic() - started, 1),
    }
    return write_receipt(out, judge(out, args.model, launch))


def run_exec(argv: list[str], codex: Optional[str], environment: dict[str, str], out: Path,
             timeout_seconds: int) -> tuple[bool, Optional[str], Optional[int]]:
    with (out / EVENTS_FILE).open("wb") as events, (out / CODEX_LOG_FILE).open("wb") as log, \
            (out / PROMPT_FILE).open("rb") as stdin:
        timed_out, start_error, exit_code = False, None, None
        try:
            if codex is None:
                raise FileNotFoundError(0, "codex is not on PATH")
            # The prompt file is stdin, so codex reads to its end instead of waiting on a terminal.
            process = subprocess.Popen(argv, stdin=stdin, stdout=events, stderr=log, env=environment,
                                       start_new_session=True)
        except OSError as error:
            start_error = error.strerror or type(error).__name__
        else:
            try:
                exit_code = process.wait(timeout=timeout_seconds)
            except subprocess.TimeoutExpired:
                timed_out = True
                stop(process)
                exit_code = process.returncode
            except BaseException:
                # The worker runs in its own session, so Ctrl-C would not reach it.
                stop(process)
                raise
    return timed_out, start_error, exit_code


def check(args: argparse.Namespace) -> int:
    out = Path(args.out).expanduser().absolute()
    if not out.is_dir():
        raise UsageError(f"--out {out} is not a directory")
    recorded = read_recorded_receipt(out)
    launch = recorded.get("launch") if recorded else None
    model = args.model or (recorded or {}).get("requested_model") or DEFAULT_MODEL
    recorded_route = (recorded or {}).get("route")
    return write_receipt(out, judge(out, str(model), launch,
                                    recorded_route if isinstance(recorded_route, dict) else None))


LAUNCH_KEYS = ("exit_code", "start_error", "timed_out", "timeout_seconds")


def read_recorded_receipt(out: Path) -> Optional[dict[str, object]]:
    """An earlier receipt's launch facts and model stay part of every later judgement."""
    path = out / RECEIPT_FILE
    if not path.exists():  # A pane unit has no receipt until its first check.
        return None
    try:
        receipt = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise UsageError(f"{path} is not a readable receipt") from error
    launch = receipt.get("launch") if isinstance(receipt, dict) else "invalid"
    if launch is not None and not (isinstance(launch, dict) and all(key in launch for key in LAUNCH_KEYS)):
        raise UsageError(f"{path} has a malformed launch record")
    return receipt


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="monash-worker", description=__doc__,
                                   formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = root.add_subparsers(dest="command", required=True)
    run_command = commands.add_parser("run", help="run one brief as a non-interactive Codex worker")
    run_command.add_argument("--brief", required=True, help="file holding the unit's brief")
    run_command.add_argument("--out", required=True, help="new or empty directory for this unit's results")
    run_command.add_argument("--cwd", required=True, help="absolute working directory for the worker")
    run_command.add_argument("--model", default=DEFAULT_MODEL)
    run_command.add_argument("--effort", default=DEFAULT_EFFORT, help="Codex reasoning effort")
    run_command.add_argument("--sandbox", choices=SANDBOXES,
                             help="default: the profile's workspace-write with network; read-only has no network")
    run_command.add_argument("--timeout-seconds", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    run_command.add_argument("--pane", action="store_true",
                             help="run in a new unfocused Herdr tab Nathan can watch; refuses without Herdr")
    run_command.add_argument("--herdr-session", default=DEFAULT_HERDR_SESSION,
                             help="Herdr session for --pane (default: %(default)s)")
    run_command.set_defaults(handler=run)
    prepare_command = commands.add_parser(
        "prepare", help="write a pane worker's prompt and print the one line to send it")
    prepare_command.add_argument("--brief", required=True)
    prepare_command.add_argument("--out", required=True)
    prepare_command.set_defaults(handler=prepare)
    check_command = commands.add_parser("check", help=f"judge an existing {HANDBACK_FILE}, such as a pane worker's")
    check_command.add_argument("--out", required=True)
    check_command.add_argument("--model", help="default: the receipt's requested model, else " + DEFAULT_MODEL)
    check_command.set_defaults(handler=check)
    return root


def main(argv: Optional[list[str]] = None) -> int:
    args = parser().parse_args(argv)
    try:
        return args.handler(args)
    except KeyboardInterrupt:
        print(json.dumps({"schema_version": SCHEMA_VERSION, "status": "interrupted"}))
        return EXIT["interrupted"]
    except UsageError as error:
        print(json.dumps({"schema_version": SCHEMA_VERSION, "status": "usage", "message": str(error)}))
        return EXIT["usage"]


if __name__ == "__main__":
    sys.exit(main())
