#!/usr/bin/env -S python3 -I -B
"""Add or remove the Monash Foundry provider table in the user's Codex config.

By default this writes only `[model_providers.monash_foundry]` and its `auth`
command table, appended at the end of config.toml inside one marker block, so
a new Codex chat keeps the personal default. A thread that already records
`monash_foundry` (for example one started through `monash-foundry codex`) can
resume in the Codex app through this table.

`apply --new-chat-default` also writes a second marker block at the top of the
file holding only `model_provider = "monash_foundry"`, so new app chats use
Monash until rollback. Existing chats keep the provider they recorded. It
refuses unless the personal top-level model and effort are already the
qualified GPT-6.1 Sol High route; it never writes `model`, effort, profile or
catalogue keys. Rollback removes both blocks.

Every write is verified on the parsed document: apply must yield exactly the
original plus the provider, and rollback exactly the current document minus the
provider, so no other setting can change meaning. Rollback removes only the
marker-delimited lines, keeping every other byte, including edits the Codex
app made meanwhile. auth.json, history and other keys are never written.

The final compare-and-replace is not atomic against another writer. Quit the
Codex app before apply or rollback; concurrent runs of this tool are refused.

Usage:
  monash-codex-desktop [--codex-home DIR] plan|apply [--new-chat-default]
  monash-codex-desktop [--codex-home DIR] status|rollback
"""

from __future__ import annotations

import argparse
import copy
import ctypes
import ctypes.util
import fcntl
import json
import math
import os
import stat
import subprocess
import sys
import tempfile
import types
from pathlib import Path
from typing import Dict, List, Optional, Tuple

try:
    import tomllib
except ModuleNotFoundError:  # Python 3.9 and 3.10
    tomllib = None


SCRIPT_DIR = Path(__file__).resolve().parent
LAUNCHER_PATH = SCRIPT_DIR / "monash-foundry"
CONFIG_PATH = SCRIPT_DIR / "config.json"
HELPER_PATH = SCRIPT_DIR / "monash-codex-token"
PROVIDER_ID = "monash_foundry"
MARKER_TAG = "monash-foundry codex-desktop provider"
BEGIN = f"# >>> {MARKER_TAG} v1: managed by monash-codex-desktop; remove with its rollback >>>"
END = f"# <<< {MARKER_TAG} v1 <<<"
DEFAULT_TAG = "monash-foundry codex-desktop default"
DEFAULT_BEGIN = f"# >>> {DEFAULT_TAG} v1: managed by monash-codex-desktop; remove with its rollback >>>"
DEFAULT_END = f"# <<< {DEFAULT_TAG} v1 <<<"
DEFAULT_BLOCK = f'{DEFAULT_BEGIN}\nmodel_provider = "{PROVIDER_ID}"\n{DEFAULT_END}\n'
# The qualified Monash desktop route. The default block never writes these; it
# requires the personal top-level values to already equal them.
QUALIFIED_MODEL = "gpt-6.1-sol"
QUALIFIED_EFFORT = "high"
AUTH_TIMEOUT_MS = 30000
AUTH_REFRESH_INTERVAL_MS = 300000
PROVIDER_KEYS = frozenset({"name", "base_url", "wire_api", "requires_openai_auth", "auth"})
AUTH_KEYS = frozenset({"command", "args", "timeout_ms", "refresh_interval_ms"})
MAX_CONFIG_BYTES = 16 * 1024 * 1024


class DesktopRefusal(Exception):
    def __init__(self, message: str, repair: str, code: int = 3):
        super().__init__(message)
        self.message = message
        self.repair = repair
        self.code = code


# --- shared trust rules: keep byte-identical in monash-codex-token and monash-codex-desktop ---
class Untrusted(Exception):
    """A path is not admitted: wrong type, owner, mode, link, or enclosing directory."""


def _trusted_entry(info: os.stat_result) -> bool:
    """Owned by this user or root, and writable by no one else (a root sticky directory excepted)."""
    if info.st_uid not in (os.getuid(), 0):
        return False
    if info.st_mode & 0o022 and not (stat.S_ISDIR(info.st_mode) and info.st_mode & stat.S_ISVTX and info.st_uid == 0):
        return False
    return True


def trusted_directory(directory: Path) -> bool:
    """Every component, as written and as resolved, is a trusted entry."""
    if not directory.is_absolute():
        return False
    try:
        written = [os.lstat(component) for component in (directory, *directory.parents)]
        resolved_path = directory.resolve(strict=True)
        resolved = [os.stat(component) for component in (resolved_path, *resolved_path.parents)]
    except OSError:
        return False
    return stat.S_ISDIR(resolved[0].st_mode) and all(_trusted_entry(info) for info in (*written, *resolved))


def admit(path: Path, executable: bool = False) -> int:
    """A read-only no-follow descriptor on a private regular file in trusted directories."""
    if not path.is_absolute() or not trusted_directory(path.parent):
        raise Untrusted(str(path))
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise Untrusted(str(path)) from error
    info = os.fstat(descriptor)
    if (
        not stat.S_ISREG(info.st_mode)
        or info.st_uid != os.getuid()
        or info.st_mode & 0o022
        or (executable and not info.st_mode & stat.S_IXUSR)
    ):
        os.close(descriptor)
        raise Untrusted(str(path))
    return descriptor


def trusted_file(path: Path, executable: bool = False) -> bool:
    try:
        os.close(admit(path, executable))
    except Untrusted:
        return False
    return True


def load_admitted_module(name: str, path: Path):
    """Execute only bytes read through an admitted descriptor, never a path-following import."""
    with os.fdopen(admit(path), "rb") as handle:
        source = handle.read()
    module = types.ModuleType(name)
    module.__file__ = str(path)
    sys.modules[name] = module
    exec(compile(source, str(path), "exec", dont_inherit=True), module.__dict__)
    return module


def load_admitted_config(launcher, path: Path):
    """Parse config.json from an admitted descriptor with the launcher's own parser."""
    descriptor = admit(path)
    try:
        return launcher.load_config(Path(f"/dev/fd/{descriptor}"))
    finally:
        os.close(descriptor)
# --- end shared trust rules ---


def toml_string(value: str) -> str:
    if any(ord(character) < 0x20 or ord(character) == 0x7F for character in value):
        raise DesktopRefusal("a managed value contains control characters", "repair the installed config.json")
    return json.dumps(value, ensure_ascii=False)


def parse_toml(text: str, label: str) -> Dict[str, object]:
    try:
        return tomllib.loads(text)
    except tomllib.TOMLDecodeError as error:
        # The parser's message can name personal tables or keys, so it is never printed.
        raise DesktopRefusal(f"{label} is not valid TOML", "repair the TOML before retrying") from error


def same(left: object, right: object) -> bool:
    """Deep TOML equality where NaN equals NaN and types must match."""
    if isinstance(left, float) and isinstance(right, float) and math.isnan(left) and math.isnan(right):
        return True
    if isinstance(left, dict) and isinstance(right, dict):
        return left.keys() == right.keys() and all(same(left[key], right[key]) for key in left)
    if isinstance(left, list) and isinstance(right, list):
        return len(left) == len(right) and all(same(a, b) for a, b in zip(left, right))
    return type(left) is type(right) and left == right


def managed_block(base_url: str, helper: Path) -> str:
    return "\n".join(
        (
            BEGIN,
            f"[model_providers.{PROVIDER_ID}]",
            'name = "Monash Foundry Azure Responses"',
            f"base_url = {toml_string(base_url)}",
            'wire_api = "responses"',
            "requires_openai_auth = false",
            "",
            f"[model_providers.{PROVIDER_ID}.auth]",
            f"command = {toml_string(str(helper))}",
            "args = []",
            f"timeout_ms = {AUTH_TIMEOUT_MS}",
            f"refresh_interval_ms = {AUTH_REFRESH_INTERVAL_MS}",
            END,
            "",
        )
    )


def expected_provider(base_url: str, helper: Path) -> Dict[str, object]:
    return {
        "name": "Monash Foundry Azure Responses",
        "base_url": base_url,
        "wire_api": "responses",
        "requires_openai_auth": False,
        "auth": {
            "command": str(helper),
            "args": [],
            "timeout_ms": AUTH_TIMEOUT_MS,
            "refresh_interval_ms": AUTH_REFRESH_INTERVAL_MS,
        },
    }


def provider_of(parsed: Dict[str, object]) -> Optional[object]:
    providers = parsed.get("model_providers")
    return providers.get(PROVIDER_ID) if isinstance(providers, dict) else None


def is_document_minus_provider(with_provider: Dict[str, object], without: Dict[str, object]) -> bool:
    """True when `without` is exactly `with_provider` lacking only the managed provider."""
    expected = copy.deepcopy(with_provider)
    providers = expected.get("model_providers")
    if not isinstance(providers, dict) or PROVIDER_ID not in providers:
        return False
    del providers[PROVIDER_ID]
    if same(expected, without):
        return True
    if not providers:  # an empty [model_providers] may or may not have existed before
        del expected["model_providers"]
        return same(expected, without)
    return False


def physical_lines(text: str) -> List[str]:
    """TOML's physical lines, each keeping its LF or CRLF ending.

    str.splitlines also breaks on U+2028, U+2029, U+0085 and other characters
    that TOML keeps inside a comment or string, which would let marker text
    embedded in a longer line pass as a marker line.
    """
    lines = text.split("\n")
    return [line + "\n" for line in lines[:-1]] + ([lines[-1]] if lines[-1] else [])


def marker_span(text: str, begin_marker: str, end_marker: str, tag: str, imitated: "DesktopRefusal"):
    """Line span [begin, end] inclusive of both markers, or None when absent.

    A marker counts only as a whole line; the tag anywhere else (inside a
    string, or a lookalike) is refused. Callers still verify the parsed result.
    """
    lines = physical_lines(text)
    begins = [index for index, line in enumerate(lines) if line.rstrip("\r\n") == begin_marker]
    ends = [index for index, line in enumerate(lines) if line.rstrip("\r\n") == end_marker]
    tagged = [index for index, line in enumerate(lines) if tag in line]
    if not begins and not ends and not tagged:
        return None
    if len(begins) != 1 or len(ends) != 1 or ends[0] <= begins[0] or sorted(begins + ends) != tagged:
        raise imitated
    return begins[0], ends[0]


def locate_block(text: str) -> Optional[Tuple[int, int]]:
    """The provider block's line span, or None when absent."""
    span = marker_span(text, BEGIN, END, MARKER_TAG, IMITATED)
    if span is None:
        return None
    lines = physical_lines(text)
    begin, end = span
    parsed = parse_toml("".join(lines[begin + 1 : end]), "the managed Monash provider block")
    provider = provider_of(parsed)
    auth = provider.get("auth") if isinstance(provider, dict) else None
    if (
        set(parsed) != {"model_providers"}
        or set(parsed["model_providers"]) != {PROVIDER_ID}
        or not isinstance(provider, dict)
        or not set(provider) <= PROVIDER_KEYS
        or not isinstance(auth, dict)
        or not set(auth) <= AUTH_KEYS
    ):
        raise DesktopRefusal(
            "the managed Monash provider block holds settings this tool did not write",
            "move the foreign settings outside the marker lines, then retry",
        )
    return begin, end


IMITATED = DesktopRefusal(
    "the managed Monash provider markers are incomplete, repeated or imitated",
    f"edit config.toml by hand: remove the [model_providers.{PROVIDER_ID}] tables and both marker lines",
)


DEFAULT_IMITATED = DesktopRefusal(
    "the managed Monash new-chat default markers are incomplete, repeated, imitated or hold other settings",
    "edit config.toml by hand: move any setting of yours out from between the default markers and keep it, "
    f'then remove both default marker lines and only a model_provider = "{PROVIDER_ID}" line between them',
)


UNMARKED_DEFAULT = DesktopRefusal(
    f'model_provider = "{PROVIDER_ID}" is set outside this tool\'s markers',
    "remove that line by hand, or keep it and manage the provider by hand; this tool will not build on it",
)


def profiles_selecting_monash(parsed: Dict[str, object]) -> List[str]:
    """Names of Codex profiles whose model_provider is the managed provider."""
    profiles = parsed.get("profiles")
    if not isinstance(profiles, dict):
        return []
    return sorted(name for name, body in profiles.items()
                  if isinstance(body, dict) and body.get("model_provider") == PROVIDER_ID)


def locate_default(text: str) -> Optional[Tuple[int, int]]:
    """The new-chat default block's line span, or None when absent."""
    span = marker_span(text, DEFAULT_BEGIN, DEFAULT_END, DEFAULT_TAG, DEFAULT_IMITATED)
    if span is None:
        return None
    inner = "".join(physical_lines(text)[span[0] + 1 : span[1]])
    if not same(parse_toml(inner, "the managed Monash new-chat default block"), {"model_provider": PROVIDER_ID}):
        raise DEFAULT_IMITATED
    return span


def is_document_minus_default(with_default: Dict[str, object], without: Dict[str, object]) -> bool:
    """True when `without` is exactly `with_default` lacking only the managed top-level default."""
    if with_default.get("model_provider") != PROVIDER_ID:
        return False
    expected = copy.deepcopy(with_default)
    del expected["model_provider"]
    return same(expected, without)


def require_real_default(text: str, parsed: Dict[str, object], span: Tuple[int, int]) -> None:
    """The default markers delimit the document's actual top-level model_provider."""
    if not is_document_minus_default(parsed, parse_toml(remove_block(text, span), "config.toml without the default")):
        raise DEFAULT_IMITATED


def require_qualified_route(parsed: Dict[str, object]) -> None:
    """New chats may default to Monash only when the personal model and effort are the qualified route."""
    if "profile" in parsed:
        raise DesktopRefusal(
            "config.toml sets a top-level profile, which Codex rejects in the base config",
            "remove the profile key, then retry",
        )
    if parsed.get("model") != QUALIFIED_MODEL or parsed.get("model_reasoning_effort") != QUALIFIED_EFFORT:
        raise DesktopRefusal(
            f"the top-level model and model_reasoning_effort are not {QUALIFIED_MODEL} and {QUALIFIED_EFFORT}",
            f"set model = \"{QUALIFIED_MODEL}\" and model_reasoning_effort = \"{QUALIFIED_EFFORT}\" in config.toml, then retry; "
            "this tool will not change them and has no fallback model",
        )


def require_real_block(text: str, parsed: Dict[str, object], span: Tuple[int, int]) -> None:
    """The marker lines delimit the document's actual provider, not text inside a value."""
    if not is_document_minus_provider(parsed, parse_toml(remove_block(text, span), "config.toml without the block")):
        raise IMITATED


def block_text(text: str, span: Tuple[int, int]) -> str:
    return "".join(physical_lines(text)[span[0] : span[1] + 1])


def remove_block(text: str, span: Tuple[int, int]) -> str:
    lines = physical_lines(text)
    return "".join(lines[: span[0]] + lines[span[1] + 1 :])


class DesktopConfig:
    """The Codex home and its config.toml, read and replaced through checked descriptors."""

    def __init__(self, codex_home: Path):
        self.home = codex_home
        self.path = codex_home / "config.toml"
        self.identity: Optional[Tuple[int, int]] = None
        self.lock_fd = -1

    def check_home(self) -> None:
        try:
            info = os.lstat(self.home)
        except FileNotFoundError as error:
            raise DesktopRefusal(f"Codex home {self.home} does not exist", "pass the Codex home with --codex-home") from error
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022:
            raise DesktopRefusal(
                f"Codex home {self.home} is not a real directory owned and writable only by you",
                "repair its ownership and mode, or pass the real directory",
            )
        if not trusted_directory(self.home):
            raise DesktopRefusal(
                f"a directory above {self.home} is writable by another user",
                "repair the ownership or mode of the enclosing directories",
            )

    def lock(self) -> None:
        """Serialize runs of this tool on this Codex home without creating a file."""
        self.lock_fd = os.open(self.home, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as error:
            raise DesktopRefusal("another monash-codex-desktop run holds this Codex home", "wait for it and retry") from error

    def unlock(self) -> None:
        if self.lock_fd >= 0:
            os.close(self.lock_fd)
            self.lock_fd = -1

    def _read_descriptor(self) -> Tuple[bytes, os.stat_result]:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
        try:
            descriptor = os.open(self.path, flags)
        except FileNotFoundError as error:
            raise DesktopRefusal(
                f"Codex config was not found at {self.path}",
                "open the Codex app once so it creates config.toml, or pass --codex-home",
            ) from error
        except OSError as error:
            raise DesktopRefusal(f"{self.path} is a link or unreadable", "replace the link with the real file") from error
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode):
                raise DesktopRefusal(f"{self.path} is not a regular file", "replace it with the real file")
            if info.st_uid != os.getuid() or info.st_mode & 0o022:
                raise DesktopRefusal(
                    f"{self.path} is not owned and writable only by you",
                    f"run chmod go-w {self.path} after checking its contents",
                )
            if info.st_size > MAX_CONFIG_BYTES:
                raise DesktopRefusal(f"{self.path} is unexpectedly large", "inspect the file")
            chunks = []
            while True:
                chunk = os.read(descriptor, 1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
            return b"".join(chunks), info
        finally:
            os.close(descriptor)

    def read(self) -> Tuple[bytes, str, int]:
        self.check_home()
        raw, info = self._read_descriptor()
        self.identity = (info.st_dev, info.st_ino)
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as error:
            raise DesktopRefusal(f"{self.path} is not UTF-8", "repair the file encoding") from error
        return raw, text, stat.S_IMODE(info.st_mode)

    def replace(self, expected: bytes, new_text: str, mode: int) -> None:
        """Recheck quiescence and identity immediately before replace.

        Writers are excluded by require_no_codex_writer; a Codex process that
        starts in the instant after that check is not detected.
        """
        payload = new_text.encode("utf-8")
        descriptor, name = tempfile.mkstemp(dir=str(self.home), prefix=".config.toml.monash-")
        temporary = Path(name)
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(payload)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, mode)
            require_no_codex_writer(self.home)
            current, info = self._read_descriptor()
            if current != expected or (info.st_dev, info.st_ino) != self.identity:
                raise DesktopRefusal(
                    f"{self.path} changed while this change was prepared",
                    "quit the Codex app and every Codex session, then retry",
                )
            os.replace(temporary, self.path)
        finally:
            temporary.unlink(missing_ok=True)


def _process_environment(libc, argmax: int, pid: int) -> Optional[Dict[str, str]]:
    """A same-user process's environment from KERN_PROCARGS2, or None when unreadable."""
    mib = (ctypes.c_int * 3)(1, 49, pid)  # CTL_KERN, KERN_PROCARGS2
    size = ctypes.c_size_t(argmax)
    buffer = ctypes.create_string_buffer(argmax)
    if libc.sysctl(mib, 3, buffer, ctypes.byref(size), None, 0) != 0 or size.value < 4:
        return None
    data = buffer.raw[: size.value]
    argc = int.from_bytes(data[:4], sys.byteorder)
    parts = data[4:].split(b"\0")
    index = 1  # skip the executable path, then its NUL padding
    while index < len(parts) and parts[index] == b"":
        index += 1
    index += argc
    environment: Dict[str, str] = {}
    while index < len(parts) and parts[index]:
        name, _, value = parts[index].partition(b"=")
        environment[name.decode("utf-8", "replace")] = value.decode("utf-8", "replace")
        index += 1
    return environment


def codex_writers(home: Path) -> List[Tuple[int, str]]:
    """Running Codex or ChatGPT-engine processes of this user whose Codex home is `home`.

    A process without CODEX_HOME uses its HOME's .codex. A process whose
    environment cannot be read blocks every home. Matching is deliberately
    broad: a false match refuses.
    """
    target = os.path.realpath(home)
    listing = subprocess.run(
        ["/bin/ps", "-x", "-U", str(os.getuid()), "-o", "pid=,comm="],
        capture_output=True, text=True, timeout=15, check=False,
    )
    if listing.returncode != 0:
        raise DesktopRefusal("running Codex processes could not be listed", "retry; the check needs /bin/ps")
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    argmax = ctypes.c_int(0)
    argmax_size = ctypes.c_size_t(ctypes.sizeof(argmax))
    mib = (ctypes.c_int * 2)(1, 8)  # CTL_KERN, KERN_ARGMAX
    if libc.sysctl(mib, 2, ctypes.byref(argmax), ctypes.byref(argmax_size), None, 0) != 0:
        raise DesktopRefusal("process environments could not be inspected", "retry on macOS")
    writers: List[Tuple[int, str]] = []
    for line in listing.stdout.splitlines():
        pid_text, _, executable = line.strip().partition(" ")
        executable = executable.strip()
        if not pid_text.isdigit() or int(pid_text) == os.getpid():
            continue
        lowered = executable.lower()
        if "codex" not in lowered and "/chatgpt.app/" not in lowered:
            continue
        environment = _process_environment(libc, argmax.value, int(pid_text))
        if environment is None:  # its home is unknown, so it may be this one
            writers.append((int(pid_text), os.path.basename(executable)))
            continue
        process_home = environment.get("CODEX_HOME") or os.path.join(
            environment.get("HOME") or str(Path.home()), ".codex"
        )
        if os.path.realpath(process_home) == target:
            writers.append((int(pid_text), os.path.basename(executable)))
    return writers


def require_no_codex_writer(home: Path) -> None:
    writers = codex_writers(home)
    if writers:
        shown = ", ".join(f"{name} (pid {pid})" for pid, name in writers[:6])
        raise DesktopRefusal(
            f"Codex is running on {home} and may rewrite config.toml: {shown}",
            "quit the Codex app and every Codex session that uses this home, then retry",
        )


def require_helper() -> Path:
    if not trusted_file(HELPER_PATH, executable=True):
        raise DesktopRefusal(
            f"the token helper at {HELPER_PATH} is missing or not a private executable in trusted directories",
            "install the Foundry snapshot with scripts/foundry/install.py",
        )
    return HELPER_PATH


def desired_block() -> Tuple[str, Dict[str, object]]:
    try:
        launcher = load_admitted_module("monash_foundry_launcher", LAUNCHER_PATH)
        config = load_admitted_config(launcher, CONFIG_PATH)
    except Untrusted as error:
        raise DesktopRefusal(
            "the installed launcher or config.json is not a private file in trusted directories",
            "reinstall the Foundry snapshot with scripts/foundry/install.py",
        ) from error
    except Exception as error:
        message = getattr(error, "message", type(error).__name__)
        raise DesktopRefusal(
            f"the installed Foundry config could not be used ({message})",
            "reinstall the Foundry snapshot with scripts/foundry/install.py",
        ) from error
    helper = require_helper()
    base_url = config.codex.base_url
    return managed_block(base_url, helper), expected_provider(base_url, helper)


def prepare_apply(desktop: DesktopConfig, new_chat_default: bool = False) -> Tuple[bytes, str, int, Optional[str]]:
    """The read bytes, mode and new text; new text None when already applied."""
    raw, text, mode = desktop.read()
    parsed = parse_toml(text, str(desktop.path))
    default_span = locate_default(text)
    if default_span is not None:  # checked on every apply, so imitated markers are never built on
        require_real_default(text, parsed, default_span)
        # A managed default stays admitted only on the qualified route, also on an idempotent apply.
        require_qualified_route(parsed)
    elif parsed.get("model_provider") == PROVIDER_ID:
        raise UNMARKED_DEFAULT
    with_provider = compose_provider(text, parsed)
    if not new_chat_default:
        return raw, text, mode, None if with_provider == text else with_provider
    with_default = compose_default(with_provider, parse_toml(with_provider, "the composed config.toml"))
    return raw, text, mode, None if with_default == text else with_default


def compose_default(text: str, parsed: Dict[str, object]) -> str:
    """`text` with the managed new-chat default block at its top, verified on the parsed result."""
    span = locate_default(text)
    if span is not None:
        require_real_default(text, parsed, span)
        return text
    if "model_provider" in parsed:
        raise DesktopRefusal(
            "config.toml already sets a top-level model_provider",
            "this tool will not replace another default provider; remove it by hand first if that is intended",
        )
    require_qualified_route(parsed)
    new_text = DEFAULT_BLOCK + text
    new_parsed = parse_toml(new_text, "the composed config.toml")
    new_span = locate_default(new_text)
    if new_span != (0, 2) or not is_document_minus_default(new_parsed, parsed) or remove_block(new_text, new_span) != text:
        raise DesktopRefusal(
            "the composed config.toml did not verify as the original plus the managed new-chat default",
            "report this defect; config.toml was not changed",
        )
    return new_text


def compose_provider(text: str, parsed: Dict[str, object]) -> str:
    """`text` with the managed provider block appended, verified on the parsed result."""
    block, provider = desired_block()
    span = locate_block(text)
    if span is not None:
        require_real_block(text, parsed, span)
        if block_text(text, span) == block and same(provider_of(parsed), provider):
            return text
        raise DesktopRefusal("a different managed Monash provider block is already present", "run rollback first, then apply")
    if provider_of(parsed) is not None:
        raise DesktopRefusal(
            f"config.toml already defines model_providers.{PROVIDER_ID} outside this tool's markers",
            "remove that provider by hand or keep it; this tool will not overwrite it",
        )
    if text and not text.endswith("\n"):
        raise DesktopRefusal("config.toml does not end with a newline", "add a final newline, then retry")
    new_text = text + block
    new_parsed = parse_toml(new_text, "the composed config.toml")
    new_span = locate_block(new_text)
    if (
        new_span is None
        or not same(provider_of(new_parsed), provider)
        or not is_document_minus_provider(new_parsed, parsed)
        or remove_block(new_text, new_span) != text
    ):
        raise DesktopRefusal(
            "the composed config.toml did not verify as the original plus the managed provider",
            "report this defect; config.toml was not changed",
        )
    return new_text


def prepare_rollback(desktop: DesktopConfig) -> Tuple[bytes, int, Optional[str]]:
    raw, text, mode = desktop.read()
    parsed = parse_toml(text, str(desktop.path))
    without_default = remove_default(text, parsed)
    without_both = remove_provider(without_default, parse_toml(without_default, "config.toml without the default"))
    return raw, mode, None if without_both == text else without_both


def remove_default(text: str, parsed: Dict[str, object]) -> str:
    """`text` without the managed new-chat default block, verified to drop only that key."""
    span = locate_default(text)
    if span is None:
        return text
    require_real_default(text, parsed, span)
    new_text = remove_block(text, span)
    if not is_document_minus_default(parsed, parse_toml(new_text, "config.toml after removing the default")):
        raise DesktopRefusal(
            "removing the managed new-chat default would change settings other than model_provider",
            "edit config.toml by hand: keep every other setting and remove only the managed default lines",
        )
    return new_text


def remove_provider(text: str, parsed: Dict[str, object]) -> str:
    """`text` without the managed provider block, verified to drop only that provider."""
    if parsed.get("model_provider") == PROVIDER_ID:
        raise DesktopRefusal(
            f"model_provider = \"{PROVIDER_ID}\" is set outside this tool's markers",
            "remove that line by hand first, or new chats would name a provider that no longer exists",
        )
    if profiles_selecting_monash(parsed):
        # Profile names are personal, so only their count is shown.
        raise DesktopRefusal(
            f"{len(profiles_selecting_monash(parsed))} Codex profile(s) select model_provider \"{PROVIDER_ID}\"",
            "change or remove those profiles by hand first; this tool will not edit them, "
            "and removing the provider would leave them naming one that no longer exists",
        )
    span = locate_block(text)
    if span is None:
        if provider_of(parsed) is not None:
            raise DesktopRefusal(
                f"model_providers.{PROVIDER_ID} is present without this tool's markers",
                f"remove the [model_providers.{PROVIDER_ID}] tables by hand if they are no longer wanted",
            )
        return text
    new_text = remove_block(text, span)
    new_parsed = parse_toml(new_text, "config.toml after removing the managed block")
    if provider_of(parsed) is None:
        raise IMITATED
    if not is_document_minus_provider(parsed, new_parsed):
        raise DesktopRefusal(
            "removing the managed block would change settings other than the Monash provider",
            f"edit config.toml by hand: keep every other setting and remove only [model_providers.{PROVIDER_ID}]",
        )
    return new_text


def default_provider_state(parsed: Dict[str, object]) -> str:
    value = parsed.get("model_provider")
    if value is None:
        return "unset"
    return PROVIDER_ID if value == PROVIDER_ID else "another provider"


def print_insertions(path: Path, text: str, insertions: List[Tuple[str, str]]) -> None:
    """Show only the managed lines being added; the personal document is never diffed or echoed."""
    print(f"--- {path}")
    print(f"+++ {path}")
    for where, block in insertions:
        print(f"@@ {where} @@")
        for line in block.splitlines():
            print(f"+{line}")


def planned_insertions(text: str, new_chat_default: bool) -> List[Tuple[str, str]]:
    """The managed blocks an apply would add to `text`, in file order."""
    insertions: List[Tuple[str, str]] = []
    if new_chat_default and locate_default(text) is None:
        insertions.append(("insert at the top of the file", DEFAULT_BLOCK))
    if locate_block(text) is None:
        insertions.append(("append at the end of the file", desired_block()[0]))
    return insertions


def default_effect(new_chat_default: bool) -> str:
    if new_chat_default:
        return (f"default provider for new chats: {PROVIDER_ID} until rollback; "
                "existing chats keep the provider they recorded")
    return "default provider: unchanged"


def command_plan(desktop: DesktopConfig, new_chat_default: bool = False) -> int:
    _, text, _, new_text = prepare_apply(desktop, new_chat_default)
    if new_text is None:
        print(f"plan: already applied; no change to {desktop.path}")
        return 0
    print(f"plan: add the managed Monash block(s) to {desktop.path}")
    print_insertions(desktop.path, text, planned_insertions(text, new_chat_default))
    print(default_effect(new_chat_default))
    return 0


def command_apply(desktop: DesktopConfig, new_chat_default: bool = False) -> int:
    require_no_codex_writer(desktop.home)
    raw, _, mode, new_text = prepare_apply(desktop, new_chat_default)
    if new_text is None:
        print(f"apply: already applied; no change to {desktop.path}")
        return 0
    desktop.replace(raw, new_text, mode)
    print(f"apply: added the managed Monash block(s) to {desktop.path}")
    print(default_effect(new_chat_default))
    print(f"rollback: {SCRIPT_DIR / 'monash-codex-desktop'} --codex-home {desktop.home} rollback")
    return 0


def command_rollback(desktop: DesktopConfig, new_chat_default: bool = False) -> int:
    require_no_codex_writer(desktop.home)
    raw, mode, new_text = prepare_rollback(desktop)
    if new_text is None:
        print(f"rollback: no managed Monash block in {desktop.path}; nothing changed")
        return 0
    desktop.replace(raw, new_text, mode)
    print(f"rollback: removed the managed Monash block(s) from {desktop.path}")
    return 0


def provider_state(text: str, parsed: Dict[str, object]) -> str:
    span = locate_block(text)
    if span is None:
        return "unmanaged-provider" if provider_of(parsed) is not None else "absent"
    try:
        require_real_block(text, parsed, span)
        block, provider = desired_block()
        return "applied" if block_text(text, span) == block and same(provider_of(parsed), provider) else "applied-differs"
    except DesktopRefusal as refusal:
        return f"applied-unverifiable ({refusal.message})"


def new_chat_default_state(text: str, parsed: Dict[str, object]) -> str:
    try:
        span = locate_default(text)
        if span is None:
            return "unmanaged" if parsed.get("model_provider") == PROVIDER_ID else "absent"
        require_real_default(text, parsed, span)
    except DesktopRefusal:
        return "applied-unverifiable"
    try:
        require_qualified_route(parsed)
    except DesktopRefusal:
        return "applied-route-changed"
    return "applied"


def command_status(desktop: DesktopConfig, new_chat_default: bool = False) -> int:
    _, text, _ = desktop.read()
    parsed = parse_toml(text, str(desktop.path))
    state = provider_state(text, parsed)
    default = new_chat_default_state(text, parsed)
    print(f"config={desktop.path} state={state} new_chat_default={default} "
          f"default_provider={default_provider_state(parsed)}")
    consistent = state == "applied" if default == "applied" else (state in ("absent", "applied") and default == "absent")
    return 0 if consistent else 3


COMMANDS = {
    "plan": command_plan,
    "apply": command_apply,
    "status": command_status,
    "rollback": command_rollback,
}


def run(command: str, home: Path, new_chat_default: bool = False) -> int:
    if tomllib is None:
        raise DesktopRefusal("this tool needs Python 3.11 or newer for tomllib", f"run it with python3.11 {__file__}")
    if not home.is_absolute():
        raise DesktopRefusal("--codex-home must be an absolute path", "pass an absolute Codex home")
    desktop = DesktopConfig(home)
    desktop.check_home()
    desktop.lock()
    try:
        return COMMANDS[command](desktop, new_chat_default)
    finally:
        desktop.unlock()


def main(argv: List[str]) -> int:
    parser = argparse.ArgumentParser(prog="monash-codex-desktop", description=__doc__.split("\n\n")[0])
    parser.add_argument("--codex-home", type=Path, default=Path.home() / ".codex")
    parser.add_argument("command", choices=sorted(COMMANDS))
    parser.add_argument("--new-chat-default", action="store_true",
                        help="plan or apply only: also make new app chats use the Monash provider until rollback")
    args = parser.parse_args(argv)
    if args.new_chat_default and args.command not in ("plan", "apply"):
        parser.error("--new-chat-default applies only to plan and apply")
    try:
        return run(args.command, args.codex_home.expanduser(), args.new_chat_default)
    except Exception as error:  # every failure is a bounded refusal, never a traceback
        refusal = error if isinstance(error, DesktopRefusal) else DesktopRefusal(
            f"unexpected failure ({type(error).__name__})", "report this defect; run status before retrying"
        )
        print(f"error: {refusal.message}", file=sys.stderr)
        print(f"repair: {refusal.repair}", file=sys.stderr)
        return refusal.code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
