class LauncherError(Exception):
    """An expected launcher failure with a safe repair action."""

    def __init__(self, message: str, repair: Optional[str] = None, code: int = 3):
        super().__init__(message)
        self.message = message
        self.repair = repair
        self.code = code


class UsageError(LauncherError):
    def __init__(self, message: str):
        super().__init__(message, code=2)


class ConfigError(LauncherError):
    def __init__(self, message: str, repair: Optional[str] = None):
        super().__init__(message, repair=repair, code=2)


