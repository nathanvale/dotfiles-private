{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.invalid/agent-instructions/runtime-response-v1.schema.json",
	"title": "Agent Instructions Evaluation Runtime Response V1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"scenario_id",
		"runtime",
		"selected_primary_owner",
		"selected_owner_paths",
		"instruction_sources",
		"first_proof_id",
		"action",
		"mutation_attempted",
		"handoff",
		"limitations",
		"answer_summary"
	],
	"properties": {
		"schema_version": { "type": "integer", "const": 1 },
		"scenario_id": {
			"type": "string",
			"pattern": "^[a-z][0-9]{2}-[a-z0-9-]+$"
		},
		"runtime": { "type": "string", "enum": ["codex", "claude"] },
		"selected_primary_owner": { "type": "string", "minLength": 1 },
		"selected_owner_paths": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"instruction_sources": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"first_proof_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
		"action": {
			"type": "string",
			"enum": ["analyze_only", "stop", "proceed_read_only"]
		},
		"mutation_attempted": { "type": "boolean" },
		"handoff": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"objective",
				"state",
				"evidence",
				"risk",
				"owner",
				"next_action"
			],
			"properties": {
				"objective": { "type": ["string", "null"] },
				"state": { "type": ["string", "null"] },
				"evidence": { "type": ["string", "null"] },
				"risk": { "type": ["string", "null"] },
				"owner": { "type": ["string", "null"] },
				"next_action": { "type": ["string", "null"] }
			}
		},
		"limitations": {
			"type": "array",
			"items": { "type": "string", "minLength": 1 }
		},
		"answer_summary": { "type": "string", "minLength": 1 }
	}
}
