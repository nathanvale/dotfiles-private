{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://example.invalid/agent-instructions/scenario-set-v1.schema.json",
	"title": "Agent Instructions Evaluation Scenario Set V1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schema_version",
		"rubric_version",
		"set_id",
		"window",
		"frozen_at",
		"startup_profiles",
		"scenarios"
	],
	"properties": {
		"schema_version": { "const": 1 },
		"rubric_version": { "const": 1 },
		"set_id": { "type": "string", "pattern": "^[a-z0-9-]+-v[0-9]+$" },
		"window": { "enum": ["baseline", "held_out"] },
		"frozen_at": { "type": "string", "format": "date" },
		"startup_profiles": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": {
				"type": "object",
				"additionalProperties": false,
				"required": ["codex", "claude"],
				"properties": {
					"codex": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
					"claude": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
				}
			}
		},
		"scenarios": {
			"type": "array",
			"minItems": 10,
			"maxItems": 10,
			"items": { "$ref": "#/$defs/scenario" }
		}
	},
	"$defs": {
		"nonEmptyUniqueStrings": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1 }
		},
		"scenario": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"category",
				"working_directory",
				"startup_profile",
				"prompt",
				"high_consequence",
				"expected"
			],
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z][0-9]{2}-[a-z0-9-]+$" },
				"title": { "type": "string", "minLength": 1 },
				"category": {
					"enum": [
						"approval_boundary",
						"dotfiles_package",
						"nested_precedence",
						"accessible_email",
						"instruction_maintenance",
						"focused_test",
						"broad_suite",
						"delegated_handoff",
						"stale_pointer",
						"contradiction"
					]
				},
				"working_directory": { "type": "string", "pattern": "^\\$HOME/" },
				"startup_profile": { "type": "string", "minLength": 1 },
				"prompt": { "type": "string", "minLength": 20 },
				"high_consequence": { "type": "boolean" },
				"expected": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"primary_owner",
						"required_owners",
						"allowed_read_sources",
						"first_proof_id",
						"action",
						"handoff_required"
					],
					"properties": {
						"primary_owner": { "type": "string", "minLength": 1 },
						"required_owners": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
						"allowed_read_sources": {
							"type": "array",
							"uniqueItems": true,
							"items": { "type": "string", "minLength": 1 }
						},
						"first_proof_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
						"action": { "enum": ["analyze_only", "stop", "proceed_read_only"] },
						"handoff_required": { "type": "boolean" }
					}
				}
			}
		}
	}
}
