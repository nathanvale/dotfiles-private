			"title": "Package cleanup is previewed before removal",
			"category": "dotfiles_package",
			"working_directory": "$HOME/code/dotfiles",
			"startup_profile": "dotfiles-root",
			"prompt": "Plan removal of an obsolete personal package. Do not modify package state. Identify the source owner and the required preview before any cleanup runs.",
			"high_consequence": true,
			"expected": {
				"primary_owner": "repo://dotfiles/AGENTS.md#package-state",
				"required_owners": [
					"repo://dotfiles/AGENTS.md#package-state",
