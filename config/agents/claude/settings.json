{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "AskUserQuestion"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5-1",
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [],
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "apple-reminders": "off",
    "bitbucket": "off",
    "context-unhobble-audit": "off",
    "dataviz": "off",
    "figma": "off",
    "git-guardrails-claude-code": "off",
    "gog": "off",
    "gog-admin": "off",
    "gog-analytics": "off",
    "gog-appscript": "off",
    "gog-calendar": "off",
    "gog-chat": "off",
    "gog-classroom": "off",
    "gog-contacts": "off",
    "gog-contacts-cleanup": "off",
    "gog-docs": "off",
    "gog-drive": "off",
    "gog-drive-audit": "off",
    "gog-forms": "off",
    "gog-gmail": "off",
    "gog-groups": "off",
    "gog-inbox-triage": "off",
    "gog-keep": "off",
    "gog-maps": "off",
    "gog-meet": "off",
    "gog-meeting-prep": "off",
    "gog-people": "off",
    "gog-photos": "off",
    "gog-save-attachments": "off",
    "gog-searchconsole": "off",
    "gog-sheets": "off",
    "gog-sites": "off",
    "gog-slides": "off",
    "gog-tasks": "off",
    "gog-weekly-digest": "off",
    "gog-youtube": "off",
    "implement": "on",
    "migrate-to-shoehorn": "off",
    "resolving-merge-conflicts": "off",
    "retro-scrum-master": "off",
    "scaffold-exercises": "off",
    "session-recovery": "off",
    "setup-pre-commit": "off",
    "setup-ts-deep-modules": "off",
    "stream-deck-author": "off",
    "stream-deck-use": "off",
    "tdd": "on",
    "to-questionnaire": "off",
    "to-tickets": "on",
    "update-config": "off",
    "vocab-refresh": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-shape": "off"
  },
  "disableBundledSkills": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "date '+Current datetime: %A, %d %B %Y %I:%M %p %Z'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*biome-runner__(biome_lintCheck|biome_lintFix|biome_formatCheck)",
        "hooks": [
          {
            "type": "command",
            "command": "SQ_HOOK_DEDUP_ENABLED=1 bunx @side-quest/claude-hooks posttool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*biome-runner__(biome_lintCheck|biome_lintFix|biome_formatCheck)",
        "hooks": [
          {
            "type": "command",
            "command": "SQ_HOOK_DEDUP_ENABLED=1 bunx @side-quest/claude-hooks posttool-failure",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/worktree/worktree-create.ts\"",
            "timeout": 60
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$HOME/.claude/hooks/worktree/worktree-remove.ts\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "disableRemoteControl": true,
  "disableWorkflows": false,
  "statusLine": {
    "type": "command",
    "command": "bash /Users/nathanvale/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "proof@personal": true,
    "my-second-brain-playground@personal": true,
    "personal@personal": true,
    "connectors@personal": true
  },
  "extraKnownMarketplaces": {
    "my-second-brain": {
      "source": {
        "source": "github",
        "repo": "myagentdojo/my-second-brain-plugin",
        "ref": "v0.4.0"
      }
    },
    "personal": {
      "source": {
        "source": "directory",
        "path": "/Users/nathanvale/code/dotfiles/config/agents/plugins"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public (gh check not queryable here — remote uses a custom SSH host alias `github-myagentdojo`, org/repo not derivable)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: main (default branch, per repo facts); protection status not queryable here",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo (my-second-brain-playground, remote `github-myagentdojo:myagentdojo/my-second-brain-playground.git`) and its remote only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — includes `inbox/agent-browser-credential-provider-evaluation.md` and `projects/my-second-brain/research/event-ledger-retention-and-deletion.md`",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: personal knowledge-vault / second-brain project work (routine under this repo)",
      "**Trusted repo**: `~/code/my-second-brain-playground` (remote `github-myagentdojo:myagentdojo/my-second-brain-playground.git`); visibility not confirmed, treat as private by default",
      "**Org-specific CLIs**: None configured (herdr, ghh, vault-steward, mise, mcporter, bd seen frequently in this project's transcripts but not corroborated as org-specific tooling)",
      "routine under `~/code/my-second-brain-playground/` prefix"
    ]
  }
}
