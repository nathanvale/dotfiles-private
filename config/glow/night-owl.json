{
	"document": {
		"block_prefix": "\n",
		"block_suffix": "\n",
		"color": "#D6DEEB",
		"margin": 2
	},
	"block_quote": {
		"indent": 1,
		"indent_token": "| "
	},
	"paragraph": {},
	"list": {
		"level_indent": 2
	},
	"heading": {
		"block_suffix": "\n",
		"color": "#82AAFF",
		"bold": true
	},
	"h1": {
		"prefix": " ",
		"suffix": " ",
		"color": "#D6DEEB",
		"background_color": "#7E57C2",
		"bold": true
	},
	"h2": {
		"prefix": "",
		"color": "#82AAFF",
		"bold": true
	},
	"h3": {
		"prefix": "",
		"color": "#C792EA",
		"bold": true
	},
	"h4": {
		"prefix": "",
		"color": "#D6DEEB",
		"bold": true
	},
	"h5": {
		"prefix": "",
		"color": "#D6DEEB"
	},
	"h6": {
		"prefix": "",
		"color": "#5F7E97"
	},
	"text": {},
	"strikethrough": {
		"crossed_out": true
	},
	"emph": {
		"italic": true
	},
	"strong": {
		"bold": true
	},
	"hr": {
		"color": "#5F7E97",
		"format": "\n--------\n"
	},
	"item": {
		"block_prefix": "- "
	},
	"enumeration": {
		"block_prefix": ". "
	},
	"task": {
		"ticked": "[x] ",
		"unticked": "[ ] "
	},
	"link": {
		"color": "#21C7A8",
		"underline": true
	},
	"link_text": {
		"color": "#82AAFF",
		"bold": true
	},
	"image": {
		"color": "#C792EA",
		"underline": true
	},
	"image_text": {
		"color": "#5F7E97",
		"format": "Image: {{.text}} ->"
	},
	"code": {
		"prefix": " ",
		"suffix": " ",
		"color": "#D6DEEB",
		"background_color": "#0B253A"
	},
	"code_block": {
		"color": "244",
		"margin": 2,
		"chroma": {
			"text": {
				"color": "#D6DEEB"
			},
			"error": {
				"color": "#D6DEEB",
				"background_color": "#31222F"
			},
			"comment": {
				"color": "#5F7E97"
			},
			"comment_preproc": {
				"color": "#F78C6C"
			},
			"keyword": {
				"color": "#C792EA"
			},
			"keyword_reserved": {
				"color": "#C792EA"
			},
			"keyword_namespace": {
				"color": "#C792EA"
			},
			"keyword_type": {
				"color": "#FFCB8B"
			},
			"operator": {
				"color": "#C792EA"
			},
			"punctuation": {
				"color": "#D6DEEB"
			},
			"name": {
				"color": "#D6DEEB"
			},
			"name_builtin": {
				"color": "#82AAFF"
			},
			"name_tag": {
				"color": "#7FDBCA"
			},
			"name_attribute": {
				"color": "#C5E478"
			},
			"name_class": {
				"color": "#FFCB8B",
				"underline": true,
				"bold": true
			},
			"name_constant": {},
			"name_decorator": {
				"color": "#C792EA"
			},
			"name_exception": {},
			"name_function": {
				"color": "#82AAFF"
			},
			"name_other": {},
			"literal": {},
			"literal_number": {
				"color": "#F78C6C"
			},
			"literal_date": {},
			"literal_string": {
				"color": "#ECC48D"
			},
			"literal_string_escape": {
				"color": "#C5E478"
			},
			"generic_deleted": {
				"color": "#EF5350"
			},
			"generic_emph": {
				"italic": true
			},
			"generic_inserted": {
				"color": "#9CCC65"
			},
			"generic_strong": {
				"bold": true
			},
			"generic_subheading": {
				"color": "#5F7E97"
			},
			"background": {
				"background_color": "#011627"
			}
		}
	},
	"table": {},
	"definition_list": {},
	"definition_term": {},
	"definition_description": {
		"block_prefix": "\n> "
	},
	"html_block": {},
	"html_span": {}
}
