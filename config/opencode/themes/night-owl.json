{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "surface": "#011627",
    "surfaceElevated": "#0B253A",
    "foreground": "#D6DEEB",
    "foregroundMuted": "#5F7E97",
    "accent": "#7E57C2",
    "blue": "#82AAFF",
    "purple": "#C792EA",
    "cyan": "#21C7A8",
    "green": "#22DA6E",
    "yellow": "#C5E478",
    "red": "#EF5350",
    "addedMarker": "#9CCC65",
    "addedBackground": "#162C31",
    "removedBackground": "#31222F"
  },
  "theme": {
    "primary": { "dark": "blue", "light": "blue" },
    "secondary": { "dark": "cyan", "light": "cyan" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "foreground", "light": "foreground" },
    "textMuted": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "background": { "dark": "surface", "light": "surface" },
    "backgroundPanel": { "dark": "surfaceElevated", "light": "surfaceElevated" },
    "backgroundElement": { "dark": "surfaceElevated", "light": "surfaceElevated" },
    "border": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "borderActive": { "dark": "blue", "light": "blue" },
    "borderSubtle": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "diffAdded": { "dark": "addedMarker", "light": "addedMarker" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "diffHunkHeader": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "diffHighlightAdded": { "dark": "addedMarker", "light": "addedMarker" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "addedBackground", "light": "addedBackground" },
    "diffRemovedBg": { "dark": "removedBackground", "light": "removedBackground" },
    "diffContextBg": { "dark": "surfaceElevated", "light": "surfaceElevated" },
    "diffLineNumber": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "diffAddedLineNumberBg": { "dark": "addedBackground", "light": "addedBackground" },
    "diffRemovedLineNumberBg": { "dark": "removedBackground", "light": "removedBackground" },
    "markdownText": { "dark": "foreground", "light": "foreground" },
    "markdownHeading": { "dark": "blue", "light": "blue" },
    "markdownLink": { "dark": "cyan", "light": "cyan" },
    "markdownLinkText": { "dark": "blue", "light": "blue" },
    "markdownCode": { "dark": "green", "light": "green" },
    "markdownBlockQuote": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "markdownEmph": { "dark": "purple", "light": "purple" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "cyan", "light": "cyan" },
    "markdownImage": { "dark": "cyan", "light": "cyan" },
    "markdownImageText": { "dark": "blue", "light": "blue" },
    "markdownCodeBlock": { "dark": "foreground", "light": "foreground" },
    "syntaxComment": { "dark": "foregroundMuted", "light": "foregroundMuted" },
    "syntaxKeyword": { "dark": "purple", "light": "purple" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "foreground", "light": "foreground" },
    "syntaxString": { "dark": "yellow", "light": "yellow" },
    "syntaxNumber": { "dark": "accent", "light": "accent" },
    "syntaxType": { "dark": "green", "light": "green" },
    "syntaxOperator": { "dark": "cyan", "light": "cyan" },
    "syntaxPunctuation": { "dark": "foreground", "light": "foreground" }
  }
}
