# .env.example
#
# Scoped exception: private token source for bin/with-one-password-token.
# Copy to .env and fill in the value. Never source .env from shell startup.

# 1Password Service Account Token (required by bin/with-one-password-token)
# Get from: https://my.1password.com → Developer → Service Accounts
export OP_SERVICE_ACCOUNT_TOKEN=""
