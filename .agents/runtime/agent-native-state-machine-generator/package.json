{
	"name": "@side-quest/agent-native-state-machine-generator",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Package shell for the product-specific agent-native state-machine compiler and scaffolder.",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"prototype:build": "bun build ./prototypes/vault-git-reimagined/index.html --target browser --outdir ./prototypes/vault-git-reimagined/dist",
		"prototype:dev": "bun --hot ./prototypes/vault-git-reimagined/dev.ts",
		"lint": "biome check --diagnostic-level=error .",
		"test": "bun test ./tests ./pilot",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@side-quest/cli-command-facade": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"typescript": "catalog:"
	}
}
