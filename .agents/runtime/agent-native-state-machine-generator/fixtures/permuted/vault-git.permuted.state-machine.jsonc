      },
      {
        "condition": "transaction_owner_capability_available",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "restore_transaction_capability",
      },
      {
        "condition": "repair_promotion_reconciliation_required",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "reconcile_repair_promotion",
      },
      {
        "condition": "remote_evidence_available",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "obtain_remote_evidence",
      },
      {
        "condition": "publication_conflict_resolved",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "resolve_publication_conflict",
      },
      {
        "condition": "remote_contract_restored",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "restore_remote_contract",
      },
      {
        "condition": "owner_capability_supplied",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "use_owner_capability",
      },
      {
        "condition": "join_capability_supplied",
        "owner": "join_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "use_join_capability",
      },
      {
        "condition": "transaction_capability_reloaded",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "reload_capability",
      },
      {
        "condition": "activation_identity_configured",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "configure_activation_identity",
      },
      {
        "condition": "operator_reviewed_evidence",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "request_operator_review",
      },
      {
        "condition": "private_receipt_inspected",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "inspect_private_receipt",
      },
      {
        "condition": "local_edits_preserved",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "preserve_local_edits",
      },
      {
        "condition": "local_edits_preserved",
        "owner": "transaction_owner",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "capture_private_draft",
      },
      {
        "condition": "runtime_owner_available",
        "owner": "private_launcher",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "wait_for_runtime",
      },
      {
        "condition": "owner_pause_released",
        "owner": "vault_git_operator",
        "human_kind": "external_prerequisite",
        "kind": "needs_human",
        "id": "request_owner_pause_release",
      },
      {
        "stop_scope": "agent_terminal",
        "kind": "none",
        "id": "continue_outer_transaction",
      },
      {
        "stop_scope": "domain_terminal",
        "kind": "none",
        "id": "none",
      },
    ],
    "external_owners": [
      "vault_git_operator",
      "repository_ssh_owner",
      "vault_git_performance_owner",
      "transaction_owner",
      "join_owner",
      "private_launcher",
    ],
    "needs_human_kinds": ["command", "external_prerequisite"],
    "kinds": ["invoke", "needs_input", "needs_human", "none"],
  },
  "activation": {
    "cause_to_next_action": {
      "revalidation_unavailable": "wait_for_runtime",
      "revoked": "prepare_fresh",
      "invalidated": "prepare_fresh",
      "binding_changed": "prepare_fresh",
      "evidence_changed": "prepare_fresh",
      "human_capability_required": "return_to_human_review",
      "admission_missing": "prepare_fresh",
      "configuration_missing": "configure_activation_identity",
    },
    "configuration_fields": ["host_identity", "ssh_identity_file", "ssh_public_key", "ssh_known_hosts"],
    "stopped_actions": ["activation_preparation", "activation_admission", "vault_write", "activation_revocation"],
    "restriction_causes": [
      "configuration_missing",
      "admission_missing",
      "human_capability_required",
      "evidence_changed",
      "binding_changed",
      "invalidated",
      "revoked",
      "revalidation_unavailable",
    ],
  },
  "blockers": [
    "runtime_unavailable",
    "activation_blocked",
    "vault_unconfigured",
    "remote_unavailable",
    "task_not_found",
    "task_input_mismatch",
    "worker_launch_failed",
    "worker_launch_protocol_failed",
    "worker_lost",
    "main_behind",
    "main_ahead",
    "main_diverged",
    "push_pending",
    "lease_active",
    "lease_stale",
    "ledger_malformed",
    "lease_generation_stale",
    "lease_owner_unknown",
    "remote_moved",
    "receipt_conflict",
    "host_contract_breach",
    "human_required",
    "offline_mode",
    "receipt_corrupt",
    "capability_missing",
    "capability_invalid",
    "capability_role_mismatch",
    "vault_identity_changed",
    "owned_path_not_admitted",
    "commit_subject_invalid",
    "identity_label_invalid",
    "owned_path_changed",
    "unrelated_state_changed",
    "completion_baseline_changed",
    "completion_interrupted",
    "empty_event",
    "vault_check_failed",
    "transaction_mismatch",
    "doctor_proof_stale",
    "doctor_token_invalid",
    "host_quarantined",
    "deterministic_repair_mismatch",
    "repair_action_required",
    "dirty_tree",
    "checker_unadmitted",
    "checker_changed",
    "checker_output_invalid",
    "checker_repair_refused",
    "continuation_unavailable",
    "doctor_observation_expired",
    "completion_observation_expired",
    "owner_pause_active",
  ],
  "invariants": [
    {
      "consequence": "a task that ever observed unknown can never hold a repair authorization",
      "holds": "repairAuthorization present only when state repair_needed, phase terminal, repairReentryBlocked false",
      "id": "repair_authorization_reachability",
    },
    {
      "holds": "exactly one ledger generation holds write authority; CAS append advances it",
      "id": "one_writer",
    },
    {
      "holds": "lease expiry never grants takeover; takeover requires human attestation plus doctor token",
      "id": "lease_expiry_grants_nothing",
    },
    {
      "holds": "heartbeatAt and worker identity are liveness evidence only",
      "id": "heartbeat_not_authority",
    },
    {
      "holds": "doctor grants no vault, git, lease, repair, or activation authority",
      "id": "doctor_authority_free",
    },
    {
      "holds": "push_pending with pushOutcome unknown is persisted before any push is attempted; append failure means push not attempted",
      "id": "commit_evidence_before_push",
    },
  ],
  "monotonic_constraints": [
    {
      "rule": "never_decreases",
      "field": "launchAttempt",
      "entity": "completion_task",
    },
    {
      "rule": "never_decreases",
      "field": "updatedAt",
      "entity": "completion_task",
    },
    {
      "latched_by": "any observation of state unknown",
      "rule": "latch_true",
      "field": "repairReentryBlocked",
      "entity": "completion_task",
    },
    {
      "state": "closed",
      "rule": "cleared_only_on_state",
      "field": "repairAuthorization",
      "entity": "completion_task",
    },
    {
      "rule": "never_decreases",
      "field": "revision",
      "entity": "receipt",
    },
  ],
  "task_refinement_rules": {
    "forbidden": [
      {
        "reason": "closed absorbs",
        "to": "*",
        "from": "closed",
      },
      {
        "reason": "doctor may refine, never decay",
        "to": "unknown",
        "from": "repair_needed",
      },
    ],
    "allowed": [
      {
        "driver": "observation",
        "to": "repair_needed",
        "from": "unknown",
      },
    ],
  },
  "transitions": [
    {
      "driver": "command",
      "to_phase": "intent_durable",
      "event": "acquisition_intent",
    },
    {
      "driver": "command",
      "to_phase": "leased",
      "event": "lease_won",
    },
    {
      "via": "stale-lease-takeover",
      "driver": "repair",
      "to_phase": "leased",
      "event": "lease_won",
    },
    {
      "driver": "command",
      "to_phase": "writing",
      "event": "write_authority_granted",
    },
    {
      "via": "resume",
      "driver": "repair",
      "to_phase": "writing",
      "event": "write_authority_granted",
    },
    {
      "driver": "command",
      "to_phase": "writing",
      "event": "paths_joined",
    },
    {
      "driver": "command",
      "to_phase": "checking",
      "event": "completion_requested",
    },
    {
      "driver": "command",
      "to_phase": "repairable",
      "event": "deterministic_repair_available",
    },
    {
      "driver": "command",
      "to_phase": "committing",
      "event": "commit_candidate_frozen",
    },
    {
      "driver": "command",
      "to_phase": "push_pending",
      "event": "push_outcome_unknown",
    },
    {
      "via": "retry-push",
      "driver": "repair",
      "to_phase": "push_pending",
      "event": "push_outcome_unknown",
    },
    {
      "driver": "command",
      "to_phase": "closed",
      "event": "closed",
    },
    {
      "via": "close-verified",
      "driver": "repair",
      "to_phase": "closed",
      "event": "closed",
    },
    {
      "driver": "command",
      "to_phase": "human_required",
      "event": "human_intervention_required",
    },
    {
      "driver": "repair",
      "to_phase": "human_required",
      "event": "human_intervention_required",
    },
    {
      "note": "prior writer quarantined",
      "driver": "observation",
      "to_phase": "human_required",
      "event": "superseded",
    },
    {
      "via": "reconcile-quarantine",
      "driver": "repair",
      "to_phase": "closed",
      "event": "quarantine_reconciled",
    },
  ],
  "phase_state": "transaction_phase",
  "states": {
    "activation_result_status": {
      "values": ["restricted", "deferred"],
    },
    "result_outcome": {
      "values": [
        "read_only",
        "discovered",
        "unavailable",
        "invalid_usage",
        "admitted",
        "joined",
        "advanced",
        "completed",
        "repaired",
        "refused",
      ],
    },
    "changed_state": {
      "values": ["none", "local", "remote", "committed", "partial"],
    },
    "write_permission": {
      "values": ["denied", "join", "owner"],
    },
    "push_outcome": {
      "values": ["not_attempted", "unknown", "closed", "host_contract_breach"],
    },
    "quarantine_status": {
      "values": ["takeover_pending", "quarantined", "reconciled"],
    },
    "host_disposition": {
      "values": ["authoritative", "quarantined"],
    },
    "lease": {
      "values": ["held", "released"],
    },
    "doctor_task": {
      "checkpoints": ["local_classified", "checking_remote", "terminal"],
      "terminal": ["closed", "unknown"],
      "phases": ["admitted", "running", "terminal"],
      "values": ["claimed", "launching", "in_progress", "closed", "unknown"],
    },
    "completion_task": {
      "absorbing": ["closed"],
      "terminal": ["closed", "repair_needed", "unknown"],
      "state_field_requirements": {
        "in_progress": {
          "launchExpiresAt": "null",
          "launchGeneration": "present",
        },
        "launching": {
          "launchExpiresAt": "present",
          "launchGeneration": "present",
        },
      },
      "legal_pairings": {
        "terminal": ["closed", "repair_needed", "unknown"],
        "running": ["in_progress"],
        "admitted": ["claimed", "launching"],
      },
      "phases": ["admitted", "running", "terminal"],
      "values": ["claimed", "launching", "in_progress", "closed", "repair_needed", "unknown"],
    },
    "transaction_read_state": {
      "observation_sourced": ["absent", "expired", "superseded"],
      "projection_from_phase": {
        "closed": "closed",
        "blocked": "unknown",
        "human_required": "human_required",
        "repairable": "repairable",
        "push_pending": "push_pending",
        "committing": "active",
        "checking": "active",
        "writing": "active",
        "leased": "active",
        "intent_durable": "active",
        "inspecting": "unknown",
        "unavailable": "unknown",
      },
      "values": [
        "absent",
        "active",
        "expired",
        "superseded",
        "unknown",
        "push_pending",
        "repairable",
        "human_required",
        "closed",
      ],
    },
    "transaction_phase": {
      "human_terminal": ["human_required"],
      "terminal": ["closed"],
      "durable_subset_excludes": ["unavailable", "inspecting"],
      "values": [
        "unavailable",
        "inspecting",
        "intent_durable",
        "leased",
        "writing",
        "checking",
        "committing",
        "push_pending",
        "repairable",
        "human_required",
        "blocked",
        "closed",
      ],
    },
  },
  "entities": {
    "candidate_residue": {
      "schema_version": 1,
      "identity": {
        "pattern": "^candidate-",
        "field": "candidateId",
      },
    },
    "host_quarantine": {
      "record": "append_only",
    },
    "capability": {
      "storage": "per_receipt_per_role",
      "delivery": "inherited_fd",
      "roles": ["owner", "join"],
    },
    "activation_record": {
      "bindings": [
        "repositoryIdentity",
        "remoteIdentity",
        "hostIdentity",
        "runtimeIdentity",
        "executableIdentity",
        "privateStateIdentity",
        "localMainHead",
        "remoteMainHead",
        "ledgerGeneration",
        "gitIdentity",
        "sshIdentity",
        "checkerClosure",
      ],
      "schema_version": 2,
      "identity": {
        "pattern": "^vault-git:prepared:v2:[0-9a-f]{64}$",
        "field": "evidenceId",
      },
    },
    "doctor_task": {
      "grants_authority": false,
      "schema_version": 1,
      "revision": {
        "rule": "compare_and_swap",
        "field": "revision",
      },
      "identity": {
        "pattern": "^doctor_task_[0-9a-f]{32}$",
        "field": "taskId",
      },
    },
    "completion_task": {
      "schema_version": 2,
      "launch_generation": {
        "pattern": "^launch_[0-9a-f]{32}$",
        "field": "launchGeneration",
      },
      "launch_attempt": {
        "creates_attempt": false,
        "range": [0, 2],
        "field": "launchAttempt",
      },
      "attempt": {
        "increment_only_by": "explicit_repair",
        "field": "attemptNumber",
      },
      "logical_operation": {
        "field": "taskId",
      },
      "revision": {
        "rule": "compare_and_swap",
        "field": "revision",
      },
      "identity": {
        "pattern": "^task_[0-9a-f]{32}$",
        "field": "taskId",
      },
    },
    "remote_lease": {
      "generation_chain": {
        "advance": "compare_and_swap",
        "ref": "refs/heads/vault-system/transaction-ledger",
      },
      "identity": {
        "fields": ["transactionId", "generation"],
      },
    },
    "receipt": {
      "schema_version": 2,
      "revision": {
        "rule": "monotonic_append_only",
        "field": "revision",
      },
      "identity": {
        "pattern": "^receipt_[0-9a-f]{32}$",
        "field": "receiptId",
      },
    },
    "transaction": {
      "fencing": {
        "owner": "remote_ledger",
        "field": "leaseGeneration",
      },
      "identity": {
        "pattern": "^txn_[0-9a-f]{32}$",
        "field": "transactionId",
      },
    },
  },
  "features": {
    "feature_gates": ["vault_content_repair"],
    "remote_authority": true,
    "version_custody": true,
    "cancellation": "not_supported",
    "liveness_evidence": true,
    "durable_operations": true,
  },
  "spec_meta": {
    "activation_result_schema_version": "3",
    "public_result_schema_version": "2",
    "state_machine_definition_version": "unadmitted",
    "product_specification_revision": "unadmitted",
    "input_schema_version": "2",
    "product": "vault-git",
  },
}
