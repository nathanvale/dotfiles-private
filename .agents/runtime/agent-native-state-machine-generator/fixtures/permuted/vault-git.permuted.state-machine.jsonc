  "retry_posture": {
    "never_auto_retry": [
      "unknown_publication_outcome",
      "unknown_worker_outcome",
      "checker_repair_after_interrupted_promotion",
    ],
    "rules": [
      {
        "then": "operator_required",
        "when": {
          "state_in": ["human_required", "superseded", "expired"],
        },
      },
      {
        "then": "same_input_unsafe",
        "when": {
          "state_in": ["push_pending"],
        },
      },
      {
        "then": "operator_required",
        "when": {
          "blocker": "continuation_unavailable",
        },
      },
      {
        "then": "same_input_safe",
        "when": {
          "activation_cause_in": ["configuration_missing", "admission_missing", "revalidation_unavailable"],
        },
      },
      {
        "then": "operator_required",
        "when": {
          "activation_cause_in": ["human_capability_required", "revoked"],
        },
      },
      {
        "then": "same_input_unsafe",
        "when": {
          "activation_cause_in": ["evidence_changed", "binding_changed", "invalidated"],
        },
      },
      {
        "then": "operator_required",
        "when": {
          "doctor_task_terminal_in": ["worker_failure", "observation_expired"],
        },
      },
      {
        "then": "operator_required",
        "when": {
          "blocker": "owner_pause_active",
        },
      },
      {
        "then": "same_input_safe",
        "when": {
          "blocker": "completion_observation_expired",
        },
      },
      {
        "then": "same_input_safe",
        "when": {
          "result_kind": "inspection",
        },
      },
      {
        "then": "same_input_safe",
        "when": {
          "result_kind": "success",
        },
      },
      {
        "then": "same_input_unsafe",
        "when": {
          "result_kind": "refusal",
        },
      },
    ],
    "values": ["same_input_safe", "same_input_unsafe", "operator_required"],
  },
