/*
 * Cosmetic permutation of vault-git.state-machine.jsonc.
 *
 * Same meaning, deliberately different surface: every object's keys are in
 * reverse order, indentation is spaces rather than tabs, every comment has
 * moved (this block comment replaces the original line comments), and every
 * final array and object element carries a trailing comma.
 *
 * The determinism gate requires this file to produce byte-identical canonical
 * form and an identical digest to the original. It carries no meaning of its
 * own: read the original for what this candidate declares and why.
 */
{
  "unresolved_decisions": [
    {
      "drafted_resolution": "ruled unintended: all four accepted Repair Promotion routes stay publicly reachable under canonical ids. The routes that restore reachability are not yet authored, so the row survives until they are.",
      "question": "Four catalog ids rehydrate to terminal none, making the ADR 0002 Interrupted Repair Promotion table unreachable outside tests. Intended?",
      "id": "interrupted_repair_promotion_reachability",
    },
    {
      "drafted_resolution": "ruled: the complete key is Finding plus closed authoritative-evidence discriminants, and every complete row selects exactly one canonical action. The ruling fixes the table's shape; no source declares the evidence vocabulary or the per-row targets, so the table itself stays unauthored.",
      "question": "The 21 doctor findings map to actions only through imperative call sites. The full declarative finding-to-action table must be authored and admitted; this draft does not invent it.",
      "id": "doctor_finding_action_table",
    },
    {
      "drafted_resolution": "ruled: one ordered first-match-wins table across result classes, encoded above. Exact Same-Input Retry Safety stays a separate meaning. Needs admission.",
      "question": "Success and refusal results currently apply different default retry postures for the same state. This draft unifies them in one ordered table; needs admission.",
      "id": "retry_default_divergence",
    },
    {
      "drafted_resolution": "ruled binding: an intent-bound liveness parameter whose mismatch refuses, while duration and expiry grant no Authority. The schema carries no field for an intent-binding parameter, so the ruling is recorded here rather than declared above.",
      "question": "leaseDurationMs is documented as diagnostic-only but participates in exact intent binding, so a mismatch refuses. Diagnostic or binding?",
      "id": "lease_duration_load_bearing",
    },
    {
      "drafted_resolution": "ruled: new durable writes store canonical ids only, legacy contextual ids resolve through stored context without rewrite, and ambiguity fails closed. The rule governs durable writes rather than a declared surface, so it stays recorded here.",
      "question": "Receipts may persist contextual ids (inspect_status, run_repair, retry_remote) that fail to reproject without context, turning valid durable state into continuation_unavailable. Forbid persisting contextual ids?",
      "id": "persisted_contextual_ids",
    },
    {
      "drafted_resolution": "ruled: preserve the accepted product rule of package-owned monotonic stage budgets derived from production-shaped measurement. The existing numbers above require remeasurement before admission, so the row survives on missing evidence.",
      "question": "Validation stage budgets are admitted as not production-derived, contradicting ADR 0002. Re-measure or amend?",
      "id": "stage_budget_provenance",
    },
    {
      "drafted_resolution": "ruled: the stored quarantine_status reconciled is authoritative, and heuristics may validate but never synthesize reconciliation. Needs the runtime read to change, which is outside this candidate.",
      "question": "Reconciled stale-lease takeover is inferred from a 4-field heuristic instead of the quarantine record's reconciled status. Read stored state instead?",
      "id": "reconciled_takeover_evidence",
    },
    {
      "drafted_resolution": "ruled: the command contract declares positional actions, an explicit activation inspect, and a bare activation that binds to the same inspect action, all encoded above. Two of the five activation actions, defer and revoke, remain unrouted because no catalog action declares their argv.",
      "question": "The command contract declares activation actions but not how they are selected (positional routing lives only in the CLI). The contract should own the route shape.",
      "id": "activation_action_routing",
    },
  ],
