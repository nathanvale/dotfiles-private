{
	"version": 1,
	"barrier": [
		{"name": "git diff --check", "run": ["git", "diff", "--check"]}
	],
	"lanes": [
		{"pluginLanes": true},
		{
			"name": "workspaces",
			"steps": [
				{"name": "test", "run": ["bun", "run", "test"]},
				{"name": "test:hooks", "run": ["bun", "run", "test:hooks"]}
			]
		},
		{
			"name": "static",
			"steps": [
				{"name": "biome:check", "run": ["bun", "run", "biome:check"]},
				{"name": "typecheck", "run": ["bun", "run", "typecheck"]},
				{"name": "test:quality:repository", "run": ["bun", "run", "test:quality:repository"]},
				{"name": "quality:fallow", "run": ["bun", "run", "--silent", "quality:fallow"]},
				{"name": "quality:fallow:runtime", "run": ["bun", "run", "--silent", "quality:fallow:runtime"]}
			]
		}
	],
	"profiles": {
		"ci": {
			"barrier": [
				{"name": "agent-lane-receipt-test.sh", "run": ["bash", "bin/test/agent-lane-receipt-test.sh"]}
			],
			"lanes": [
				{
					"name": "shell",
					"steps": [
						{"name": "agent-lane-audit-test.sh", "run": ["bash", "bin/test/agent-lane-audit-test.sh"]},
						{"name": "agent-lane-launch-test.sh", "run": ["bash", "bin/test/agent-lane-launch-test.sh"]},
						{"name": "agent-lane-zsh-test.sh", "run": ["bash", "bin/test/agent-lane-zsh-test.sh"]},
						{"name": "atuin-agent-history-test.sh", "run": ["bash", "bin/test/atuin-agent-history-test.sh"]},
						{"name": "bun-core-install-test.sh", "run": ["bash", "bin/test/bun-core-install-test.sh"]},
						{"name": "claude-native-install-test.sh", "run": ["bash", "bin/test/claude-native-install-test.sh"]},
						{"name": "cloudflare-access-headers-test.sh", "run": ["bash", "bin/test/cloudflare-access-headers-test.sh"]},
						{"name": "codex-ambient-credential-boundary-test.sh", "run": ["bash", "bin/test/codex-ambient-credential-boundary-test.sh"]},
						{"name": "codex-managed-install-test.sh", "run": ["bash", "bin/test/codex-managed-install-test.sh"]},
						{"name": "generic-credential-consumer-test.sh", "run": ["bash", "bin/test/generic-credential-consumer-test.sh"]},
						{"name": "ghh-test.sh", "run": ["bash", "bin/test/ghh-test.sh"]},
						{"name": "git-effective-behavior-test.sh", "run": ["bash", "bin/test/git-effective-behavior-test.sh"]},
						{"name": "lm-studio-ensure-test.sh", "run": ["bash", "bin/test/lm-studio-ensure-test.sh"]},
						{"name": "profile-link-parity-test.sh", "run": ["bash", "bin/test/profile-link-parity-test.sh"]},
						{"name": "setup-completion-test.sh", "run": ["bash", "bin/test/setup-completion-test.sh"]},
						{"name": "setup-state-recovery-test.sh", "run": ["bash", "bin/test/setup-state-recovery-test.sh"]},
						{"name": "symlinks-manage-test.sh", "run": ["bash", "bin/test/symlinks-manage-test.sh"]},
						{"name": "symlinks-real-directory-test.sh", "run": ["bash", "bin/test/symlinks-real-directory-test.sh"]},
						{"name": "toolchain-apply-test.sh", "run": ["bash", "bin/test/toolchain-apply-test.sh"]},
						{"name": "toolchain-bootstrap-test.sh", "run": ["bash", "bin/test/toolchain-bootstrap-test.sh"]},
						{"name": "toolchain-status-test.sh", "run": ["bash", "bin/test/toolchain-status-test.sh"]},
						{"name": "with-one-password-token-test.sh", "run": ["bash", "bin/test/with-one-password-token-test.sh"]},
						{"name": "work-profile-slug-parity-test.sh", "run": ["bash", "bin/test/work-profile-slug-parity-test.sh"]},
						{"name": "zsh-effective-behavior-test.sh", "run": ["bash", "bin/test/zsh-effective-behavior-test.sh"]},
						{"name": "zsh-startup-silence-test.sh", "run": ["bash", "bin/test/zsh-startup-silence-test.sh"]},
						{"name": "zsh-work-profile-boundary-test.sh", "run": ["bash", "bin/test/zsh-work-profile-boundary-test.sh"]}
					]
				},
				{
					"name": "static",
					"steps": [
						{"name": "quality:fallow --changed-since event commit", "run": ["bun", "run", "--silent", "quality:fallow", "--changed-since", "${COMPARISON_BASE}"]},
						{"name": "quality:fallow:runtime --base event commit", "run": ["bun", "run", "--silent", "quality:fallow:runtime", "--", "--base", "${COMPARISON_BASE}"]}
					]
				}
			]
		}
	}
}
