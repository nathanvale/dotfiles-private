#!/usr/bin/env bash
# HyperFlow CLI Entry Point
# Mirrors the TaskDock shim pattern for consistency

# Load env (Karabiner shell_command doesn't source .zshrc)
[[ -f "$HOME/code/dotfiles/.env" ]] && source "$HOME/code/dotfiles/.env"

# Find HyperFlow root
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
HYPERFLOW_BIN="$SCRIPT_DIR/../apps/hyperflow/hyperflow.sh"

# Execute HyperFlow
exec "$HYPERFLOW_BIN" "$@"
