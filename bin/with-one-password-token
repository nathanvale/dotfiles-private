#!/usr/bin/env bash
# with-one-password-token - Give one scoped 1Password token to op only.
#
# Usage:
#   with-one-password-token check
#   with-one-password-token op <op arguments...>
#   with-one-password-token inject <ENV_KEY> <op://reference> -- <command> [args...]
#   with-one-password-token inject-stdin <op://reference> -- <command> [args...]

# Re-enter before any custody check, helper spawn, or token parsing. A caller's
# exported environment can contain credentials, functions, or names Bash cannot
# safely unset, so the clean child receives only the public process metadata.
if [[ "${#WITH_ONE_PASSWORD_TOKEN_CLEAN_PROOF[@]}" -ne 2 ||
  "${WITH_ONE_PASSWORD_TOKEN_CLEAN_PROOF[0]-}" != 'with-one-password-token' ||
  "${WITH_ONE_PASSWORD_TOKEN_CLEAN_PROOF[1]-}" != 'clean-environment' ]]; then
  clean_dotfiles_dir="${DOTFILES_DIR:-${HOME:-}/code/dotfiles}"
  clean_start_metadata=(
    DOTFILES_DIR "$clean_dotfiles_dir"
  )
  [[ "${HOME+x}" == x ]] && clean_start_metadata+=(HOME "$HOME")
  [[ "${PATH+x}" == x ]] && clean_start_metadata+=(PATH "$PATH")
  [[ "${LANG+x}" == x ]] && clean_start_metadata+=(LANG "$LANG")
  [[ "${LC_ALL+x}" == x ]] && clean_start_metadata+=(LC_ALL "$LC_ALL")
  [[ "${TMPDIR+x}" == x ]] && clean_start_metadata+=(TMPDIR "$TMPDIR")

  # shellcheck disable=SC2016
  exec -c /bin/bash -c '
    while [[ "$1" != "--" ]]; do
      export "$1=$2"
      shift 2
    done
    shift
    WITH_ONE_PASSWORD_TOKEN_CLEAN_PROOF=(with-one-password-token clean-environment)
    source "$0" "$@"
  ' "$0" "${clean_start_metadata[@]}" -- "$@"
fi
unset WITH_ONE_PASSWORD_TOKEN_CLEAN_PROOF clean_dotfiles_dir clean_start_metadata

set -euo pipefail
set +x

PROGRAM_NAME='with-one-password-token'
DOTFILES_DIR="${DOTFILES_DIR:-$HOME/code/dotfiles}"
TOKEN_FILE="$DOTFILES_DIR/.env"
FAIL_CONTEXT=''
RUN_ID=''
SCRUB_RETAINED_NAME=''
SCRUB_ENV_METADATA=()

# These are wrapper-private shell variables. A caller can export any name, and
# Bash assignments may retain that export attribute, so clear them before any
# secret is loaded or resolved.
unset TOKEN_VALUE RESOLVED_STDIN_SECRET secret_value retained_value capture line raw_value

usage() {
  cat <<'EOF'
Usage:
  with-one-password-token check
  with-one-password-token op <op arguments...>
  with-one-password-token inject <ENV_KEY> <op://reference> -- <command> [args...]
  with-one-password-token inject-stdin <op://reference> -- <command> [args...]

Commands:
  check   Validate local token custody and op availability without network access.
          A blocked check ends stderr with a redacted JSON repair envelope.
  op      Run one op command with an exact, scrubbed environment.
          The op "run" subcommand is rejected because it can forward the token.
  inject  Resolve one op reference, remove the service-account token, then exec
          the target with only the requested secret plus basic process variables.
  inject-stdin
          Resolve one op reference, remove the service-account token, then exec
          the target with the resolved secret as its exact standard input.
          This command owns the target standard input and does not set a secret
          environment variable. It preserves non-NUL text bytes, including
          trailing newlines; NUL bytes are unsupported by the shell text boundary.

Token source:
  $DOTFILES_DIR/.env, exact key OP_SERVICE_ACCOUNT_TOKEN.
  The file must be git-ignored, regular, non-symlink, owned by the current user,
  and mode 0600.
EOF
}

check_repair() {
  local code="$1"
  case "$code" in
    token-*) printf 'repair token custody through the dotfiles owner, then rerun check' ;;
    git-missing) printf 'restore git availability, then rerun check' ;;
    op-missing) printf 'restore op CLI availability, then rerun check' ;;
    *) printf 'inspect the error code, repair the dotfiles owner, then rerun check' ;;
  esac
}

emit_check_repair() {
  local code="$1"
  local repair
  repair="$(check_repair "$code")"
  printf '{"status":"blocked","command":"check","code":"%s","preferred_method":"service-account-token","fallback_candidate":"interactive-desktop-signin","fallback_requires_user_approval":true,"same_input_retry_safe":true,"repair":"%s","run_id":"%s"}\n' \
    "$code" "$repair" "$RUN_ID" >&2
}

fail() {
  local code="$1"
  local message="$2"
  local exit_code="${3:-1}"
  printf '%s:error:%s:%s\n' "$PROGRAM_NAME" "$code" "$message" >&2
  if [[ "$FAIL_CONTEXT" == 'check' ]]; then
    emit_check_repair "$code"
  fi
  exit "$exit_code"
}

file_mode() {
  if stat -f '%Lp' "$1" >/dev/null 2>&1; then
    stat -f '%Lp' "$1"
  else
    stat -c '%a' "$1"
  fi
}

file_owner_id() {
  if stat -f '%u' "$1" >/dev/null 2>&1; then
    stat -f '%u' "$1"
  else
    stat -c '%u' "$1"
  fi
}

trim_whitespace() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

load_token() {
  [[ -e "$TOKEN_FILE" ]] || fail 'token-file-missing' "expected $TOKEN_FILE" 3
  [[ ! -L "$TOKEN_FILE" ]] || fail 'token-file-symlink' 'token file must not be a symlink' 3
  [[ -f "$TOKEN_FILE" ]] || fail 'token-file-not-regular' 'token file must be regular' 3
  [[ "$(file_owner_id "$TOKEN_FILE")" == "$(id -u)" ]] || fail 'token-file-owner' 'token file must be owned by the current user' 3
  [[ "$(file_mode "$TOKEN_FILE")" == '600' ]] || fail 'token-file-mode' 'token file mode must be 0600' 3
  command -v git >/dev/null 2>&1 || fail 'git-missing' 'git is required to verify token-file exclusion' 4
  /usr/bin/env -i HOME="$HOME" PATH="$PATH" \
    git -c core.excludesFile=/dev/null -C "$DOTFILES_DIR" check-ignore --quiet -- .env ||
    fail 'token-file-not-ignored' 'token file must be excluded by repository policy' 3

  local line
  local raw_value
  local match_count=0
  export -n line raw_value
  TOKEN_VALUE=''
  export -n TOKEN_VALUE
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?OP_SERVICE_ACCOUNT_TOKEN[[:space:]]*=(.*)$ ]]; then
      match_count=$((match_count + 1))
      raw_value="$(trim_whitespace "${BASH_REMATCH[2]}")"
      if [[ "$raw_value" == \"*\" && "$raw_value" == *\" ]]; then
        raw_value="${raw_value:1:${#raw_value}-2}"
      elif [[ "$raw_value" == \'*\' && "$raw_value" == *\' ]]; then
        raw_value="${raw_value:1:${#raw_value}-2}"
      fi
      TOKEN_VALUE="$raw_value"
    fi
  done <"$TOKEN_FILE"

  [[ "$match_count" -eq 1 ]] || fail 'token-declaration-count' 'expected exactly one token declaration' 3
  [[ "$TOKEN_VALUE" == ops_* ]] || fail 'token-shape' 'token does not match the service-account shape' 3
}

resolve_op() {
  OP_PATH="$(command -v op || true)"
  [[ -n "$OP_PATH" && -x "$OP_PATH" ]] || fail 'op-missing' 'op is not available on PATH' 4
}

resolve_op_subcommand() {
  OP_SUBCOMMAND=''
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --account | --config | --encoding | --format | --session)
        [[ "$#" -ge 2 ]] || fail 'op-global-option-value-missing' "$1 requires a value" 2
        shift 2
        ;;
      --account=* | --cache=* | --config=* | --encoding=* | --format=* | --session=*)
        shift
        ;;
      --cache | --debug | --iso-timestamps | --no-color | -h | --help | -v | --version)
        shift
        ;;
      --)
        return
        ;;
      -*)
        fail 'op-global-option-unsupported' "cannot safely classify $1" 2
        ;;
      *)
        OP_SUBCOMMAND="$1"
        return
        ;;
    esac
  done
}

scrub_environment() {
  local retained_name="${1:-}"
  SCRUB_RETAINED_NAME="$retained_name"
  SCRUB_ENV_METADATA=()
  [[ "${HOME+x}" == x ]] && SCRUB_ENV_METADATA+=(HOME "$HOME")
  [[ "${PATH+x}" == x ]] && SCRUB_ENV_METADATA+=(PATH "$PATH")
  [[ "${LANG+x}" == x ]] && SCRUB_ENV_METADATA+=(LANG "$LANG")
  [[ "${LC_ALL+x}" == x ]] && SCRUB_ENV_METADATA+=(LC_ALL "$LC_ALL")
  [[ "${TMPDIR+x}" == x ]] && SCRUB_ENV_METADATA+=(TMPDIR "$TMPDIR")
  return 0
}

exec_clean_target() {
  local delivery="$1"
  local retained_name="$2"
  shift 2

  # The delivery value is held on file descriptor 3. exec -c guarantees that
  # target environment construction never needs a NAME=secret process argument.
  # shellcheck disable=SC2016
  exec -c /bin/bash -c '
    delivery="$1"
    retained_name="$2"
    shift 2

    while [[ "$1" != "--" ]]; do
      export "$1=$2"
      shift 2
    done
    shift

    case "$delivery" in
      environment)
        if ! IFS= read -r -d "" retained_value <&3; then
          printf "%s:error:secret-delivery-failed:could not receive secret bytes\\n" "${0##*/}" >&2
          exit 70
        fi
        exec 3<&-
        printf -v "$retained_name" "%s" "$retained_value"
        export "$retained_name"
        unset retained_value
        ;;
      stdin)
        # Standard input already refers to the secret pipe in this delivery
        # mode. Close the duplicate descriptor before running the target.
        exec 3<&-
        ;;
      *)
        printf "%s:error:secret-delivery-mode-invalid\\n" "${0##*/}" >&2
        exit 70
        ;;
    esac

    exec "$@"
  ' "$PROGRAM_NAME-clean-launcher" "$delivery" "$retained_name" "${SCRUB_ENV_METADATA[@]}" -- "$@"
}

exec_scrubbed() {
  local retained_value
  export -n retained_value
  [[ -n "$SCRUB_RETAINED_NAME" ]] || fail 'secret-delivery-name-missing' 'internal retained environment name is missing' 70
  retained_value="${!SCRUB_RETAINED_NAME}"

  # A NUL terminator lets the bootstrap preserve the retained value byte-for-
  # byte without putting it in argv or a temporary file.
  exec 3< <(printf '%s\0' "$retained_value")
  unset retained_value
  unset "$SCRUB_RETAINED_NAME"
  exec_clean_target environment "$SCRUB_RETAINED_NAME" "$@"
}

exec_secret_on_stdin() {
  local secret_value="$1"
  export -n secret_value
  shift

  # stdin is intentionally replaced for this public command. The target sees
  # only this pipe; fd 3 is closed by the clean bootstrap before exec.
  exec 3< <(printf '%s' "$secret_value")
  unset secret_value
  exec_clean_target stdin '' "$@" <&3
}

read_secret_for_stdin() {
  local reference="$1"
  local capture
  local marker=$'\034with-one-password-token-end\035'
  local status
  export -n capture RESOLVED_STDIN_SECRET

  # Command substitution removes terminal newlines. Appending a non-NUL marker
  # inside the substitution keeps every newline returned by op --no-newline;
  # stripping exactly the final marker restores the original non-NUL text.
  if capture="$(
    if run_op read --no-newline "$reference"; then
      printf '%s' "$marker"
    else
      exit "$?"
    fi
  )"; then
    :
  else
    status=$?
    return "$status"
  fi

  [[ "$capture" == *"$marker" ]] || fail 'secret-delivery-capture-invalid' 'could not preserve secret bytes' 70
  RESOLVED_STDIN_SECRET="${capture%"$marker"}"
}

run_op() (
  scrub_environment OP_SERVICE_ACCOUNT_TOKEN
  OP_SERVICE_ACCOUNT_TOKEN="$TOKEN_VALUE"
  export -n OP_SERVICE_ACCOUNT_TOKEN
  exec_scrubbed "$OP_PATH" "$@"
)

command="${1:-}"
case "$command" in
  -h | --help | help | '')
    usage
    exit 0
    ;;
  check)
    [[ "$#" -eq 1 ]] || fail 'usage-invalid' 'check takes no arguments' 2
    FAIL_CONTEXT='check'
    RUN_ID="$PROGRAM_NAME-$$"
    load_token
    resolve_op
    unset TOKEN_VALUE OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
    printf '{"status":"ok","token_source":"dotfiles-env","token_present":true,"op_present":true,"preferred_method":"service-account-token","run_id":"%s"}\n' "$RUN_ID"
    ;;
  op)
    shift
    [[ "$#" -gt 0 ]] || fail 'usage-invalid' 'op requires arguments' 2
    resolve_op_subcommand "$@"
    [[ "$OP_SUBCOMMAND" != 'run' ]] || fail 'op-run-rejected' 'use inject so the child cannot inherit the service-account token' 2
    load_token
    resolve_op
    run_op "$@"
    ;;
  inject)
    shift
    [[ "$#" -ge 4 ]] || fail 'usage-invalid' 'inject requires ENV_KEY, op reference, --, and a command' 2
    environment_key="$1"
    reference="$2"
    shift 2
    [[ "$1" == '--' ]] || fail 'usage-invalid' 'inject requires -- before the command' 2
    shift
    [[ "$#" -gt 0 ]] || fail 'usage-invalid' 'inject requires a command' 2
    [[ "$environment_key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || fail 'environment-key-invalid' 'ENV_KEY is not a shell environment name' 2
    [[ "$environment_key" != 'OP_SERVICE_ACCOUNT_TOKEN' ]] || fail 'environment-key-reserved' 'the service-account token cannot be a target variable' 2
    [[ "$reference" == op://* ]] || fail 'reference-invalid' 'expected an op:// reference' 2

    load_token
    resolve_op
    export -n secret_value
    secret_value="$(run_op read "$reference")"
    [[ -n "$secret_value" ]] || fail 'secret-empty' 'the requested field was empty' 5

    unset TOKEN_VALUE OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
    scrub_environment "$environment_key"
    export -n "${environment_key?}"
    printf -v "$environment_key" '%s' "$secret_value"
    unset secret_value
    exec_scrubbed "$@"
    ;;
  inject-stdin)
    shift
    [[ "$#" -ge 3 ]] || fail 'usage-invalid' 'inject-stdin requires an op reference, --, and a command' 2
    reference="$1"
    shift
    [[ "$1" == '--' ]] || fail 'usage-invalid' 'inject-stdin requires -- before the command' 2
    shift
    [[ "$#" -gt 0 ]] || fail 'usage-invalid' 'inject-stdin requires a command' 2
    [[ "$reference" == op://* ]] || fail 'reference-invalid' 'expected an op:// reference' 2

    load_token
    resolve_op
    export -n secret_value
    read_secret_for_stdin "$reference"
    secret_value="$RESOLVED_STDIN_SECRET"
    unset RESOLVED_STDIN_SECRET
    [[ -n "$secret_value" ]] || fail 'secret-empty' 'the requested field was empty' 5

    unset TOKEN_VALUE OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
    scrub_environment
    exec_secret_on_stdin "$secret_value" "$@"
    ;;
  *)
    fail 'usage-invalid' 'unknown command; run --help' 2
    ;;
esac
