#!/usr/bin/env python3
"""Trial opener: preserve exact checkout identity in a fresh VS Code window."""
import pathlib
import re
import subprocess
import sys

route = pathlib.Path.home() / ".config/context/vault.md"
match = re.search(r"^Vault root: `([^`]+)`", route.read_text(), re.MULTILINE)
if not match:
    sys.exit(f"Missing Vault root in {route}")
vault = pathlib.Path(match[1]).resolve()
if len(sys.argv) < 2:
    sys.exit("Usage: open-dev-document FILE [FILE ...]")
for arg in sys.argv[1:]:
    target = pathlib.Path(arg).resolve(strict=True)
    parent = target if target.is_dir() else target.parent
    result = subprocess.run(["git", "-C", str(parent), "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    root = pathlib.Path(result.stdout.strip()).resolve() if result.returncode == 0 else parent
    if root == vault:
        branch = subprocess.check_output(["git", "-C", str(vault), "branch", "--show-current"], text=True).strip()
        if branch != "main":
            sys.exit(f"Vault is on {branch or 'detached HEAD'}, expected main. No branch was changed.")
    subprocess.run(["code", "--new-window", str(root), str(target)], check=True)
