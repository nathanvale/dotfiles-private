#!/usr/bin/env bash
#
# Fail-closed Browser Use lane router.
#
# The lane registry is private machine state. This executable lists declared
# lanes, opens one ordinary URL in a declared profile, reports secret-safe
# health and page access, runs one relay-backed
# mcporter call, Agent Browser batch, Playwright plan, or Puppeteer plan while
# holding the lane's exclusive lease, and create, verify, or expire bounded
# authentication-free recovery snapshots.

set -euo pipefail

readonly PROGRAM='browser-lane'
readonly SCHEMA_VERSION='1'
readonly DEFAULT_TTL_SECONDS='900'
readonly MAX_TTL_SECONDS='3600'
readonly DEFAULT_HANDOFF_WINDOW_SECONDS='1800'
readonly MAX_HANDOFF_WINDOW_SECONDS='86400'
readonly MAX_RETENTION_DAYS='30'
readonly EXIT_USAGE=2
readonly EXIT_NOT_PROVISIONED=10
readonly EXIT_PROFILE_MISMATCH=11
readonly EXIT_RELAY_UNAVAILABLE=12
readonly EXIT_BUSY=13
readonly EXIT_INVALID_REGISTRY=14
readonly EXIT_DRIFT=15
readonly EXIT_PAGE_UNRESOLVED=16
readonly EXIT_LIFECYCLE_UNRESOLVED=17
readonly EXIT_HANDOFF_OPEN=19
readonly EXIT_HANDOFF_STALE=20
readonly EXIT_HANDOFF_TOKEN_INVALID=21
readonly EXIT_BROWSER_OPENING_UNCERTAIN=22
# This list refuses tool-level page creation, navigation, selection, closing,
# PWA lifecycle, extension lifecycle, and out-of-band execution. It cannot
# refuse in-page navigation reached through ordinary interaction: `evaluate_script`
# can set `location`, and a `click` on a link can open a page. Custody is
# therefore re-proved per run by `resolve_admitted_page`, not held continuously
# across a run.
readonly PROHIBITED_TOOLS='new_page navigate navigate_page select_page close_page install_extension uninstall_extension reload_extension install_pwa launch_pwa uninstall_pwa execute_3p_developer_tool execute_webmcp_tool'

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
state_root="$state_home/browser-lanes"
registry="$state_root/registry.json"
leases_root="$state_root/leases"
recovery_root="$state_root/recovery"
handoffs_root="$state_root/handoffs"
free_mode=false
lane_activity_started=false
lane_activity_pid=''
lane_activity_run_id=''
lane_activity_outcome_file=''

load_free_mode() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/browser-lanes/config.json"
  [[ -e "$config" ]] || return 0
  free_mode="$(jq -ers 'if length == 1 and (.[0] | type == "object" and (.free_mode | type) == "boolean") then .[0].free_mode | tostring else error("one config object with boolean free_mode is required") end' "$config" 2>/dev/null)" ||
    emit_error "$EXIT_USAGE" 'invalid_free_mode_config' "$1" false \
      'Browser Lanes config must contain a boolean free_mode' \
      'Set free_mode to true or false in ~/.config/browser-lanes/config.json.'
}

# OpenClaw activity accepts a smaller run-id grammar than the public lane.
# Keep the public run id at its own boundary and derive one opaque, stable
# activity owner.  Hashing avoids both colon collisions and lossy truncation.
activity_run_id() {
  local digest
  digest="$(printf '%s' "$1" | shasum -a 256 | awk '{print $1}')"
  printf 'browser-lane-%s' "$digest"
}

start_lane_activity() {
  local relay_url="$1" run_id="$2" adapter="$3" lease_ttl_seconds="$4"
  local heartbeat_seconds="${BROWSER_LANE_ACTIVITY_HEARTBEAT_SECONDS:-20}" deadline_epoch parent_pid
  [[ "$heartbeat_seconds" =~ ^[1-9][0-9]*$ ]] || heartbeat_seconds=20
  [[ "$lease_ttl_seconds" =~ ^[1-9][0-9]*$ ]] || lease_ttl_seconds="$DEFAULT_TTL_SECONDS"
  lane_activity_run_id="$(activity_run_id "$run_id-$$-$(date +%s)")"
  local -a metadata=(--profile-label "$(jq -r .profile_display_name <<<"$lane_value")")
  [[ -z "${scenario:-}" ]] || metadata+=(--scenario "$scenario")
  if ! "$mcporter_bin" chrome-relay activity start --relay-url "$relay_url" --run-id "$lane_activity_run_id" --adapter "$adapter" --ttl 60000 "${metadata[@]}" >/dev/null 2>&1; then
    printf '%s: lane_activity_unavailable; continuing without the profile-wide activity indication\n' "$PROGRAM" >&2
    lane_activity_run_id=''
    return 0
  fi
  lane_activity_started=true
  # Private child receipts preserve independent action and session-cleanup facts.
  # Their absence is unknown, never an inference from the outer process exit.
  local outcome_dir
  outcome_dir="$(mktemp -d "$state_root/activity-outcome.XXXXXX")" || outcome_dir=''
  if [[ -n "$outcome_dir" ]]; then
    chmod 700 "$outcome_dir"
    lane_activity_outcome_file="$outcome_dir/outcome.json"
    : >"$lane_activity_outcome_file"
    chmod 600 "$lane_activity_outcome_file"
    export BROWSER_LANE_ACTIVITY_OUTCOME="$lane_activity_outcome_file"
  fi
  deadline_epoch=$(( $(date +%s) + lease_ttl_seconds ))
  # Expand this before `&`: Bash otherwise evaluates BASHPID in the async
  # subshell and gives the worker its own PID as the custody parent.
  parent_pid="${BASHPID:-$$}"
  bash -c 'trap '\''if ! kill -0 "$4" 2>/dev/null && [[ -n "$6" ]]; then rm -f "$6"; rmdir "${6%/*}" 2>/dev/null || true; fi'\'' EXIT; sleep_pid=""; stop(){ [[ -z "$sleep_pid" ]] || { kill "$sleep_pid" 2>/dev/null || true; wait "$sleep_pid" 2>/dev/null || true; }; exit 0; }; trap stop HUP INT TERM; while kill -0 "$4" 2>/dev/null; do now=$(date +%s); (( now < $5 )) || exit 0; delay="$3"; remaining=$(( $5 - now )); (( delay <= remaining )) || delay="$remaining"; (( delay > 0 )) || exit 0; sleep "$delay" & sleep_pid=$!; wait "$sleep_pid" || true; sleep_pid=""; kill -0 "$4" 2>/dev/null || exit 0; now=$(date +%s); (( now < $5 )) || exit 0; "$0" chrome-relay activity heartbeat --relay-url "$1" --run-id "$2" --ttl 60000 >/dev/null 2>&1 || true; done' \
    "$mcporter_bin" "$relay_url" "$lane_activity_run_id" "$heartbeat_seconds" "$parent_pid" "$deadline_epoch" "$lane_activity_outcome_file" &
  lane_activity_pid="$!"
}

clear_lane_activity() {
  local relay_url="$1" run_id="$2"
  [[ "$lane_activity_started" == true ]] || return 0
  [[ -z "$lane_activity_pid" ]] || { kill -TERM "$lane_activity_pid" 2>/dev/null || true; wait "$lane_activity_pid" 2>/dev/null || true; }
  if [[ -n "$lane_activity_outcome_file" ]] && jq -e '
      keys == ["actionOutcome","cleanupOutcome","exitCode"] and
      (.actionOutcome | IN("completed","failed","unsupported","unknown")) and
      (.cleanupOutcome | IN("confirmed","unconfirmed","unknown")) and
      (.exitCode | type == "number" and . >= 0 and . <= 255 and . == floor)
    ' "$lane_activity_outcome_file" >/dev/null 2>&1; then
    "$mcporter_bin" chrome-relay activity finish --relay-url "$relay_url" --run-id "$lane_activity_run_id" \
      --action-outcome "$(jq -r .actionOutcome "$lane_activity_outcome_file")" \
      --cleanup-outcome "$(jq -r .cleanupOutcome "$lane_activity_outcome_file")" \
      --exit-code "$(jq -r .exitCode "$lane_activity_outcome_file")" >/dev/null 2>&1 || true
  fi
  "$mcporter_bin" chrome-relay activity clear --relay-url "$relay_url" --run-id "$lane_activity_run_id" >/dev/null 2>&1 || true
  if [[ -n "$lane_activity_outcome_file" ]]; then
    rm -f "$lane_activity_outcome_file"
    rmdir "${lane_activity_outcome_file%/*}" 2>/dev/null || true
  fi
  lane_activity_outcome_file=''
  unset BROWSER_LANE_ACTIVITY_OUTCOME
  lane_activity_started=false; lane_activity_pid=''; lane_activity_run_id=''
}

record_lane_outcome() {
  [[ -n "${BROWSER_LANE_ACTIVITY_OUTCOME:-}" ]] || return 0
  jq -cn --arg action "$1" --arg cleanup "$2" --argjson code "$3" \
    '{actionOutcome:$action,cleanupOutcome:$cleanup,exitCode:$code}' >"$BROWSER_LANE_ACTIVITY_OUTCOME" 2>/dev/null || true
}

publish_handoff_activity() {
  local action="$1" identity label port window
  identity="$(jq -r '[.task_ref, (.opened_at_epoch | tostring)] | join(":")' "$handoff_record")"
  identity="$(activity_run_id "$identity")"
  port="$(jq -r .relay_port <<<"$lane_value")"
  label="$(jq -r .profile_display_name <<<"$lane_value")"
  window="$(jq -r '.window_seconds * 1000' "$handoff_record")"
  "$mcporter_bin" chrome-relay activity "$action" --relay-url "http://127.0.0.1:$port" --run-id "$identity" --profile-label "$label" --window "$window" >/dev/null 2>&1 || true
}

mcporter_supports_core_lane_commands() {
  local candidate="$1" help
  help="$("$candidate" chrome-relay --help 2>/dev/null)" || return 1
  grep -F 'mcporter chrome-relay exec ' <<<"$help" >/dev/null &&
    grep -F 'mcporter chrome-relay status ' <<<"$help" >/dev/null
}

resolve_mcporter_bin() {
  local source_cli="$HOME/code/mcporter/dist/cli.js" candidate
  if [[ -n "${BROWSER_LANE_MCPORTER_BIN:-}" ]]; then
    printf '%s' "$BROWSER_LANE_MCPORTER_BIN"
    return
  fi
  # A stock install earlier on PATH must not hide a capable installed build.
  while IFS= read -r candidate; do
    if mcporter_supports_core_lane_commands "$candidate"; then
      printf '%s' "$candidate"
      return
    fi
  done < <(type -a -p mcporter 2>/dev/null)
  if [[ -x "$source_cli" ]] && mcporter_supports_core_lane_commands "$source_cli"; then
    printf '%s' "$source_cli"
  else
    printf 'mcporter'
  fi
}

mcporter_bin="$(resolve_mcporter_bin)"

usage() {
  cat <<'USAGE'
Usage:
  browser-lane list [--json]
  browser-lane open --lane NAME --account-role ROLE --page-url URL [--json]
  browser-lane health --lane NAME [--json]
  browser-lane inspect --lane NAME --account-role ROLE [--run-id ID] [--ttl SECONDS] [--page-url URL] [--json]
  browser-lane run --lane NAME --account-role ROLE --run-id ID [--ttl SECONDS] [--page-url URL] -- mcporter call chrome-devtools.TOOL ...
  browser-lane agent-browser --lane NAME --account-role ROLE --run-id ID [--ttl SECONDS] --page-url URL [--next-page-url URL] -- "COMMAND"
  browser-lane playwright --lane NAME --account-role ROLE --run-id ID [--ttl SECONDS] --page-url URL --plan FILE
  browser-lane puppeteer --lane NAME --account-role ROLE --run-id ID [--ttl SECONDS] --page-url URL --plan FILE
  browser-lane handoff open --lane NAME --account-role ROLE --run-id ID --task-ref REF --nonce-output PATH [--page-url URL] [--window SECONDS] [--json]
  browser-lane handoff status --lane NAME [--run-id ID] [--json]
  browser-lane handoff resume --lane NAME --account-role ROLE --run-id ID --nonce-file PATH --page-url URL [--json]
  browser-lane handoff release --lane NAME --nonce-file PATH [--run-id ID] [--json]
  browser-lane handoff recover --lane NAME [--reservation SHA256 --acknowledge TASKREF --execute] [--run-id ID] [--json]
  browser-lane recovery create --lane NAME --retention-days DAYS --deletion-owner OWNER [--json]
  browser-lane recovery verify --lane NAME --snapshot ID [--json]
  browser-lane recovery expire --lane NAME --snapshot ID --execute [--json]

Dashboard grouping:
  --scenario ID  Group explicitly equivalent adapter runs in the dashboard.
                 Optional on run, agent-browser, playwright, and puppeteer.
                 Use a non-sensitive identifier; no URLs or page content.
                 Cleanup records session retirement, not undoing page edits.

Commands:
  list      List declared lanes without browser content or account identifiers.
  open      Reuse an exact task tab or open it in the declared Chrome profile without
            checking relay health, tab admission, authentication, or page content.
  health    Check one lane's profile, extension, relay, and declared baseline.
  inspect   Report visible-page counts and exact-target readiness, without content.
  run       Hold the lane lease and run one relay-only MCPorter browser call.
  agent-browser
            Hold the lane lease and bind, pin, verify, run, and retire one Agent Browser session.
  playwright
            Hold the lane lease and run one private, custody-safe Playwright plan.
  puppeteer
            Hold the lane lease and run one private, custody-safe Puppeteer plan.
  handoff   Reserve a lane while its human uses the 1Password extension, then
            explicitly resume or release it without exposing credentials.
  recovery  Create, verify, or expire a private authentication-free blueprint.

Global mode:
  - Global config: ${XDG_CONFIG_HOME:-$HOME/.config}/browser-lanes/config.json.
    {"free_mode":true} enables unrestricted Chrome DevTools lane calls: navigation,
    tab creation/selection/closing and explicit page IDs, without --page-url.
    Use live list_pages IDs and the installed tool schema. The extension must
    use All tabs; the skill may configure this once per profile. Missing config
    or {"free_mode":false} restores secured routing. Malformed config exits 2.
    Free mode retains profile identity, relay authentication and the lane lease.
    Plan adapters retain their plan contracts; use run for unrestricted work.

Health proof gaps (secured mode):
  - Health reads one fresh live access-status snapshot. An unavailable snapshot
    fails the route; an all-tabs, disabled, or transitioning snapshot fails the
    baseline. Preference checks and manual UI observations do not prove it.
  - effective_policy_check_unavailable remains a proof gap on provisioned lanes.

Open contract:
  - The lane and account role resolve one provisioned existing Chrome profile.
  - The URL must be ordinary HTTP or HTTPS with no embedded user information.
  - Opening takes the lane's short command lease and preserves an attended-login
    reservation. A busy or reserved lane is reported before Chrome dispatch.
  - Before opening, a bounded native accessibility check selects the unique
    profile window and briefly cycles its tab-strip controls to compare URL
    metadata. It reads no page content and changes no tab grants.
  - One exact URL match is focused and reused. No match permits a LaunchServices
    new-tab request in the declared profile. Duplicate matches, an unidentifiable
    running profile, hidden tabs, inaccessible metadata, or interrupted checks
    stop without a new-tab request. No URL or tab title is retained or reported.
  - macOS Accessibility and Automation permission are required for tab reuse.
    BROWSER_LANE_OSASCRIPT_BIN is an explicit process-scoped native-host override.
  - The command does not call OpenClaw, MCPorter, or a browser adapter.
  - Reuse reports exact_url_observed and focused. A new launcher dispatch reports
    not_observed and requested. Neither proves authentication or automation readiness.
  - A failed or interrupted launcher dispatch has an uncertain effect. Inspect the
    visible profile before retrying.

Run contract:
  - Agent Browser --next-page-url declares an observed, distinct same-origin
    destination for exactly one action. Success requires the same stable tab
    target ID and exact destination in a fresh pinned inventory, then retirement.
    It reports navigation completion, not application Save success. Inspect the
    destination and verify application state before continuing. Failed actions
    and unreadable or replaced targets stop without replay.
  - The registry is fixed at $XDG_STATE_HOME/browser-lanes/registry.json.
  - The account role must match the selected lane's declared role.
  - Only `mcporter call chrome-devtools.*` is accepted.
  - Page-scoped tools require --page-url. When supplied, the relay must expose
    exactly one admitted match for that URL and it must be the relay's default
    selected page before page content access. Unrelated admitted pages are
    preserved and never selected or modified; bare list_pages may omit the URL.
  - The freshly resolved page index is routed onto the child command line as
    `pageId=INDEX`, before the child's own `--` when it has one. `list_pages`
    takes no input and is never given one. The lane owns that argument; a
    caller-supplied pageId or pageIdx is refused before any relay call.
  - Page creation, navigation, selection, closing, PWA lifecycle, extension
    lifecycle, out-of-band execution calls, and remembered page identifiers
    are refused inside a lane run.
  - A Playwright plan is an absolute, regular, non-symlink mode-600 JSON file.
    It contains schema_version 1 (fixed actions) or 2 (page evaluation),
    and 1 through 50 actions.
    Plans must not contain passwords, one-time codes, magic links, or other
    authentication material. Navigation, tabs, storage, cookies, network
    interception, host run-code, and browser lifecycle commands are refused.
    schema_version 2 adds {"command":"evaluate","args":["() => expression"]}.
    Supply one zero-argument JavaScript function source, optionally async, up
    to 65536 characters including newlines. It runs in the admitted page, not
    Node. Use JSON-encoded task inputs in its source; return bounded JSON data.
    This is trusted task code, not a sandbox for hostile scripts. Page code
    can cause requests or navigation; keep it within the authorized page task.
    URL checks detect changes at call boundaries, not every in-script effect.
    Timeout/disconnect cannot prove page code stopped; inspect before retry.
  - Playwright gives the one-use endpoint only to its run-scoped daemon.
    Browser-reported checks require its selected page to be the unique exact
    URL match before and after each action; unrelated pages remain untouched.
    Hashing runs on the host, independently of page globals. Caller code stays
    in page eval.
    Structured CLI errors stop the plan even when the vendor process exits 0.
    A returned false is result data, not an engine failure.
    The requested TTL bounds adapter work; detach has a separate three-second
    bound. Cancellation retires command and daemon process groups before lane
    release. Unconfirmed detach exits 17 after successful work. Disconnect and
    process retirement do not undo page effects or cancel future page code.
  - A Puppeteer plan has the same file, schema, and authentication rules and
    its own in-page allowlist: title, snapshot, text SELECTOR, click SELECTOR,
    hover SELECTOR, type SELECTOR TEXT, press KEY, select SELECTOR VALUE...,
    wait SELECTOR, plus evaluate FUNCTION in schema_version 2. Each successful
    action prints one JSON line on stdout. Page binding is rechecked after
    evaluate before a successful result is emitted.
  - Puppeteer receives the one-use CDP endpoint only through its environment,
    binds the unique exact page by URL digest, rechecks the same page before
    every action, leaves unrelated pages untouched, and disconnects before the
    relay handoff exits; it never closes the external Chrome profile.
  - The child receives relay policy `require`, the lane's loopback relay URL,
    and `MCPORTER_NO_KEEPALIVE=*` so one lane cannot reuse another lane's daemon.
  - A live owner is always busy. A dead owner is recovered only after expiry.
  - An attended-login handoff is durable private state, separate from a command
    lease. Open and stale handoffs both refuse compliant browser automation.
    Time can mark a handoff stale but never restores access automatically.
  - Handoff output contains only lane metadata, a safe task reference, the
    intended application origin, and its start mode. It omits full URLs,
    titles, page identifiers,
    account identifiers, relay details, and browser content.
  - Handoff open creates --nonce-output exclusively as an owner-only mode-600
    file in an existing canonical mode-700 directory without symlinks. The
    reservation stores only its SHA-256 digest. Resume/release read --nonce-file
    through a bounded private descriptor. Raw tokens never enter outputs,
    environment, or subprocess arguments. Legacy --nonce is refused.
  - Retain the private token file after uncertain opening; replay is unsafe.
    The caller removes it after a confirmed terminal state. A lost token uses
    handoff recover: preview is read-only, and --execute requires the exact
    reservation fingerprint and --acknowledge TASKREF from that preview.
    Recovery holds the lane lease and requires private before/outcome receipts
    under browser-lanes/handoff-recovery. This is explicit operator authority,
    not OS privilege. No expiry or automatic unlock is introduced.
  - Recovery snapshots contain only declared profile-lane baseline values and
    SHA-256 integrity metadata. They never copy Chrome profile files.
  - Recovery expiry removes one verified, expired snapshot only with --execute.

Inspect contract:
  - Hold the exclusive lane lease, prove authenticated transport, and inventory
    only currently visible pages. Change no browser state or sharing permissions.
  - Without --page-url, success proves a readable inventory, not task readiness.
    With it, success requires one exact matching selected page. Unrelated
    visible pages do not make that target ambiguous.
  - Zero visible pages does not prove zero stored grants, a wrong profile, or
    continuous access enforcement. A fresh preflight snapshot reports live access
    mode; stored grants stay unknown.
  - JSON success is on stdout; typed errors are on stderr after one human line.
    Page-access errors include available diagnostic data; preflight errors do not.
    No page titles, URLs, page identifiers, or upstream errors are printed.
  - Before sharing recovery, confirm the exact existing profile and obtain
    approval. Never use another profile, direct port, or unrelated shared page.

Lane contention:
  - Commands in one lane are serial, including inspection. Acquisition and
    expired-owner recovery share one atomic transition claim through owner
    publication. An interrupted transition requires deliberate inspection;
    time alone never clears it.
  - Owner publication waits up to ten 50ms intervals. lane_busy_initializing
    means no browser work launched; retry the same command once after the
    competing command finishes. Persistent missing or invalid owner state
    requires inspection, never automatic removal.

Attended-login handoff:
  - `handoff open --page-url URL` writes the reservation before opening the
    intended application in the declared profile. It requires no relay,
    admitted page, adapter, or page inspection. Without `--page-url`, the
    compatible admitted-page flow derives the origin from one selected page.
  - While open or stale, list, health, untargeted inspect, handoff status, and
    recovery verify remain available. Targeted inspect, every browser engine,
    recovery create or expire, and a second open are refused.
  - `handoff resume --page-url URL` re-proves the lane, Selected-tabs mode,
    one selected exact task page, and the recorded origin before removing the
    reservation. It reuses a valid exact-page permission. If permission is
    absent, it returns the one human grant action and keeps the reservation.
    `release` aborts without page inspection. Both require the nonce.
  - The reservation coordinates callers that obey browser-lane. It cannot prove
    continuous exclusion of a client that bypasses this executable.

Exit codes:
  1   Playwright action or response failed (vendor tool error included)
  0   success
  2   invalid usage
  10  lane not provisioned
  11  profile or account-role mismatch
  12  extension relay unavailable
  13  lane busy
  14  invalid or unsafe registry
  15  baseline drift detected
  16  admitted page could not be uniquely resolved or is not selected
  17  engine tab or session lifecycle could not be safely resolved
  18  an allowlisted in-page engine action failed or timed out
  19  attended-login handoff is open
  20  attended-login handoff is stale
  21  attended-login handoff token is invalid or missing
  22  browser opening outcome is uncertain
  124 Playwright adapter work exceeded its requested TTL
  130 browser operation interrupted

Examples:
  browser-lane list --json
  browser-lane open --lane daily-driver --account-role owner \
    --page-url https://example.com/ --json
  browser-lane health --lane daily-driver --json
  browser-lane inspect --lane daily-driver --account-role owner --json
  browser-lane handoff open --lane daily-driver --account-role owner \
    --run-id task-123 --task-ref sign-in --nonce-output /private/task/login.token \
    --page-url https://example.com/ --json
  browser-lane handoff status --lane daily-driver --json
  browser-lane recovery create --lane daily-driver --retention-days 7 \
    --deletion-owner owner --json
  browser-lane run --lane daily-driver --account-role owner --run-id task-123 -- \
    mcporter call chrome-devtools.list_pages --args '{}' --output json
  browser-lane agent-browser --lane daily-driver --account-role owner \
    --run-id task-123 --page-url https://example.com/ -- "snapshot"
  browser-lane playwright --lane daily-driver --account-role owner \
    --run-id task-123 --page-url https://example.com/ --plan /private/tmp/plan.json
  browser-lane puppeteer --lane daily-driver --account-role owner \
    --run-id task-123 --page-url https://example.com/ --plan /private/tmp/plan.json

Agent Browser attaches its fresh session to the already-admitted page before
strict pinning, verifies the URL around each batch item, then retires the session
inside the same relay handoff. It creates no normal-path about:blank tab.
Playwright exit cleanup detaches its run-scoped attached session and leaves
Chrome open. Puppeteer exit cleanup disconnects its run-scoped connection and
leaves Chrome open; an unproved disconnect after success exits 17.
USAGE
}

die_usage() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  printf "Run '%s --help' for usage.\n" "$PROGRAM" >&2
  exit "$EXIT_USAGE"
}

emit_error() {
  local exit_code="$1" code="$2" run_id="$3" retry_safe="$4" message="$5" next="$6"
  local data="${7:-null}"
  printf '%s: %s\n' "$PROGRAM" "$message" >&2
  jq -cn \
    --arg status 'error' \
    --arg run_id "$run_id" \
    --arg code "$code" \
    --argjson retry_safe "$retry_safe" \
    --arg message "$message" \
    --arg next "$next" \
    --argjson data "$data" \
    '{status:$status,run_id:$run_id,error:{code:$code,retry_safe:$retry_safe,message:$message,next:$next}}
      + (if $data == null then {} else {data:$data} end)' >&2
  exit "$exit_code"
}

generated_run_id() {
  printf 'browser-lane:%s:%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    emit_error "$EXIT_INVALID_REGISTRY" 'dependency_missing' "$2" false \
      "required command is unavailable: $1" \
      "Restore $1 through this machine's configured package owner."
}

private_mode() {
  local path="$1"
  if stat -f '%Lp' "$path" >/dev/null 2>&1; then
    stat -f '%Lp' "$path"
  else
    stat -c '%a' "$path"
  fi
}

validate_registry() {
  local run_id="$1" mode
  [[ -f "$registry" && ! -L "$registry" ]] ||
    emit_error "$EXIT_INVALID_REGISTRY" 'registry_missing' "$run_id" false \
      "private lane registry is missing or unsafe" \
      "Create a regular mode-600 file at $registry."
  mode="$(private_mode "$registry")"
  [[ "$mode" == '600' ]] ||
    emit_error "$EXIT_INVALID_REGISTRY" 'registry_permissions' "$run_id" false \
      "private lane registry permissions are $mode, expected 600" \
      "Run: chmod 600 $registry"
  jq -e --argjson schema "$SCHEMA_VERSION" '
    .schema_version == $schema and
    (.chrome_user_data_dir | type == "string" and startswith("/")) and
    (.extension_id | type == "string" and test("^[a-p]{32}$")) and
    (.lanes | type == "object" and length > 0) and
    ([.lanes | to_entries[] |
      (.key | test("^[a-z0-9][a-z0-9-]{0,62}$")) and
      (.value | type == "object") and
      (.value.provisioned | type == "boolean") and
      (.value.account_role | type == "string" and test("^[a-z0-9][a-z0-9-]{0,62}$")) and
      (.value.relay_port | type == "number" and floor == . and . >= 1024 and . <= 65535) and
      (.value.expected_access_mode == "selected") and
      (if .value.provisioned then
        (.value.profile_directory | type == "string" and length > 0) and
        (.value.profile_display_name | type == "string" and length > 0) and
        (.value.download_directory | type == "string" and startswith("/")) and
        (.value.required_extensions | type == "array" and length > 0 and all(.[]; type == "string" and test("^[a-p]{32}$"))) and
        (.value.allowed_extensions == null or
          ((.value.allowed_extensions | type == "array" and length > 0 and all(.[]; type == "string" and test("^[a-p]{32}$"))) and
           ((.value.required_extensions - .value.allowed_extensions) | length == 0))) and
        (.value.sync_expectations as $sync |
          ($sync | type == "object") and
          (
            ($sync.account_shape == "absent" and ($sync | keys) == ["account_shape"]) or
            ($sync.account_shape == "exactly-one" and
              ($sync | keys) == ["account_shape", "selected_types"] and
              ($sync.selected_types | type == "object" and length > 0 and
                all(to_entries[]; (.key | startswith("sync.")) and (.value | type == "boolean"))))
          ))
      else
        .value.profile_directory == null
      end)
    ] | all) and
    (([.lanes[].relay_port] | length) == ([.lanes[].relay_port] | unique | length))
  ' "$registry" >/dev/null 2>&1 ||
    emit_error "$EXIT_INVALID_REGISTRY" 'registry_invalid' "$run_id" false \
      "private lane registry failed schema or uniqueness validation" \
      "Repair $registry without adding credentials, URLs, or browser content."
}

lane_json() {
  jq -ce --arg lane "$1" '.lanes[$lane] // empty' "$registry"
}

require_lane() {
  local lane="$1" run_id="$2" value
  [[ "$lane" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] ||
    emit_error "$EXIT_USAGE" 'invalid_lane' "$run_id" false \
      "lane name is invalid" "Choose a lane reported by '$PROGRAM list'."
  value="$(lane_json "$lane")"
  [[ -n "$value" ]] ||
    emit_error "$EXIT_USAGE" 'unknown_lane' "$run_id" false \
      "lane is not declared: $lane" "Choose a lane reported by '$PROGRAM list'."
  printf '%s' "$value"
}

profile_path_for() {
  local profile_directory="$1"
  printf '%s/%s' "$(jq -r '.chrome_user_data_dir' "$registry")" "$profile_directory"
}

profile_identity_ok() {
  local lane_value="$1" profile_directory profile_display_name profile_path local_state observed_name
  profile_directory="$(jq -r '.profile_directory' <<<"$lane_value")"
  profile_display_name="$(jq -r '.profile_display_name' <<<"$lane_value")"
  profile_path="$(profile_path_for "$profile_directory")"
  local_state="$(jq -r '.chrome_user_data_dir' "$registry")/Local State"
  [[ -d "$profile_path" && ! -L "$profile_path" && -f "$profile_path/Preferences" ]] || return 1
  [[ -f "$local_state" && ! -L "$local_state" ]] || return 1
  observed_name="$(jq -r --arg profile "$profile_directory" '.profile.info_cache[$profile].name // empty' "$local_state" 2>/dev/null)"
  [[ "$observed_name" == "$profile_display_name" ]]
}

extension_discovery_ok() {
  local lane_value="$1" profile_directory extension_id output_file
  profile_directory="$(jq -r '.profile_directory' <<<"$lane_value")"
  extension_id="$(jq -r '.extension_id' "$registry")"
  output_file="$(mktemp "$state_root/extension-status.XXXXXX")"
  chmod 600 "$output_file"
  if ! openclaw browser extension status --json >"$output_file" 2>/dev/null; then
    rm -f "$output_file"
    return 1
  fi
  if jq -e \
    --arg root "$(jq -r '.chrome_user_data_dir' "$registry")" \
    --arg profile "$profile_directory" \
    --arg extension "$extension_id" '
      .manualSetupRequired == false and
      (.issues | type == "array" and length == 0) and
      any(.discovered[]?; .userDataDir == $root and .profile == $profile and .extensionId == $extension)
    ' "$output_file" >/dev/null 2>&1; then
    rm -f "$output_file"
    return 0
  fi
  rm -f "$output_file"
  return 1
}

# The status command is the sole source of live access mode. It is deliberately
# parsed here rather than inferred from the profile, relay listener, or page list.
live_access_status() {
  local lane_value="$1" output_file port status
  port="$(jq -r '.relay_port' <<<"$lane_value")"
  output_file="$(mktemp "$state_root/access-status.XXXXXX")"
  chmod 600 "$output_file"
  access_status_observed='unknown'
  access_status_state='unavailable'
  if env -u FORCE_COLOR -u NO_COLOR "$mcporter_bin" chrome-relay status --relay-url "http://127.0.0.1:$port" --timeout 5000 >"$output_file" 2>/dev/null &&
    status="$(jq -ce -s '
      if length == 1 and
        (.[0] | type == "object" and keys == ["accessStatus","command","error","ok","runId","schemaVersion"] and
         .schemaVersion == 1 and (.runId | type == "string" and length > 0) and
         .command == "chrome-relay status" and .ok == true and .error == null and
         (.accessStatus | type == "object" and keys == ["enabled","mode","transitioning","version"] and
          .version == 1 and (.mode == "selected" or .mode == "all") and
          (.enabled | type == "boolean") and (.transitioning | type == "boolean")))
      then .[0].accessStatus else empty end
    ' "$output_file" 2>/dev/null)"; then
    access_status_observed="$(jq -r '.mode' <<<"$status")"
    if [[ "$(jq -r '.enabled' <<<"$status")" != 'true' ]]; then
      access_status_state='disabled'
    elif [[ "$(jq -r '.transitioning' <<<"$status")" == 'true' ]]; then
      access_status_state='transitioning'
    elif [[ "$access_status_observed" == 'all' && "$free_mode" == 'true' ]]; then
      access_status_state='selected'
    elif [[ "$access_status_observed" != 'selected' ]]; then
      access_status_state='mismatch'
    else
      access_status_state='selected'
    fi
  fi
  rm -f "$output_file"
}

require_live_access_status() {
  local lane_value="$1" run_id="$2"
  live_access_status "$lane_value"
  case "$access_status_state" in
    selected) return 0 ;;
    unavailable)
      emit_error "$EXIT_RELAY_UNAVAILABLE" 'access_mode_live_check_unavailable' "$run_id" true \
        'the declared relay did not return a valid live access-status snapshot' \
        'Confirm the exact paired extension and relay, then retry. Do not infer Selected tabs from stored preferences.' ;;
    mismatch)
      emit_error "$EXIT_DRIFT" 'access_mode_mismatch' "$run_id" false \
        'the live relay access mode is not Selected tabs' \
        'Change the access mode in the exact OpenClaw extension, then retry.' ;;
    disabled)
      emit_error "$EXIT_DRIFT" 'access_mode_disabled' "$run_id" false \
        'the live relay access mode is disabled' \
        'Enable access in the exact OpenClaw extension, then retry.' ;;
    transitioning)
      emit_error "$EXIT_DRIFT" 'access_mode_transitioning' "$run_id" true \
        'the live relay access mode is changing' \
        'Wait for the mode change to finish, then retry.' ;;
  esac
}

relay_listener_ok() {
  local lane_value="$1" port output_file expected_uid pid_count command_count uid_count address_count
  port="$(jq -r '.relay_port' <<<"$lane_value")"
  command -v lsof >/dev/null 2>&1 || return 1
  output_file="$(mktemp "$state_root/relay-listener.XXXXXX")"
  chmod 600 "$output_file"
  if ! lsof -nP -iTCP:"$port" -sTCP:LISTEN -Fpcun >"$output_file" 2>/dev/null; then
    rm -f "$output_file"
    return 1
  fi
  expected_uid="$(id -u)"
  pid_count="$(awk '/^p[0-9]+$/{count++} END{print count+0}' "$output_file")"
  command_count="$(awk '$0=="cnode"{count++} END{print count+0}' "$output_file")"
  uid_count="$(awk -v expected="u$expected_uid" '$0==expected{count++} END{print count+0}' "$output_file")"
  address_count="$(awk -v expected="n127.0.0.1:$port" '$0==expected{count++} END{print count+0}' "$output_file")"
  rm -f "$output_file"
  [[ "$pid_count" == '1' && "$command_count" == '1' && "$uid_count" == '1' && "$address_count" == '1' ]]
}

is_prohibited_tool() {
  case " $PROHIBITED_TOOLS " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

agent_browser_command_allowed() {
  local command="$1" trimmed
  [[ -n "$command" && "$command" != *$'\n'* && "$command" != *$'\r'* ]] || return 1
  trimmed="${command#"${command%%[![:space:]]*}"}"
  case "$trimmed" in
    open|open\ *|tab|tab\ *|connect|connect\ *|close|close\ *|back|back\ *|forward|forward\ *|reload|reload\ *|pushstate|pushstate\ *|auth|auth\ *|plugin|plugin\ *|mcp|mcp\ *|dashboard|dashboard\ *|install|install\ *|profiles|profiles\ *|session|session\ *) return 1 ;;
    *) return 0 ;;
  esac
}

has_remembered_page_identifier() {
  local child_arg
  for child_arg in "$@"; do
    if [[ "$child_arg" =~ (^|[^A-Za-z])page(Id|Idx)([^A-Za-z]|$) ]]; then
      return 0
    fi
  done
  return 1
}

read_admitted_pages() {
  local lane_value="$1" page_url="$2" run_id="$3"
  local port output_file page_summary expected_mode page_list_status
  port="$(jq -r '.relay_port' <<<"$lane_value")"
  expected_mode="$(jq -r '.expected_access_mode' <<<"$lane_value")"
  # All callers have already passed route_preflight under the lane lease.
  # Only this inventory's counts and selection can be inferred from list_pages.
  page_access_data="$(jq -cn --arg mode "$expected_mode" --arg observed "$access_status_observed" --arg url "$page_url" '
    {transport:"authenticated",inventory:"unreadable",visible_page_count:null,
     target:{requested:($url != ""),match_count:null,selected:null},readiness:"unknown",
     access_mode:{expected:$mode,observed:$observed},stored_grants:"unknown"}')"
  output_file="$(mktemp "$state_root/page-list.XXXXXX")"
  page_list_temp_file="$output_file"
  chmod 600 "$output_file"
  # Job control gives this one background command its own process group. The
  # inventory can synchronously wait while signal cleanup still retires the
  # MCPorter leader and every descendant before releasing lane custody.
  set -m
  MCPORTER_NO_KEEPALIVE='*' \
    MCPORTER_CHROME_DEVTOOLS_RELAY_POLICY='require' \
    MCPORTER_CHROME_DEVTOOLS_RELAY_URL="http://127.0.0.1:$port" \
    "$mcporter_bin" call chrome-devtools.list_pages --args '{}' --output json >"$output_file" 2>/dev/null &
  page_list_child_pid=$!
  page_list_child_pgid="$page_list_child_pid"
  set +m
  if wait "$page_list_child_pid"; then
    page_list_status=0
  else
    page_list_status=$?
  fi
  retire_page_list_child
  if [[ "$page_list_status" != '0' ]]; then
    cleanup_page_list_file
    emit_error "$EXIT_RELAY_UNAVAILABLE" 'relay_unavailable' "$run_id" true \
      'the authenticated route passed preflight, but its page inventory call failed' \
      "Confirm the exact existing profile's OpenClaw popup says Connected, then retry once." "$page_access_data"
  fi
  # chrome-devtools-mcp reports pages as Markdown text inside the MCP content
  # envelope, one page per line: "IDX: TITLE (URL)" with a trailing
  # " [selected]" on the relay's default selected page. An unavailable title
  # produces "IDX: URL" instead. Only a complete whitespace-free URI is
  # accepted in that form. Titles are
  # attacker-controlled and may contain parentheses, brackets, URL-like text,
  # and shell metacharacters, so every field is taken from a fixed terminal
  # position rather than a greedy pattern: the selected marker is an exact
  # suffix, and the URL is the last parenthesised group closing the line. Any
  # line that does not parse under those rules refuses the whole list instead
  # of admitting a guess. Only counts and the numeric index leave this filter;
  # titles and URLs never reach the shell, a command line, or a refusal.
  if ! page_summary="$(jq -s -ce --arg page_url "$page_url" '
    def split_selected:
      if endswith(" [selected]")
      then {selected: true, body: .[0:(length - 11)]}
      else {selected: false, body: .}
      end;

    def parse_page_line:
      (index(": ")) as $colon
      | .[0:$colon] as $id
      | (.[($colon + 2):] | split_selected) as $split
      | $split.body as $body
      | ($body | rindex(" (")) as $open
      | if $open == null and ($body | test("^[A-Za-z][A-Za-z0-9+.-]*:[^[:space:]]+$"))
        then {id: $id, url: $body, selected: $split.selected}
        elif $open == null or (($body | endswith(")")) | not)
        then error("unparseable_page_line")
        else {
          id: $id,
          url: $body[($open + 2):(($body | length) - 1)],
          selected: $split.selected
        }
        end
      | if (.url | length) == 0 or (.url | test("[[:space:]]"))
        then error("unparseable_page_url")
        else .
        end;

    def line_kind:
      if test("^[0-9]+: ") then "page"
      elif test("^[[:space:]]*$") then "ignore"
      elif startswith("#") then "ignore"
      else "unknown"
      end;

    if length != 1 then error("multiple_documents") else .[0] end
    | if type != "object" then error("invalid_envelope") else . end
    | if (.content | type) != "array" or (.isError != null and .isError != false)
      then error("invalid_content") else . end
    | if any(.content[]; type != "object") then error("invalid_part") else . end
    | if any(.content[]; .type == "text" and (.text | type) != "string")
      then error("invalid_text") else . end
    | [.content[] | select(.type == "text") | .text]
    | if length == 0 then error("no_text_content") else . end
    | join("\n")
    | split("\n")
    | if any(.[]; line_kind == "unknown") then error("unknown_line") else . end
    | [.[] | select(line_kind == "page") | parse_page_line] as $pages
    | [$pages[] | select(.url == $page_url)] as $matches
    | {visible_page_count:($pages|length),
       target:{requested:($page_url != ""),
         match_count:(if $page_url == "" then null else ($matches|length) end),
         selected:(if ($matches|length) == 1 then $matches[0].selected else null end)},
       matched_id:(if ($matches|length) == 1 then $matches[0].id else "" end),
       single_url:(if ($pages|length) == 1 then $pages[0].url else "" end),
       single_selected:(if ($pages|length) == 1 then $pages[0].selected else null end),
       readiness:(if $page_url == "" then
           (if ($pages|length) == 0 then "no_visible_pages" else "target_not_requested" end)
         elif ($matches|length) == 0 then "target_absent"
         elif ($matches|length) > 1 then "ambiguous"
         elif $matches[0].selected != true then "target_not_selected"
         elif ([$pages[] | select(.selected)] | length) > 1 then "ambiguous"
         else "ready" end)}
  ' "$output_file" 2>/dev/null)"; then
    cleanup_page_list_file
    emit_error "$EXIT_PAGE_UNRESOLVED" 'page_list_unreadable' "$run_id" false \
      'the relay did not return a readable admitted page list' \
      "Confirm the exact existing profile and inspect its OpenClaw popup; request approval before changing sharing." "$page_access_data"
  fi
  cleanup_page_list_file
  resolved_page_id="$(jq -r '.matched_id' <<<"$page_summary")"
  resolved_single_page_url="$(jq -r '.single_url' <<<"$page_summary")"
  resolved_single_page_selected="$(jq -r '.single_selected' <<<"$page_summary")"
  page_access_data="$(jq -c --argjson summary "$page_summary" \
    '. + ($summary | del(.matched_id,.single_url,.single_selected)) + {inventory:"readable"}' <<<"$page_access_data")"
}

require_admitted_page() {
  local run_id="$1" readiness admitted_count match_count
  decode_page_target_facts
  readiness="$page_target_readiness"
  admitted_count="$page_target_admitted_count"
  match_count="$page_target_match_count"
  if [[ "$readiness" == 'target_absent' ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'page_not_admitted' "$run_id" true \
      "no admitted page matches the declared page (matched 0 of $admitted_count admitted pages); visible pages do not establish stored grants or access mode" \
      "Observe the intended tab's current ordinary URL in the exact existing profile and inspect that URL. If the task tab is not shared, ask the human to admit it. Never guess URL variants, navigate another shared page, or attach directly." "$page_access_data"
  fi
  if [[ "$readiness" == 'ambiguous' ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'page_ambiguous' "$run_id" true \
      "the lane must expose exactly one admitted page matching the declared page (matched $match_count of $admitted_count admitted pages)" \
      "Confirm the exact existing profile and request approval to limit sharing to the intended tab, then retry." "$page_access_data"
  fi
  if [[ "$readiness" != 'ready' ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'page_not_selected' "$run_id" true \
      "the declared page is admitted but is not the relay's default selected page" \
      "Confirm the exact existing profile and request approval before changing tab selection or sharing, then retry." "$page_access_data"
  fi
}

resolve_admitted_page() {
  read_admitted_pages "$1" "$2" "$3"
  require_admitted_page "$3"
}

inspect_lane() {
  local lane_value="$1" page_url="$2" json="$3" run_id="$4"
  read_admitted_pages "$lane_value" "$page_url" "$run_id"
  [[ -z "$page_url" ]] || require_admitted_page "$run_id"
  if [[ "$json" == 'true' ]]; then
    jq -cn --arg run_id "$run_id" --argjson data "$page_access_data" \
      '{status:"ok",run_id:$run_id,data:$data}'
  else
    jq -r '"transport=\(.transport) inventory=\(.inventory) visible_pages=\(.visible_page_count) target_matches=\(.target.match_count) target_selected=\(.target.selected) readiness=\(.readiness) access_mode=\(.access_mode.observed) expected_access_mode=\(.access_mode.expected) stored_grants=\(.stored_grants)"' <<<"$page_access_data"
  fi
}

page_access_data='null'
page_list_temp_file=''
page_list_child_pid=''
page_list_child_pgid=''
page_target_readiness='unknown'
page_target_admitted_count='null'
page_target_match_count='null'
page_target_selected='null'
agent_cleanup_temp_dir=''
resolved_single_page_url=''
resolved_single_page_selected='null'

decode_page_target_facts() {
  local decoded
  decoded="$(jq -r '[.readiness,.visible_page_count,.target.match_count,.target.selected] | map(tostring) | @tsv' <<<"$page_access_data")"
  IFS=$'\t' read -r page_target_readiness page_target_admitted_count \
    page_target_match_count page_target_selected <<<"$decoded"
}

cleanup_page_list_file() {
  retire_page_list_child
  [[ -n "${page_list_temp_file:-}" ]] || return 0
  rm -f "$page_list_temp_file"
  page_list_temp_file=''
}

retire_page_list_child() {
  local attempt
  [[ -n "${page_list_child_pid:-}" && -n "${page_list_child_pgid:-}" ]] || return 0
  if kill -0 -- "-$page_list_child_pgid" 2>/dev/null; then
    kill -TERM -- "-$page_list_child_pgid" 2>/dev/null || true
    for ((attempt = 0; attempt < 20; attempt++)); do
      kill -0 -- "-$page_list_child_pgid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 -- "-$page_list_child_pgid" 2>/dev/null; then
      kill -KILL -- "-$page_list_child_pgid" 2>/dev/null || true
    fi
  fi
  wait "$page_list_child_pid" 2>/dev/null || true
  page_list_child_pid=''
  page_list_child_pgid=''
}

cleanup_agent_browser_temp_dir() {
  [[ -n "${agent_cleanup_temp_dir:-}" ]] || return 0
  rm -f "$agent_cleanup_temp_dir/info.json" "$agent_cleanup_temp_dir/list.json" "$agent_cleanup_temp_dir/close.json" "$agent_cleanup_temp_dir/session.json" "$agent_cleanup_temp_dir/url.json" "$agent_cleanup_temp_dir/outcome.json" "$agent_cleanup_temp_dir/run"
  rmdir "$agent_cleanup_temp_dir" 2>/dev/null || true
  agent_cleanup_temp_dir=''
}

# A shared CDP session must attach without pinning before it can safely pin the
# already-admitted page. The runner stays within one authenticated MCPorter
# handoff, keeping the endpoint private through bind, guard, work, and retirement.
run_agent_browser_staged() {
  local relay_url="$1" session_name="$2" page_url_hash="$3" next_page_url_hash="$4"
  shift 4
  local runner outcome_file child_status phase outcome_status
  agent_cleanup_temp_dir="$(mktemp -d "$state_root/agent-cleanup.XXXXXX")"
  chmod 700 "$agent_cleanup_temp_dir"
  runner="$agent_cleanup_temp_dir/run"
  outcome_file="$agent_cleanup_temp_dir/outcome.json"
  cat >"$runner" <<'SH'
#!/usr/bin/env bash
set -u
state_dir="$BROWSER_LANE_AGENT_STATE_DIR"
session="$BROWSER_LANE_AGENT_SESSION"
expected_hash="$BROWSER_LANE_AGENT_PAGE_SHA256"
next_expected_hash="$BROWSER_LANE_AGENT_NEXT_PAGE_SHA256"
expected_target_id=''
navigation_observed=false
outcome="$state_dir/outcome.json"
info="$state_dir/info.json"
attached="$state_dir/list.json"
url_file="$state_dir/url.json"
finish() { jq -cn --arg phase "$1" --argjson status "${2:-0}" '{phase:$phase,status:$status}' >"$outcome"; }
retire() {
  agent-browser --session "$session" session info --json >"$info" 2>/dev/null || return 1
  jq -e '.success == true and (.data.active | type) == "boolean"' "$info" >/dev/null 2>&1 || return 1
  if [[ "$(jq -r '.data.active' "$info")" == true ]]; then
    agent-browser --session "$session" close --json >"$state_dir/session.json" 2>/dev/null || return 1
    jq -e '.success == true and .data.closed == true' "$state_dir/session.json" >/dev/null 2>&1 || return 1
  fi
}
# This is the only unpinned command.  It attaches the fresh run-scoped session
# to the already-proved sole selected page; its result never reaches stdout.
if ! agent-browser --session "$session" tab list --json >"$attached" 2>/dev/null; then
  if retire; then
    finish attach_failed 17
  else
    finish attach_cleanup_failed 17
  fi
  exit 85
fi
if [[ -n "$next_expected_hash" ]]; then
  expected_target_id="$(jq -er 'if .success == true and (.data.tabs | type) == "array" and (.data.tabs | length) == 1 and (.data.tabs[0].targetId | type) == "string" and (.data.tabs[0].targetId | length) > 0 and (.data.tabs[0].url | type) == "string" then .data.tabs[0].targetId else error("invalid") end' "$attached" 2>/dev/null)" || {
    if retire; then finish attach_failed 17; else finish attach_cleanup_failed 17; fi
    exit 85
  }
  initial_attached_url="$(jq -er '.data.tabs[0].url' "$attached")" || exit 85
  initial_attached_hash="$(printf '%s' "$initial_attached_url" | shasum -a 256 | awk '{print $1}')"
  [[ "$initial_attached_hash" == "$expected_hash" ]] || { if retire; then finish url_mismatch 16; else finish url_mismatch_cleanup_failed 16; fi; exit 87; }
fi
# Pin only after the attachment established the sole admitted page. Each item
# has its own pre/post URL proof; navigation stops the remaining batch.
guard_page() {
if ! agent-browser --session "$session" --pin-tab get url --json >"$url_file" 2>/dev/null; then
  if retire; then
    finish url_unreadable 16
  else
    finish url_unreadable_cleanup_failed 16
  fi
  exit 86
fi
actual_url="$(jq -er 'if .success == true then (.data.url // .data.value // .data) else error("failed") end | select(type == "string")' "$url_file" 2>/dev/null)" || {
  if retire; then
    finish url_unreadable 16
  else
    finish url_unreadable_cleanup_failed 16
  fi
  exit 86
}
actual_hash="$(printf '%s' "$actual_url" | shasum -a 256 | awk '{print $1}')"
if [[ "$actual_hash" != "$expected_hash" ]]; then
  if retire; then
    finish url_mismatch 16
  else
    finish url_mismatch_cleanup_failed 16
  fi
  exit 87
fi
}
verify_transition() {
  # A navigation event may reach the inventory after the click returns. Poll
  # observations only, retaining the original target; never replay the action.
  for transition_attempt in 1 2 3 4 5; do
    if ! agent-browser --session "$session" --pin-tab tab list --json >"$state_dir/list.json" 2>/dev/null ||
      ! jq -e --arg target "$expected_target_id" '
        .success == true and (.data.tabs | type) == "array" and (.data.tabs | length) == 1 and
        .data.tabs[0].targetId == $target and (.data.tabs[0].url | type) == "string"
      ' "$state_dir/list.json" >/dev/null 2>&1; then
      if retire; then finish transition_unreadable 16; else finish transition_unreadable_cleanup_failed 16; fi
      exit 86
    fi
    transition_url="$(jq -er '.data.tabs[0].url' "$state_dir/list.json")"
    transition_hash="$(printf '%s' "$transition_url" | shasum -a 256 | awk '{print $1}')"
    if [[ "$transition_hash" == "$next_expected_hash" ]]; then navigation_observed=true; return 0; fi
    [[ "$transition_hash" == "$expected_hash" ]] || break
    # Tab inventory URLs may stay cached across a document navigation. Ask the
    # pinned target for its current URL, then recheck its identity before success.
    if [[ "$transition_hash" == "$expected_hash" ]] &&
      agent-browser --session "$session" --pin-tab get url --json >"$url_file" 2>/dev/null; then
      transition_url="$(jq -er 'select(.success == true) | (.data.url // .data.value // .data) | select(type == "string")' "$url_file" 2>/dev/null)" || transition_url=''
      transition_hash="$(printf '%s' "$transition_url" | shasum -a 256 | awk '{print $1}')"
      if [[ "$transition_hash" == "$next_expected_hash" ]] &&
        agent-browser --session "$session" --pin-tab tab list --json >"$state_dir/list.json" 2>/dev/null &&
        jq -e --arg target "$expected_target_id" '.success == true and (.data.tabs | length) == 1 and .data.tabs[0].targetId == $target' "$state_dir/list.json" >/dev/null 2>&1; then
        navigation_observed=true; return 0
      fi
      [[ -z "$transition_url" || "$transition_hash" == "$expected_hash" ]] || break
    fi
    [[ "$transition_attempt" != 5 ]] || break
    sleep 0.1
  done
  if retire; then finish url_mismatch 16; else finish url_mismatch_cleanup_failed 16; fi
  exit 87
}

work_status=0
for action in "$@"; do
  guard_page
  agent-browser --session "$session" --pin-tab batch --bail "$action"
  work_status=$?
  [[ "$work_status" == 0 ]] || break
  if [[ -n "$next_expected_hash" ]]; then verify_transition; else guard_page; fi
  [[ "$navigation_observed" == true ]] && break
done
if ! retire; then
  finish cleanup_failed "$work_status"
  exit 88
fi
if [[ "$navigation_observed" == true ]]; then
  finish navigation "$work_status"
else
  finish work "$work_status"
fi
exit "$work_status"
SH
  chmod 700 "$runner"
  BROWSER_LANE_AGENT_STATE_DIR="$agent_cleanup_temp_dir" \
    BROWSER_LANE_AGENT_SESSION="$session_name" \
    BROWSER_LANE_AGENT_PAGE_SHA256="$page_url_hash" \
    BROWSER_LANE_AGENT_NEXT_PAGE_SHA256="$next_page_url_hash" \
    "$mcporter_bin" chrome-relay exec --relay-url "$relay_url" -- "$runner" "$@"
  child_status=$?
  phase="$(jq -r '.phase // "unknown"' "$outcome_file" 2>/dev/null || printf unknown)"
  outcome_status="$(jq -r 'if (.status | type) == "number" and .status >= 0 and .status == (.status | floor) then .status else empty end' "$outcome_file" 2>/dev/null || true)"
  AGENT_BROWSER_STAGED_PHASE="$phase"
  AGENT_BROWSER_STAGED_STATUS="${outcome_status:-17}"
  return "$child_status"
}

route_preflight() {
  local lane="$1" lane_value="$2" run_id="$3"
  if [[ "$(jq -r '.provisioned' <<<"$lane_value")" != 'true' ]]; then
    emit_error "$EXIT_NOT_PROVISIONED" 'lane_not_provisioned' "$run_id" false \
      "lane is declared but not provisioned: $lane" \
      "Create the intended Chrome profile, install OpenClaw, pair its relay, then update the private registry."
  fi
  profile_identity_ok "$lane_value" ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'profile_mismatch' "$run_id" false \
      "lane profile identity does not match its registry entry: $lane" \
      "Open the intended Chrome profile and repair its exact directory or display-name mapping."
  extension_discovery_ok "$lane_value" ||
    emit_error "$EXIT_RELAY_UNAVAILABLE" 'extension_unavailable' "$run_id" true \
      "OpenClaw is not discovered in the declared Chrome profile: $lane" \
      "Install or enable the extension in that exact profile, then confirm its popup says Connected."
  require_live_access_status "$lane_value" "$run_id"
}

process_start_identity() {
  ps -o lstart= -p "$1" 2>/dev/null | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

lease_owner_matches_live_process() {
  local owner_file="$1" owner_pid owner_start current_start
  owner_pid="$(jq -r '.pid // empty' "$owner_file" 2>/dev/null)"
  owner_start="$(jq -r '.process_start // empty' "$owner_file" 2>/dev/null)"
  [[ "$owner_pid" =~ ^[1-9][0-9]*$ && -n "$owner_start" ]] || return 1
  kill -0 "$owner_pid" 2>/dev/null || return 1
  current_start="$(process_start_identity "$owner_pid")"
  [[ -n "$current_start" && "$current_start" == "$owner_start" ]]
}

lease_transition_dir=''

release_lease_transition() {
  [[ -n "$lease_transition_dir" ]] || return 0
  local owned_transition="$lease_transition_dir"
  lease_transition_dir=''
  rmdir "$owned_transition" 2>/dev/null || true
}

acquire_lease() {
  local lane="$1" run_id="$2" ttl="$3" lease_dir owner_file now expires owner_run publication_checks
  lease_dir="$leases_root/$lane.lock"
  owner_file="$lease_dir/owner.json"
  # Serialize observation, dead-owner recovery, and replacement publication.
  # Without this claim, a second reclaimer can delete a newly live owner using
  # an earlier stale observation. A crashed transition stays fail-closed.
  local transition_dir="$leases_root/$lane.transition"
  if ! mkdir "$transition_dir" 2>/dev/null; then
    [[ -d "$transition_dir" && ! -L "$transition_dir" ]] ||
      emit_error "$EXIT_BUSY" 'lane_busy_unreadable' "$run_id" false \
        "lane transition path is unsafe: $lane" \
        "Inspect the private lane transition path before retrying."
    emit_error "$EXIT_BUSY" 'lane_busy_initializing' "$run_id" true \
      "another command is acquiring or recovering the lane: $lane" \
      "Retry the same command once after the competing command finishes. A persistent transition may be interrupted; inspect it rather than removing it automatically."
  fi
  lease_transition_dir="$transition_dir"
  trap release_lease_transition EXIT
  trap 'release_lease_transition; exit 129' HUP
  trap 'release_lease_transition; exit 130' INT
  trap 'release_lease_transition; exit 143' TERM
  chmod 700 "$transition_dir"
  now="$(date +%s)"
  expires=$((now + ttl))

  while ! mkdir "$lease_dir" 2>/dev/null; do
    # mkdir claims custody before the atomic owner-file publication. Wait only
    # for that metadata; never steal an unpublished claim or launch work in it.
    publication_checks=0
    while [[ -d "$lease_dir" && ! -L "$lease_dir" && ! -e "$owner_file" && ! -L "$owner_file" && "$publication_checks" -lt 10 ]]; do
      sleep 0.05
      publication_checks=$((publication_checks + 1))
    done
    # A completing owner may remove its directory while this caller observes it.
    [[ -e "$lease_dir" || -L "$lease_dir" ]] || continue
    if [[ -d "$lease_dir" && ! -L "$lease_dir" && ! -e "$owner_file" && ! -L "$owner_file" ]]; then
      emit_error "$EXIT_BUSY" 'lane_busy_initializing' "$run_id" true \
        "lane is claimed but its owner record is not available yet: $lane" \
        "Retry the same command once after the current command finishes. If this persists, inspect the private lease directory; do not remove it automatically."
    fi
    if ! [[ -d "$lease_dir" && ! -L "$lease_dir" && -f "$owner_file" && ! -L "$owner_file" ]] ||
      ! jq -e '
        type == "object" and
        (.run_id | type == "string" and length > 0) and
        (.pid | type == "number" and . > 0 and floor == .) and
        (.process_start | type == "string" and length > 0) and
        (.acquired_at_epoch | type == "number" and . >= 0 and floor == .) and
        (.expires_at_epoch | type == "number" and . >= 0 and floor == .) and
        .expires_at_epoch >= .acquired_at_epoch
      ' "$owner_file" >/dev/null 2>&1; then
      emit_error "$EXIT_BUSY" 'lane_busy_unreadable' "$run_id" false \
        "lane lease path or owner record is unsafe or invalid: $lane" \
        "Inspect the private lease directory before retrying."
    fi
    owner_run="$(jq -r '.run_id // "unknown"' "$owner_file" 2>/dev/null)"
    if lease_owner_matches_live_process "$owner_file"; then
      emit_error "$EXIT_BUSY" 'lane_busy' "$run_id" true \
        "lane is owned by another live run: $lane" \
        "Retry after run $owner_run releases the lane."
    fi
    owner_expires="$(jq -r '.expires_at_epoch // 0' "$owner_file" 2>/dev/null)"
    [[ "$owner_expires" =~ ^[0-9]+$ && "$owner_expires" -le "$now" ]] ||
      emit_error "$EXIT_BUSY" 'lane_busy_stale_grace' "$run_id" true \
        "lane owner is not live but its recovery grace has not expired: $lane" \
        "Retry after the recorded lease expiry."
    rm -f "$owner_file"
    rmdir "$lease_dir" 2>/dev/null ||
      emit_error "$EXIT_BUSY" 'lane_busy_recovery_race' "$run_id" true \
        "lane stale-owner recovery lost a concurrent race: $lane" \
        "Retry the same command once."
  done

  chmod 700 "$lease_dir"
  owner_tmp="$lease_dir/owner.json.$$"
  jq -cn \
    --arg run_id "$run_id" \
    --argjson pid "$$" \
    --arg process_start "$(process_start_identity "$$")" \
    --argjson acquired_at_epoch "$now" \
    --argjson expires_at_epoch "$expires" \
    '{run_id:$run_id,pid:$pid,process_start:$process_start,acquired_at_epoch:$acquired_at_epoch,expires_at_epoch:$expires_at_epoch}' >"$owner_tmp"
  chmod 600 "$owner_tmp"
  mv "$owner_tmp" "$owner_file"
  release_lease_transition
  trap - EXIT HUP INT TERM
}

release_lease() {
  local lane="$1" run_id="$2" lease_dir owner_file owner_run owner_pid
  [[ -z "${relay_port:-}" ]] || clear_lane_activity "http://127.0.0.1:$relay_port" "$run_id"
  lease_dir="$leases_root/$lane.lock"
  owner_file="$lease_dir/owner.json"
  [[ -d "$lease_dir" && ! -L "$lease_dir" && -f "$owner_file" && ! -L "$owner_file" ]] || return 0
  owner_run="$(jq -r '.run_id // empty' "$owner_file" 2>/dev/null)"
  owner_pid="$(jq -r '.pid // 0' "$owner_file" 2>/dev/null)"
  [[ "$owner_run" == "$run_id" && "$owner_pid" == "$$" ]] || return 0
  rm -f "$owner_file"
  rmdir "$lease_dir" 2>/dev/null || true
}

lane_has_lease() {
  local lane="$1" lease_dir
  lease_dir="$leases_root/$lane.lock"
  [[ -e "$lease_dir" || -L "$lease_dir" ]]
}

current_process_owns_lease() {
  local lane="$1" run_id="$2" lease_dir owner_file
  lease_dir="$leases_root/$lane.lock"
  owner_file="$lease_dir/owner.json"
  [[ -d "$lease_dir" && ! -L "$lease_dir" && -f "$owner_file" && ! -L "$owner_file" ]] ||
    return 1
  jq -e --arg run_id "$run_id" --argjson pid "$$" \
    '.run_id == $run_id and .pid == $pid' "$owner_file" >/dev/null 2>&1
}

prepare_handoffs_root() {
  local run_id="$1"
  if [[ -e "$handoffs_root" || -L "$handoffs_root" ]]; then
    [[ -d "$handoffs_root" && ! -L "$handoffs_root" ]] ||
      emit_error "$EXIT_DRIFT" 'handoff_state_unsafe' "$run_id" false \
        'the attended-login handoff root is not a safe directory' \
        'Inspect the private browser-lanes handoff root before retrying.'
  else
    mkdir "$handoffs_root" 2>/dev/null ||
      emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" true \
        'the attended-login handoff root could not be created' \
        'Repair the private browser-lanes state directory, then retry.'
  fi
  chmod 700 "$handoffs_root" ||
    emit_error "$EXIT_DRIFT" 'handoff_state_permissions' "$run_id" false \
      'the attended-login handoff root could not be made private' \
      'Repair the private browser-lanes state directory, then retry.'
}

handoff_paths() {
  local lane="$1"
  handoff_dir="$handoffs_root/$lane.handoff"
  handoff_record="$handoff_dir/handoff.json"
}

read_handoff_state() {
  local lane="$1" lane_value="$2" run_id="$3" now opened window expires entry_count profile_directory_sha256
  handoff_paths "$lane"
  handoff_state='absent'
  handoff_data="$(jq -cn --arg lane "$lane" '{lane:$lane,state:"absent"}')"
  if [[ ! -e "$handoff_dir" && ! -L "$handoff_dir" ]]; then
    return 0
  fi
  [[ -d "$handoff_dir" && ! -L "$handoff_dir" ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unsafe' "$run_id" false \
      "the attended-login handoff state is unsafe: $lane" \
      'Inspect the exact handoff state path before retrying.'
  [[ "$(private_mode "$handoff_dir")" == '700' ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_permissions' "$run_id" false \
      "the attended-login handoff directory is not private: $lane" \
      'Repair the handoff directory to mode 700 before retrying.'
  [[ -f "$handoff_record" && ! -L "$handoff_record" ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unsafe' "$run_id" false \
      "the attended-login handoff record is missing or unsafe: $lane" \
      'Inspect the exact handoff state path before retrying.'
  [[ "$(private_mode "$handoff_record")" == '600' ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_permissions' "$run_id" false \
      "the attended-login handoff record is not private: $lane" \
      'Repair the handoff record to mode 600 before retrying.'
  entry_count="$(find "$handoff_dir" -mindepth 1 -maxdepth 1 -print 2>/dev/null | wc -l | tr -d ' ')"
  [[ "$entry_count" == '1' ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unexpected_entry' "$run_id" false \
      "the attended-login handoff directory has unexpected entries: $lane" \
      'Inspect the exact handoff state path before retrying.'
  profile_directory_sha256="$(printf '%s' "$(jq -r '.profile_directory' <<<"$lane_value")" | shasum -a 256 | awk '{print $1}')"
  jq -e \
    --argjson schema "$SCHEMA_VERSION" \
    --arg lane "$lane" \
    --arg role "$(jq -r '.account_role' <<<"$lane_value")" \
    --arg profile_directory_sha256 "$profile_directory_sha256" \
    --argjson max_window "$MAX_HANDOFF_WINDOW_SECONDS" '
      ((keys == ["account_role","lane","nonce_sha256","opened_at_epoch","schema_version","site_origin","task_ref","window_seconds"]) or
       (keys == ["account_role","lane","nonce_sha256","opened_at_epoch","profile_directory_sha256","schema_version","site_origin","start_mode","task_ref","window_seconds"])) and
      .schema_version == $schema and
      .lane == $lane and
      .account_role == $role and
      ((.profile_directory_sha256 // $profile_directory_sha256) == $profile_directory_sha256) and
      (.task_ref | type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")) and
      (.site_origin | type == "string" and test("^https?://[^/?#[:space:]@]+$")) and
      ((.start_mode // "admitted") | IN("admitted","pre_admission")) and
      (.opened_at_epoch | type == "number" and floor == . and . >= 1) and
      (.window_seconds | type == "number" and floor == . and . >= 1 and . <= $max_window) and
      (.nonce_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
    ' "$handoff_record" >/dev/null 2>&1 ||
    emit_error "$EXIT_DRIFT" 'handoff_state_invalid' "$run_id" false \
      "the attended-login handoff record failed validation: $lane" \
      'Inspect the exact handoff record before retrying.'

  now="$(date +%s)"
  opened="$(jq -r '.opened_at_epoch' "$handoff_record")"
  window="$(jq -r '.window_seconds' "$handoff_record")"
  expires=$((opened + window))
  if [[ "$now" -ge "$expires" ]]; then
    handoff_state='stale'
  else
    handoff_state='open'
  fi
  handoff_data="$(jq -cn \
    --arg lane "$lane" \
    --arg task_ref "$(jq -r '.task_ref' "$handoff_record")" \
    --arg site_origin "$(jq -r '.site_origin' "$handoff_record")" \
    --arg start_mode "$(jq -r '.start_mode // "admitted"' "$handoff_record")" \
    --arg state "$handoff_state" \
    --argjson opened_at_epoch "$opened" \
    --argjson window_seconds "$window" \
    --argjson expires_at_epoch "$expires" \
    '{lane:$lane,task_ref:$task_ref,site_origin:$site_origin,start_mode:$start_mode,
      state:$state,opened_at_epoch:$opened_at_epoch,window_seconds:$window_seconds,
      expires_at_epoch:$expires_at_epoch}')"
}

refuse_while_handoff() {
  local lane="$1" lane_value="$2" run_id="$3"
  read_handoff_state "$lane" "$lane_value" "$run_id"
  case "$handoff_state" in
    absent) return 0 ;;
    open)
      emit_error "$EXIT_HANDOFF_OPEN" 'handoff_open' "$run_id" false \
        "the lane is reserved for attended login: $lane" \
        'Wait for the human to finish, then resume or release the handoff with its token.' "$handoff_data" ;;
    stale)
      emit_error "$EXIT_HANDOFF_STALE" 'handoff_stale' "$run_id" false \
        "the lane has a stale attended-login handoff: $lane" \
        'Ask the human to resume or release the handoff with its token; time never restores access.' "$handoff_data" ;;
  esac
}

require_handoff_present() {
  local lane="$1" lane_value="$2" run_id="$3"
  read_handoff_state "$lane" "$lane_value" "$run_id"
  [[ "$handoff_state" != 'absent' ]] ||
    emit_error "$EXIT_HANDOFF_TOKEN_INVALID" 'handoff_absent' "$run_id" false \
      "the lane has no attended-login handoff: $lane" \
      "Open a handoff before trying to resume or release it."
}

verify_handoff_nonce() {
  local nonce_file="$1" run_id="$2" expected_hash actual_hash
  actual_hash="$(handoff_file_io hash "$nonce_file")" ||
    emit_error "$EXIT_HANDOFF_TOKEN_INVALID" 'handoff_token_invalid' "$run_id" false \
      'the attended-login token file is missing, unsafe, or invalid' \
      'Use the owner-only regular token file created by --nonce-output, or preview handoff recover if it is lost.'
  expected_hash="$(jq -r '.nonce_sha256' "$handoff_record")"
  [[ "$actual_hash" == "$expected_hash" ]] ||
    emit_error "$EXIT_HANDOFF_TOKEN_INVALID" 'handoff_token_invalid' "$run_id" false \
      'the attended-login handoff token is invalid' \
      'Use the token file created for this reservation, or preview handoff recover if it is lost.'
}

handoff_file_io() {
  python3 "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/browser-lane-handoff.py" "$@" 2>/dev/null
}

create_handoff_nonce() {
  local path="$1" run_id="$2"
  nonce_hash="$(handoff_file_io create "$path")" ||
    emit_error "$EXIT_DRIFT" 'handoff_token_output_unsafe' "$run_id" false \
      'the private token output could not be created; no reservation or browser opening was started' \
      'Choose a new absolute filename inside an existing owner-only mode-700 directory without symlinks. Never reuse an existing token file.'
}

origin_from_page_url() {
  jq -Rer '
    capture("^(?<scheme>https?)://(?<authority>[^/?#[:space:]]+)") as $parts
    | select(($parts.authority | contains("@")) | not)
    | "\($parts.scheme | ascii_downcase)://\($parts.authority | ascii_downcase)"
  ' <<<"$1" 2>/dev/null
}

emit_open_success() {
  local lane="$1" lane_value="$2" json="$3" run_id="$4" data
  data="$(jq -cn \
    --arg lane "$lane" \
    --arg tab "$profile_open_tab" \
    --arg profile_display_name "$(jq -r '.profile_display_name' <<<"$lane_value")" '
      {command:"open",lane:$lane,profile_display_name:$profile_display_name,
       opening:{dispatch:"accepted",verification:(if $tab == "reused" then "exact_url_observed" else "not_observed" end),focus:(if $tab == "reused" then "focused" else "requested" end),tab:$tab},
       authentication:{state:"not_checked"},
       automation:{readiness:"not_checked",admission:"unchanged"},
       retry_safe:false}')"
  if [[ "$json" == 'true' ]]; then
    jq -cn --arg run_id "$run_id" --argjson data "$data" \
      '{status:"ok",run_id:$run_id,data:$data}'
  else
    jq -r '
      "lane=\(.lane) profile=\(.profile_display_name) opening=\(if .opening.tab == "reused" then "reused" else "dispatched" end) tab=\(.opening.tab) verification=\(.opening.verification) authentication=\(.authentication.state) automation=\(.automation.readiness)"
    ' <<<"$data"
  fi
}

profile_open_directory=''
profile_open_chrome_root=''
profile_open_bin=''
profile_open_status=''
profile_open_tab='new_requested'
profile_open_display=''
profile_open_helper=''
profile_open_problem='native_check_unavailable'

prepare_profile_open() {
  local lane="$1" lane_value="$2" account_role="$3" run_id="$4"
  local expected_role profile_count
  expected_role="$(jq -r '.account_role' <<<"$lane_value")"
  [[ "$account_role" == "$expected_role" ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
      "selected account role does not match lane $lane" \
      "Use the role reported by '$PROGRAM list'."
  [[ "$(jq -r '.provisioned' <<<"$lane_value")" == 'true' ]] ||
    emit_error "$EXIT_NOT_PROVISIONED" 'lane_not_provisioned' "$run_id" false \
      "lane is declared but not provisioned: $lane" \
      'Provision the intended existing Chrome profile, then update the private registry.'
  profile_open_directory="$(jq -r '.profile_directory' <<<"$lane_value")"
  profile_count="$(jq -r --arg profile "$profile_open_directory" \
    '[.lanes[] | select(.provisioned == true and .profile_directory == $profile)] | length' "$registry")"
  [[ "$profile_count" == '1' ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'profile_mapping_ambiguous' "$run_id" false \
      "more than one lane declares the selected Chrome profile" \
      'Repair the lane registry so each provisioned profile directory has one owner.'
  profile_identity_ok "$lane_value" ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'profile_mismatch' "$run_id" false \
      "lane profile identity does not match its registry entry: $lane" \
      'Repair the exact profile directory or display-name mapping, then retry.'

  profile_open_bin="${BROWSER_LANE_OPEN_BIN:-/usr/bin/open}"
  [[ "$profile_open_bin" == /* && -x "$profile_open_bin" && -f "$profile_open_bin" && ! -L "$profile_open_bin" ]] ||
    emit_error "$EXIT_INVALID_REGISTRY" 'browser_opener_missing' "$run_id" true \
      'the configured macOS browser opener is unavailable or unsafe' \
      'Restore the system open command, then retry.'
  profile_open_chrome_root="$(jq -r '.chrome_user_data_dir' "$registry")"
  profile_open_display="$(jq -r '.profile_display_name' <<<"$lane_value")"
  # Native window metadata identifies a display name, not a profile directory.
  # A duplicate local name cannot prove which directory owns the visible tab.
  [[ "$(jq -r --arg name "$profile_open_display" \
    '[.profile.info_cache[] | select(.name == $name)] | length' \
    "$profile_open_chrome_root/Local State")" == '1' ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'profile_mapping_ambiguous' "$run_id" false \
      'the native profile display name does not identify one local Chrome profile' \
      'Give the intended Chrome profile a unique display name and reconcile its lane registry before retrying.'
  require_command python3 "$run_id"
  profile_open_helper="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/browser-lane-open.py"
  [[ -f "$profile_open_helper" && ! -L "$profile_open_helper" &&
     -f "${profile_open_helper%.py}.js" && ! -L "${profile_open_helper%.py}.js" ]] ||
    emit_error "$EXIT_INVALID_REGISTRY" 'browser_opener_missing' "$run_id" true \
      'the native tab-reuse helper is unavailable or unsafe' \
      'Restore the browser-lane executable and its adjacent helpers from the same checkout.'
}

dispatch_profile_page() {
  local page_url="$1" native_result native_status
  profile_open_tab='unknown'
  profile_open_problem='native_check_unavailable'
  set +e
  native_result="$(python3 "$profile_open_helper" "$profile_open_display" "$page_url" 2>/dev/null)"
  native_status=$?
  set -e
  # The adjacent transport returns only fixed, secret-neutral reason codes.
  # Keep the host cause available without forwarding any native error text.
  case "$(jq -r '.reason // empty' <<<"$native_result" 2>/dev/null)" in
    exact_tab_ambiguous|profile_window_unavailable|profile_window_ambiguous|profile_window_changed|tab_inventory_unavailable|tab_inventory_changed|tab_selection_unavailable|tab_url_unavailable|native_access_unavailable|native_deadline|native_helper_unavailable|native_helper_failed|native_helper_timeout|native_helper_interrupted|invalid_native_result|chrome_process_ambiguous)
      profile_open_problem="$(jq -r .reason <<<"$native_result")" ;;
  esac
  profile_open_status=1
  [[ "$native_status" == '0' ]] || return 0
  if jq -e '.state == "reused"' <<<"$native_result" >/dev/null 2>&1; then
    profile_open_tab='reused'
    profile_open_status=0
    return 0
  fi
  jq -e '.state == "absent"' <<<"$native_result" >/dev/null 2>&1 || return 0
  profile_open_tab='new_requested'
  profile_open_problem='launcher_dispatch_uncertain'
  set +e
  "$profile_open_bin" -n -b com.google.Chrome --args \
    "--user-data-dir=$profile_open_chrome_root" \
    "--profile-directory=$profile_open_directory" \
    --new-tab "$page_url" >/dev/null 2>&1
  profile_open_status=$?
  set -e
}

emit_profile_opening_uncertain() {
  local lane="$1" run_id="$2"
  local error_data
  trap - HUP INT TERM
    error_data="$(jq -cn --arg lane "$lane" --arg cause "$profile_open_problem" '
      {command:"open",lane:$lane,
       preparation_failure:$cause,
       opening:{dispatch:"uncertain",verification:"not_observed",focus:"unknown",tab:"unknown"},
       authentication:{state:"not_checked"},
       automation:{readiness:"not_checked",admission:"unchanged"}}')"
    emit_error "$EXIT_BROWSER_OPENING_UNCERTAIN" 'browser_opening_uncertain' "$run_id" false \
      'Chrome tab preparation did not complete; the native check or opening dispatch was uncertain' \
      'Inspect the visible profile and duplicate tabs, and verify macOS Accessibility and Automation permissions before retrying. No new tab is requested after an uncertain reuse check.' \
      "$error_data"
}

open_profile_page() {
  local lane="$1" lane_value="$2" account_role="$3" page_url="$4" json="$5" run_id="$6"
  prepare_profile_open "$lane" "$lane_value" "$account_role" "$run_id"
  acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
  trap 'release_lease "$lane" "$run_id"' EXIT
  # Bash waits for the foreground native transport to retire before handling
  # this signal. Exit here so cancellation can never fall through to creation.
  trap 'profile_open_problem=native_helper_interrupted; emit_profile_opening_uncertain "$lane" "$run_id"' HUP INT TERM
  refuse_while_handoff "$lane" "$lane_value" "$run_id"
  dispatch_profile_page "$page_url"
  [[ "$profile_open_status" == '0' ]] || emit_profile_opening_uncertain "$lane" "$run_id"
  trap 'release_lease "$lane" "$run_id"' HUP INT TERM
  emit_open_success "$lane" "$lane_value" "$json" "$run_id"
  exit 0
}

require_single_handoff_page() {
  local lane_value="$1" run_id="$2" visible_count
  read_admitted_pages "$lane_value" '' "$run_id"
  visible_count="$(jq -r '.visible_page_count' <<<"$page_access_data")"
  [[ "$visible_count" == '1' ]] ||
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_page_ambiguous' "$run_id" true \
      "an attended-login handoff requires exactly one admitted page; observed $visible_count" \
      'Ask the human to admit only the intended task tab, then retry.' "$page_access_data"
  [[ "$resolved_single_page_selected" == 'true' ]] ||
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_page_not_selected' "$run_id" true \
      'the attended-login handoff page is not the relay selected page' \
      'Ask the human to select the intended task tab in the exact profile, then retry.' "$page_access_data"
  handoff_observed_origin="$(origin_from_page_url "$resolved_single_page_url")" ||
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_origin_unusable' "$run_id" false \
      'the attended-login handoff page does not have a safe HTTP origin' \
      'Use an ordinary HTTP or HTTPS task page without embedded user information.' "$page_access_data"
}

require_handoff_continuation_page() {
  local run_id="$1" readiness admitted_count match_count target_selected
  decode_page_target_facts
  readiness="$page_target_readiness"
  admitted_count="$page_target_admitted_count"
  match_count="$page_target_match_count"
  target_selected="$page_target_selected"
  if [[ "$readiness" == 'target_absent' ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_grant_required' "$run_id" true \
      "the exact task page is not admitted (matched 0 of $admitted_count admitted pages)" \
      "In the declared Chrome profile, focus the intended exact task tab and click OpenClaw's Allow on this tab once; leave unrelated admitted pages unchanged, then retry." "$page_access_data"
  fi
  if [[ "$match_count" -gt 1 ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_page_ambiguous' "$run_id" true \
      "continuation requires one admitted page matching the exact task URL (matched $match_count of $admitted_count admitted pages)" \
      'Select one intended task tab with a unique ordinary URL, then retry.' "$page_access_data"
  fi
  if [[ "$target_selected" != 'true' ]]; then
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_page_not_selected' "$run_id" true \
      'the exact task page is admitted but is not the relay selected page' \
      'Select the intended task tab in the declared Chrome profile, then retry.' "$page_access_data"
  fi
}

write_handoff_record() {
  local lane="$1" lane_value="$2" task_ref="$3" window="$4" nonce_hash="$5" start_mode="$6" run_id="$7"
  local record_tmp
  handoff_paths "$lane"
  if ! mkdir "$handoff_dir" 2>/dev/null; then
    read_handoff_state "$lane" "$lane_value" "$run_id"
    refuse_while_handoff "$lane" "$lane_value" "$run_id"
    emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" true \
      "the attended-login handoff state could not be created: $lane" \
      'Inspect the private handoff state root, then retry.'
  fi
  record_tmp="$handoff_dir/handoff.json.$$"
  if ! chmod 700 "$handoff_dir" ||
    ! jq -cn \
      --argjson schema "$SCHEMA_VERSION" \
      --arg lane "$lane" \
      --arg account_role "$(jq -r '.account_role' <<<"$lane_value")" \
      --arg task_ref "$task_ref" \
      --arg site_origin "$handoff_observed_origin" \
      --arg start_mode "$start_mode" \
      --arg profile_directory_sha256 "$(printf '%s' "$(jq -r '.profile_directory' <<<"$lane_value")" | shasum -a 256 | awk '{print $1}')" \
      --argjson opened_at_epoch "$(date +%s)" \
      --argjson window_seconds "$window" \
      --arg nonce_sha256 "$nonce_hash" \
      '{schema_version:$schema,lane:$lane,account_role:$account_role,task_ref:$task_ref,
        profile_directory_sha256:$profile_directory_sha256,
        start_mode:$start_mode,
        site_origin:$site_origin,opened_at_epoch:$opened_at_epoch,
        window_seconds:$window_seconds,nonce_sha256:$nonce_sha256}' >"$record_tmp" ||
    ! chmod 600 "$record_tmp" ||
    ! mv "$record_tmp" "$handoff_record"; then
    rm -f "$record_tmp" "$handoff_record"
    rmdir "$handoff_dir" 2>/dev/null || true
    emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" true \
      "the attended-login handoff record could not be written: $lane" \
      'Repair the private browser-lanes state directory, then retry.'
  fi
}

interrupt_handoff_publication() {
  # Only this lease owner can be publishing. Remove its unpublished temporary
  # record; a completed reservation always stays recoverable with the file.
  if [[ -n "${handoff_dir:-}" && -d "$handoff_dir" && ! -L "$handoff_dir" && ! -e "$handoff_record" && ! -L "$handoff_record" ]]; then
    rm -f "$handoff_dir/handoff.json.$$"
    rmdir "$handoff_dir" 2>/dev/null || true
  fi
  emit_error 130 'handoff_publication_interrupted' "$run_id" false \
    'the reservation publication was interrupted; the private token file is retained if it was created' \
    'Read handoff status before retrying. Resume or release a present reservation with --nonce-file; otherwise choose a new output filename.'
}

remove_handoff_record() {
  local run_id="$1"
  rm -f "$handoff_record" ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" false \
      'the attended-login handoff record could not be removed' \
      'Inspect the exact private handoff state path before retrying.'
  rmdir "$handoff_dir" 2>/dev/null ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unexpected_entry' "$run_id" false \
      'the attended-login handoff directory could not be removed cleanly' \
      'Inspect the exact private handoff state path before retrying.'
}

complete_handoff_record() {
  local lane="$1" run_id="$2" completion_record
  handoff_completion_dir="$handoffs_root/.${lane}.handoff-complete.$$"
  [[ ! -e "$handoff_completion_dir" && ! -L "$handoff_completion_dir" ]] ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unexpected_entry' "$run_id" false \
      'the attended-login completion target already exists' \
      'Inspect the private handoff state root before retrying.'
  mv "$handoff_dir" "$handoff_completion_dir" ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" false \
      'the attended-login reservation could not enter its completed state' \
      'Inspect handoff status before retrying or continuing.'
  completion_record="$handoff_completion_dir/handoff.json"
  if ! rm -f "$completion_record" || ! rmdir "$handoff_completion_dir"; then
    emit_error "$EXIT_DRIFT" 'handoff_state_unwritable' "$run_id" false \
      'the completed attended-login state could not be removed cleanly' \
      'Inspect the private handoff state root; the exact lane reservation is no longer active.'
  fi
  handoff_completion_dir=''
}

emit_handoff_success() {
  local action="$1" json="$2" run_id="$3" data="$4"
  data="$(jq -c --arg command "handoff.$action" '. + {command:$command}' <<<"$data")"
  if [[ "$json" == 'true' ]]; then
    jq -cn --arg run_id "$run_id" --argjson data "$data" \
      '{status:"ok",run_id:$run_id,data:$data}'
  else
    jq -r '
      "lane=\(.lane) task_ref=\(.task_ref) site_origin=\(.site_origin) state=\(.state) opened_at_epoch=\(.opened_at_epoch) window_seconds=\(.window_seconds)"
    ' <<<"$data"
  fi
}

pre_admission_handoff_data() {
  local dispatch="$1"
  jq -c --arg dispatch "$dispatch" --arg tab "$profile_open_tab" --arg cause "$profile_open_problem" '
    . + {
      opening:{dispatch:$dispatch,verification:(if $dispatch == "accepted" and $tab == "reused" then "exact_url_observed" else "not_observed" end),focus:(if $dispatch != "accepted" then "unknown" elif $tab == "reused" then "focused" else "requested" end),tab:(if $dispatch == "accepted" then $tab else "unknown" end)},
      authentication:{state:"waiting_for_human"},
      automation:{readiness:"blocked_by_handoff",admission:"not_requested"},
      retry_safe:false
    } + (if $dispatch == "uncertain" then {preparation_failure:$cause} else {} end)
  ' <<<"$handoff_data"
}

emit_pre_admission_opening_uncertain() {
  local run_id="$1" error_data
  trap - HUP INT TERM
  error_data="$(pre_admission_handoff_data uncertain)"
  emit_error "$EXIT_BROWSER_OPENING_UNCERTAIN" 'browser_opening_uncertain' "$run_id" false \
    'Chrome tab preparation did not complete; the attended-login reservation remains active' \
    'Do not retry the opening. Inspect the visible profile, then use --nonce-file with the retained private token file to resume or release this reservation.' \
    "$error_data"
}

open_handoff() {
  local lane="$1" lane_value="$2" account_role="$3" task_ref="$4" window="$5" page_url="$6" json="$7" run_id="$8"
  local nonce_output="$9" expected_role nonce_hash success_data
  expected_role="$(jq -r '.account_role' <<<"$lane_value")"
  [[ "$account_role" == "$expected_role" ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
      "selected account role does not match lane $lane" \
      "Use the role reported by '$PROGRAM list'."
  require_command python3 "$run_id"

  if [[ -n "$page_url" ]]; then
    prepare_profile_open "$lane" "$lane_value" "$account_role" "$run_id"
    acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
    trap 'release_lease "$lane" "$run_id"' EXIT
    trap interrupt_handoff_publication HUP INT TERM
    refuse_while_handoff "$lane" "$lane_value" "$run_id"
    handoff_observed_origin="$(origin_from_page_url "$page_url")" ||
      emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_origin_unusable' "$run_id" false \
        'the intended application page does not have a safe HTTP origin' \
        'Use an ordinary HTTP or HTTPS application page without embedded user information.'
    create_handoff_nonce "$nonce_output" "$run_id"
    write_handoff_record "$lane" "$lane_value" "$task_ref" "$window" "$nonce_hash" pre_admission "$run_id"
    trap 'emit_pre_admission_opening_uncertain "$run_id"' HUP INT TERM
    read_handoff_state "$lane" "$lane_value" "$run_id"
    dispatch_profile_page "$page_url"
    [[ "$profile_open_status" == '0' ]] || emit_pre_admission_opening_uncertain "$run_id"
    trap 'release_lease "$lane" "$run_id"' HUP INT TERM
    success_data="$(pre_admission_handoff_data accepted)"
    emit_handoff_success open "$json" "$run_id" "$success_data"
    exit 0
  fi

  require_command openclaw "$run_id"
  require_command "$mcporter_bin" "$run_id"
  acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
  trap 'cleanup_page_list_file; release_lease "$lane" "$run_id"' EXIT
  trap interrupt_handoff_publication HUP INT TERM
  refuse_while_handoff "$lane" "$lane_value" "$run_id"
  route_preflight "$lane" "$lane_value" "$run_id"
  require_single_handoff_page "$lane_value" "$run_id"
  create_handoff_nonce "$nonce_output" "$run_id"
  write_handoff_record "$lane" "$lane_value" "$task_ref" "$window" "$nonce_hash" admitted "$run_id"
  read_handoff_state "$lane" "$lane_value" "$run_id"
  publish_handoff_activity waiting
  emit_handoff_success open "$json" "$run_id" "$handoff_data"
  exit 0
}

status_handoff() {
  local lane="$1" lane_value="$2" json="$3" run_id="$4"
  read_handoff_state "$lane" "$lane_value" "$run_id"
  if [[ "$handoff_state" == 'absent' ]]; then
    if [[ "$json" == 'true' ]]; then
      jq -cn --arg run_id "$run_id" --arg lane "$lane" \
        '{status:"ok",run_id:$run_id,data:{command:"handoff.status",lane:$lane,state:"absent"}}'
    else
      printf 'lane=%s state=absent\n' "$lane"
    fi
    return 0
  fi
  emit_handoff_success status "$json" "$run_id" "$handoff_data"
}

recover_handoff() {
  local lane="$1" lane_value="$2" json="$3" run_id="$4" reservation="$5" acknowledgement="$6" execute="$7"
  local fingerprint data
  require_command python3 "$run_id"
  # Preview reads only. Execute serializes the fresh observation with every
  # other compliant lane command; a previously observed record grants nothing.
  if [[ "$execute" == 'true' ]]; then
    acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
    trap 'release_lease "$lane" "$run_id"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
  fi
  require_handoff_present "$lane" "$lane_value" "$run_id"
  fingerprint="$(handoff_file_io fingerprint "$handoff_record")" ||
    emit_error "$EXIT_DRIFT" 'handoff_state_unsafe' "$run_id" false \
      'the reservation could not be fingerprinted safely' \
      'Inspect the private reservation path and its ownership before retrying.'
  if [[ "$execute" == 'true' ]]; then
    [[ "$fingerprint" == "$reservation" && "$(jq -r '.task_ref' "$handoff_record")" == "$acknowledgement" ]] ||
      emit_error "$EXIT_HANDOFF_TOKEN_INVALID" 'handoff_recovery_changed' "$run_id" false \
        'the reservation fingerprint or acknowledged task does not match' \
        'Preview handoff recover again and obtain operator acknowledgement for the current exact reservation.'
    data="$(handoff_file_io recover "$handoff_record" "$reservation" "$acknowledgement" "$state_root/handoff-recovery" "$run_id")" ||
      emit_error "$EXIT_DRIFT" 'handoff_recovery_incomplete' "$run_id" false \
        'the recovery or its required audit receipt could not be completed; removal may have happened' \
        'Read handoff status and inspect the private handoff-recovery receipts before any retry. Never assume the reservation is unchanged.'
  else
    data="$(jq -c --arg fingerprint "$fingerprint" \
      '. + {state:"preview",reservation_sha256:$fingerprint,operator_acknowledgement_required:true}' <<<"$handoff_data")"
  fi
  if [[ "$json" == 'true' ]]; then
    emit_handoff_success recover true "$run_id" "$data"
  else
    jq -r '"lane=\(.lane) task_ref=\(.task_ref) state=\(.state) reservation_sha256=\(.reservation_sha256)"' <<<"$data"
  fi
  exit 0
}

interrupt_handoff_resume() {
  local lane="$1" run_id="$2" reservation_retained='false'
  trap - EXIT HUP INT TERM
  if [[ -d "$handoff_dir" && ! -L "$handoff_dir" && -f "$handoff_record" && ! -L "$handoff_record" ]]; then
    reservation_retained='true'
  fi
  cleanup_page_list_file
  release_lease "$lane" "$run_id"
  if [[ "$reservation_retained" == 'true' ]]; then
    emit_error 130 'handoff_resume_interrupted' "$run_id" true \
      'the attended-login continuation was interrupted before exact-page proof completed' \
      'Retry the same resume command with the retained nonce and exact task URL.'
  fi
  if [[ -n "${handoff_completion_dir:-}" && -d "$handoff_completion_dir" && ! -L "$handoff_completion_dir" ]]; then
    rm -f "$handoff_completion_dir/handoff.json" 2>/dev/null || true
    rmdir "$handoff_completion_dir" 2>/dev/null || true
  fi
  emit_error 130 'handoff_resume_completion_interrupted' "$run_id" false \
    'exact-page proof completed, but continuation output was interrupted after the reservation was consumed' \
    'Check handoff status. If it is absent, continue with the intended adapter; do not reuse the nonce.'
}

resume_handoff() {
  local lane="$1" lane_value="$2" account_role="$3" nonce="$4" page_url="$5" json="$6" run_id="$7"
  local expected_role recorded_origin recorded_start_mode requested_origin resumed_data
  expected_role="$(jq -r '.account_role' <<<"$lane_value")"
  [[ "$account_role" == "$expected_role" ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
      "selected account role does not match lane $lane" \
      "Use the role reported by '$PROGRAM list'."
  require_command openclaw "$run_id"
  require_command "$mcporter_bin" "$run_id"
  acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
  trap 'cleanup_page_list_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
  require_handoff_present "$lane" "$lane_value" "$run_id"
  verify_handoff_nonce "$nonce" "$run_id"
  trap 'interrupt_handoff_resume "$lane" "$run_id"' HUP INT TERM
  recorded_origin="$(jq -r '.site_origin' "$handoff_record")"
  recorded_start_mode="$(jq -r '.start_mode // "admitted"' "$handoff_record")"
  requested_origin="$(origin_from_page_url "$page_url")" ||
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_destination_unusable' "$run_id" false \
      'the continuation page does not have a safe HTTP origin' \
      'Use the exact ordinary HTTP or HTTPS task-page URL without embedded user information.'
  [[ "$requested_origin" == "$recorded_origin" ]] ||
    emit_error "$EXIT_PAGE_UNRESOLVED" 'handoff_destination_mismatch' "$run_id" false \
      'the continuation page does not match the reserved application origin' \
      'Resume with the exact intended task page from the reserved application, or release this handoff.'
  route_preflight "$lane" "$lane_value" "$run_id"
  read_admitted_pages "$lane_value" "$page_url" "$run_id"
  require_handoff_continuation_page "$run_id"
  resumed_data="$(jq -c \
    '.state="resumed" | . + {continuation:{page:"exact_selected",access_mode:"selected",permission:"reused"}}' \
    <<<"$handoff_data")"
  local activity_identity activity_port
  activity_identity="$(activity_run_id "$(jq -r '[.task_ref, (.opened_at_epoch | tostring)] | join(":")' "$handoff_record")")"
  activity_port="$(jq -r .relay_port <<<"$lane_value")"
  complete_handoff_record "$lane" "$run_id"
  trap 'cleanup_page_list_file; release_lease "$lane" "$run_id"' HUP INT TERM
  if [[ "$recorded_start_mode" == 'admitted' ]]; then
    "$mcporter_bin" chrome-relay activity resolved --relay-url "http://127.0.0.1:$activity_port" --run-id "$activity_identity" >/dev/null 2>&1 || true
  fi
  emit_handoff_success resume "$json" "$run_id" "$resumed_data"
  exit 0
}

release_handoff() {
  local lane="$1" lane_value="$2" nonce="$3" json="$4" run_id="$5" released_data recorded_start_mode
  acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
  trap 'release_lease "$lane" "$run_id"' EXIT HUP INT TERM
  require_handoff_present "$lane" "$lane_value" "$run_id"
  verify_handoff_nonce "$nonce" "$run_id"
  recorded_start_mode="$(jq -r '.start_mode // "admitted"' "$handoff_record")"
  released_data="$(jq -c '.state="released"' <<<"$handoff_data")"
  local activity_identity activity_port
  activity_identity="$(activity_run_id "$(jq -r '[.task_ref, (.opened_at_epoch | tostring)] | join(":")' "$handoff_record")")"
  activity_port="$(jq -r .relay_port <<<"$lane_value")"
  remove_handoff_record "$run_id"
  if [[ "$recorded_start_mode" == 'admitted' ]]; then
    "$mcporter_bin" chrome-relay activity resolved --relay-url "http://127.0.0.1:$activity_port" --run-id "$activity_identity" >/dev/null 2>&1 || true
  fi
  emit_handoff_success release "$json" "$run_id" "$released_data"
  exit 0
}

handoff_dir=''
handoff_record=''
handoff_completion_dir=''
handoff_state='absent'
handoff_data='null'
handoff_observed_origin=''

validate_snapshot_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]
}

snapshot_sha256() {
  shasum -a 256 "$1" | awk '{print $1}'
}

snapshot_paths() {
  local lane="$1" snapshot_id="$2"
  snapshot_dir="$recovery_root/$lane/$snapshot_id"
  snapshot_blueprint="$snapshot_dir/blueprint.json"
  snapshot_manifest="$snapshot_dir/manifest.json"
}

validate_snapshot_files() {
  local lane="$1" snapshot_id="$2" run_id="$3" expected_hash actual_hash entry_count
  validate_snapshot_id "$snapshot_id" ||
    emit_error "$EXIT_USAGE" 'invalid_snapshot_id' "$run_id" false \
      "snapshot id is invalid" "Use the snapshot id returned by recovery create."
  snapshot_paths "$lane" "$snapshot_id"
  [[ -d "$snapshot_dir" && ! -L "$snapshot_dir" ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_snapshot_missing' "$run_id" false \
      "recovery snapshot is missing or unsafe: $snapshot_id" \
      "Create a new snapshot before destructive profile work."
  [[ "$(private_mode "$snapshot_dir")" == '700' ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_snapshot_permissions' "$run_id" false \
      "recovery snapshot directory permissions are unsafe" \
      "Restrict the exact snapshot directory to mode 700."
  [[ -f "$snapshot_blueprint" && ! -L "$snapshot_blueprint" && -f "$snapshot_manifest" && ! -L "$snapshot_manifest" ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_snapshot_incomplete' "$run_id" false \
      "recovery snapshot files are incomplete or unsafe" \
      "Discard the exact snapshot and create a new one."
  [[ "$(private_mode "$snapshot_blueprint")" == '600' && "$(private_mode "$snapshot_manifest")" == '600' ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_snapshot_permissions' "$run_id" false \
      "recovery snapshot file permissions are unsafe" \
      "Restrict both snapshot files to mode 600."
  entry_count="$(find "$snapshot_dir" -mindepth 1 -maxdepth 1 -print | wc -l | tr -d ' ')"
  [[ "$entry_count" == '2' ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_snapshot_unexpected_entry' "$run_id" false \
      "recovery snapshot contains an unexpected entry" \
      "Inspect the private snapshot before retrying."
  jq -e \
    --arg lane "$lane" \
    --arg snapshot "$snapshot_id" '
      .schema_version == 1 and
      .lane == $lane and
      .snapshot_id == $snapshot and
      .authentication_state_included == false and
      (.created_at_epoch | type == "number") and
      (.expires_at_epoch | type == "number") and
      (.retention_days | type == "number") and
      (.deletion_owner | type == "string" and length > 0) and
      (.blueprint_file == "blueprint.json") and
      (.blueprint_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
    ' "$snapshot_manifest" >/dev/null 2>&1 ||
    emit_error "$EXIT_DRIFT" 'recovery_manifest_invalid' "$run_id" false \
      "recovery manifest is invalid" "Discard the exact snapshot and create a new one."
  jq -e \
    --arg lane "$lane" '
      .schema_version == 1 and
      .lane == $lane and
      .authentication_state_included == false and
      (.profile | type == "object") and
      (.relay | type == "object") and
      (.baseline | type == "object") and
      (.observed | type == "object")
    ' "$snapshot_blueprint" >/dev/null 2>&1 ||
    emit_error "$EXIT_DRIFT" 'recovery_blueprint_invalid' "$run_id" false \
      "recovery blueprint is invalid" "Discard the exact snapshot and create a new one."
  expected_hash="$(jq -r '.blueprint_sha256' "$snapshot_manifest")"
  actual_hash="$(snapshot_sha256 "$snapshot_blueprint")"
  [[ "$actual_hash" == "$expected_hash" ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_integrity_mismatch' "$run_id" false \
      "recovery blueprint integrity check failed" \
      "Do not use this snapshot; discard it and create a new one."
}

discard_recovery_temp_dir() {
  [[ -n "${recovery_temp_dir:-}" ]] || return 0
  rm -f "$recovery_temp_dir/blueprint.json" "$recovery_temp_dir/manifest.json"
  rmdir "$recovery_temp_dir" 2>/dev/null || true
}

create_recovery_snapshot() {
  local lane="$1" lane_value="$2" retention_days="$3" deletion_owner="$4" json="$5" run_id="$6"
  local now expires snapshot_id lane_root temp_dir profile_path preferences secure_preferences blueprint_hash
  local required_extensions allowed_extensions sync_expectations sync_account_shape selected_type_expectations
  local observed_autofill observed_sync observed_selected_types required_extensions_present sync_count
  [[ "$(jq -r '.provisioned' <<<"$lane_value")" == 'true' ]] ||
    emit_error "$EXIT_NOT_PROVISIONED" 'lane_not_provisioned' "$run_id" false \
      "lane is declared but not provisioned: $lane" \
      "Provision and verify the intended profile before creating recovery state."
  profile_identity_ok "$lane_value" ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'profile_mismatch' "$run_id" false \
      "lane profile identity does not match its registry entry: $lane" \
      "Repair the exact profile mapping before creating recovery state."
  current_process_owns_lease "$lane" "$run_id" ||
    emit_error "$EXIT_DRIFT" 'recovery_lease_missing' "$run_id" false \
      "recovery creation does not own the lane lease: $lane" \
      "Retry through the public browser-lane recovery command."

  # Every observed fragment is read before any directory exists, so a
  # malformed profile fails closed without leaving partial snapshot state.
  profile_path="$(profile_path_for "$(jq -r '.profile_directory' <<<"$lane_value")")"
  preferences="$profile_path/Preferences"
  secure_preferences="$profile_path/Secure Preferences"
  required_extensions="$(jq -c '.required_extensions' <<<"$lane_value")"
  allowed_extensions="$(jq -c '.allowed_extensions // []' <<<"$lane_value")"
  sync_expectations="$(jq -c '.sync_expectations' <<<"$lane_value")"
  sync_account_shape="$(jq -r '.account_shape' <<<"$sync_expectations")"

  observed_autofill="$(jq -c '{credentials_enable_service:.credentials_enable_service,autofill_profile_enabled:.autofill.profile_enabled,autofill_credit_card_enabled:.autofill.credit_card_enabled}' "$preferences" 2>/dev/null)" ||
    emit_error "$EXIT_DRIFT" 'recovery_baseline_unreadable' "$run_id" false \
      "profile Preferences file is missing or not valid JSON: $lane" \
      "Repair the lane profile, confirm with '$PROGRAM health --lane $lane', then retry."
  required_extensions_present="$(jq -c --argjson required "$required_extensions" '[ $required[] as $id | {id:$id,present:(.extensions.settings[$id] != null)} ]' "$secure_preferences" 2>/dev/null)" ||
    emit_error "$EXIT_DRIFT" 'recovery_baseline_unreadable' "$run_id" false \
      "profile Secure Preferences file is missing or not valid JSON: $lane" \
      "Repair the lane profile, confirm with '$PROGRAM health --lane $lane', then retry."
  sync_count="$(jq -r '.sync.selected_types_per_account // {} | length' "$preferences")"
  if [[ "$sync_account_shape" == 'absent' ]]; then
    [[ "$sync_count" == '0' ]] ||
      emit_error "$EXIT_DRIFT" 'recovery_sync_shape_drift' "$run_id" false \
        "profile Preferences contain an unexpected sync selection account: $lane" \
        "Repair the lane's sync baseline, confirm with '$PROGRAM health --lane $lane', then retry."
    observed_sync='{"account_shape":"absent"}'
  else
    [[ "$sync_count" == '1' ]] ||
      emit_error "$EXIT_DRIFT" 'recovery_sync_shape_drift' "$run_id" false \
        "profile Preferences do not hold exactly one sync selection account: $lane" \
        "Repair the lane's sync baseline, confirm with '$PROGRAM health --lane $lane', then retry."
    selected_type_expectations="$(jq -c '.selected_types' <<<"$sync_expectations")"
    observed_selected_types="$(jq -c --argjson expected "$selected_type_expectations" '.sync.selected_types_per_account | to_entries[0].value as $actual | $expected | with_entries(.value = (if ($actual | type) == "object" then $actual[.key] else null end))' "$preferences" 2>/dev/null)" ||
      emit_error "$EXIT_DRIFT" 'recovery_sync_shape_drift' "$run_id" false \
        "profile Preferences do not hold exactly one sync selection account: $lane" \
        "Repair the lane's sync baseline, confirm with '$PROGRAM health --lane $lane', then retry."
    observed_sync="$(jq -cn --argjson selected_types "$observed_selected_types" '{account_shape:"exactly-one",selected_types:$selected_types}')"
  fi

  now="$(date +%s)"
  expires=$((now + retention_days * 86400))
  snapshot_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  lane_root="$recovery_root/$lane"
  snapshot_paths "$lane" "$snapshot_id"
  temp_dir="$snapshot_dir.tmp"
  mkdir -p "$lane_root"
  chmod 700 "$recovery_root" "$lane_root"
  mkdir "$temp_dir"
  chmod 700 "$temp_dir"
  recovery_temp_dir="$temp_dir"
  trap 'discard_recovery_temp_dir; release_lease "$lane" "$run_id"' EXIT HUP INT TERM

  jq -cn \
    --arg lane "$lane" \
    --arg directory "$(jq -r '.profile_directory' <<<"$lane_value")" \
    --arg display_name "$(jq -r '.profile_display_name' <<<"$lane_value")" \
    --arg account_role "$(jq -r '.account_role' <<<"$lane_value")" \
    --argjson relay_port "$(jq -r '.relay_port' <<<"$lane_value")" \
    --arg access_mode "$(jq -r '.expected_access_mode' <<<"$lane_value")" \
    --arg download_directory "$(jq -r '.download_directory' <<<"$lane_value")" \
    --argjson required_extensions "$required_extensions" \
    --argjson allowed_extensions "$allowed_extensions" \
    --argjson autofill_expectations "$(jq -c '.chrome_autofill_expectations // {}' <<<"$lane_value")" \
    --argjson sync_expectations "$sync_expectations" \
    --argjson observed_autofill "$observed_autofill" \
    --argjson observed_sync "$observed_sync" \
    --argjson required_extensions_present "$required_extensions_present" '
      {
        schema_version:1,
        lane:$lane,
        authentication_state_included:false,
        profile:{directory:$directory,display_name:$display_name,account_role:$account_role},
        relay:{port:$relay_port,expected_access_mode:$access_mode},
        baseline:{download_directory:$download_directory,required_extensions:$required_extensions,allowed_extensions:$allowed_extensions,chrome_autofill_expectations:$autofill_expectations,sync_expectations:$sync_expectations},
        observed:{chrome_autofill:$observed_autofill,sync:$observed_sync,required_extensions:$required_extensions_present}
      }
    ' >"$temp_dir/blueprint.json"
  chmod 600 "$temp_dir/blueprint.json"
  blueprint_hash="$(snapshot_sha256 "$temp_dir/blueprint.json")"
  jq -cn \
    --arg lane "$lane" \
    --arg snapshot_id "$snapshot_id" \
    --argjson created_at_epoch "$now" \
    --argjson expires_at_epoch "$expires" \
    --argjson retention_days "$retention_days" \
    --arg deletion_owner "$deletion_owner" \
    --arg blueprint_sha256 "$blueprint_hash" '
      {schema_version:1,lane:$lane,snapshot_id:$snapshot_id,created_at_epoch:$created_at_epoch,expires_at_epoch:$expires_at_epoch,retention_days:$retention_days,deletion_owner:$deletion_owner,authentication_state_included:false,blueprint_file:"blueprint.json",blueprint_sha256:$blueprint_sha256}
    ' >"$temp_dir/manifest.json"
  chmod 600 "$temp_dir/manifest.json"
  mv "$temp_dir" "$snapshot_dir"
  recovery_temp_dir=''
  trap 'release_lease "$lane" "$run_id"' EXIT HUP INT TERM

  if [[ "$json" == 'true' ]]; then
    jq -cn \
      --arg run_id "$run_id" \
      --arg lane "$lane" \
      --arg snapshot_id "$snapshot_id" \
      --argjson expires_at_epoch "$expires" \
      --arg deletion_owner "$deletion_owner" \
      '{status:"ok",run_id:$run_id,data:{lane:$lane,snapshot_id:$snapshot_id,expires_at_epoch:$expires_at_epoch,deletion_owner:$deletion_owner,authentication_state_included:false}}'
  else
    printf 'lane=%s snapshot=%s expires_at_epoch=%s deletion_owner=%s authentication_state_included=false\n' "$lane" "$snapshot_id" "$expires" "$deletion_owner"
  fi
}

verify_recovery_snapshot() {
  local lane="$1" snapshot_id="$2" json="$3" run_id="$4" expires now state
  validate_snapshot_files "$lane" "$snapshot_id" "$run_id"
  expires="$(jq -r '.expires_at_epoch' "$snapshot_manifest")"
  now="$(date +%s)"
  state='active'
  [[ "$expires" -gt "$now" ]] || state='expired'
  if [[ "$json" == 'true' ]]; then
    jq -cn \
      --arg run_id "$run_id" \
      --arg lane "$lane" \
      --arg snapshot_id "$snapshot_id" \
      --arg state "$state" \
      --argjson expires_at_epoch "$expires" \
      '{status:(if $state=="active" then "ok" else "error" end),run_id:$run_id,data:{lane:$lane,snapshot_id:$snapshot_id,state:$state,integrity:"pass",expires_at_epoch:$expires_at_epoch,authentication_state_included:false}}'
  else
    printf 'lane=%s snapshot=%s state=%s integrity=pass expires_at_epoch=%s authentication_state_included=false\n' "$lane" "$snapshot_id" "$state" "$expires"
  fi
  [[ "$state" == 'active' ]] || exit "$EXIT_DRIFT"
}

expire_recovery_snapshot() {
  local lane="$1" snapshot_id="$2" execute="$3" json="$4" run_id="$5" expires now
  [[ "$execute" == 'true' ]] || die_usage 'recovery expire requires --execute'
  current_process_owns_lease "$lane" "$run_id" ||
    emit_error "$EXIT_DRIFT" 'recovery_lease_missing' "$run_id" false \
      "recovery expiry does not own the lane lease: $lane" \
      "Retry through the public browser-lane recovery command."
  validate_snapshot_files "$lane" "$snapshot_id" "$run_id"
  expires="$(jq -r '.expires_at_epoch' "$snapshot_manifest")"
  now="$(date +%s)"
  [[ "$expires" -le "$now" ]] ||
    emit_error "$EXIT_DRIFT" 'recovery_not_expired' "$run_id" false \
      "recovery snapshot has not reached its declared expiry" \
      "Retain it until expiry or use a separately approved exact-target deletion workflow."
  rm -f "$snapshot_blueprint" "$snapshot_manifest"
  rmdir "$snapshot_dir"
  rmdir "$recovery_root/$lane" 2>/dev/null || true
  if [[ "$json" == 'true' ]]; then
    jq -cn --arg run_id "$run_id" --arg lane "$lane" --arg snapshot_id "$snapshot_id" \
      '{status:"ok",run_id:$run_id,data:{lane:$lane,snapshot_id:$snapshot_id,state:"expired_and_removed"}}'
  else
    printf 'lane=%s snapshot=%s state=expired_and_removed\n' "$lane" "$snapshot_id"
  fi
}

list_lanes() {
  local json="$1" run_id="$2" data
  data="$(jq -c '[.lanes | to_entries[] | {lane:.key,provisioned:.value.provisioned,account_role:.value.account_role,relay_port:.value.relay_port,expected_access_mode:.value.expected_access_mode}] | sort_by(.lane)' "$registry")"
  if [[ "$json" == 'true' ]]; then
    jq -cn --arg run_id "$run_id" --argjson lanes "$data" '{status:"ok",run_id:$run_id,data:{lanes:$lanes}}'
    return
  fi
  jq -r '.[] | "lane=\(.lane) provisioned=\(.provisioned) role=\(.account_role) relay=127.0.0.1:\(.relay_port) access=\(.expected_access_mode)"' <<<"$data"
}

baseline_findings() {
  local lane_value="$1" profile_path preferences secure_preferences required_id actual expected
  local allowed_extensions actual_extensions
  profile_path="$(profile_path_for "$(jq -r '.profile_directory' <<<"$lane_value")")"
  preferences="$profile_path/Preferences"
  secure_preferences="$profile_path/Secure Preferences"

  for required_id in $(jq -r '.required_extensions[]' <<<"$lane_value"); do
    if ! jq -e --arg id "$required_id" '.extensions.settings[$id] != null' "$secure_preferences" >/dev/null 2>&1; then
      printf 'required_extension_missing\n'
    fi
  done

  if jq -e '.allowed_extensions != null' <<<"$lane_value" >/dev/null; then
    allowed_extensions="$(jq -c '.allowed_extensions | unique | sort' <<<"$lane_value")"
    actual_extensions="$(jq -c '[.extensions.settings | to_entries[] | select((.value.location == 1 and .value.was_installed_by_default != true) or .value.location == 4) | .key] | unique | sort' "$secure_preferences" 2>/dev/null)" || {
      printf 'extension_inventory_unreadable\n'
      actual_extensions='[]'
    }
    [[ "$actual_extensions" == "$allowed_extensions" ]] || printf 'extension_allowlist_drift\n'
  else
    printf 'extension_allowlist_unreviewed\n'
  fi

  while IFS=$'\t' read -r key expected; do
    [[ -n "$key" ]] || continue
    case "$key" in
      credentials_enable_service)
        actual="$(jq -r '.credentials_enable_service' "$preferences")" ;;
      autofill_profile_enabled)
        actual="$(jq -r '.autofill.profile_enabled' "$preferences")" ;;
      autofill_credit_card_enabled)
        actual="$(jq -r '.autofill.credit_card_enabled' "$preferences")" ;;
      *)
        printf 'registry_baseline_key_unsupported\n'
        continue ;;
    esac
    [[ "$actual" == "$expected" ]] || printf 'chrome_autofill_drift\n'
  done < <(jq -r '.chrome_autofill_expectations // {} | to_entries[] | [.key, (.value|tostring)] | @tsv' <<<"$lane_value")

  expected="$(jq -r '.download_directory' <<<"$lane_value")"
  actual="$(jq -r '.download.default_directory // empty' "$preferences")"
  [[ "$actual" == "$expected" && -d "$expected" ]] || printf 'download_directory_drift\n'

  sync_count="$(jq -r '.sync.selected_types_per_account // {} | length' "$preferences")"
  if [[ "$(jq -r '.sync_expectations.account_shape' <<<"$lane_value")" == 'absent' ]]; then
    [[ "$sync_count" == '0' ]] || printf 'sync_account_shape_drift\n'
  else
    if [[ "$sync_count" != '1' ]]; then
      printf 'sync_account_shape_drift\n'
    else
      while IFS=$'\t' read -r key expected; do
        actual="$(jq -r --arg key "$key" '.sync.selected_types_per_account | to_entries[0].value[$key]' "$preferences")"
        [[ "$actual" == "$expected" ]] || printf 'sync_selection_drift\n'
      done < <(jq -r '.sync_expectations.selected_types | to_entries[] | [.key, (.value|tostring)] | @tsv' <<<"$lane_value")
    fi
  fi
}

health_lane() {
  local lane="$1" lane_value="$2" json="$3" run_id="$4" route_state baseline_state findings findings_json
  local baseline_findings_output baseline_finding
  route_state='pass'
  baseline_state='pass'
  findings=''

  if [[ "$(jq -r '.provisioned' <<<"$lane_value")" != 'true' ]]; then
    route_state='fail'
    baseline_state='unproved'
    findings='lane_not_provisioned'
  else
    profile_identity_ok "$lane_value" || {
      route_state='fail'
      findings="${findings}${findings:+$'\n'}profile_mismatch"
    }
    extension_discovery_ok "$lane_value" || {
      route_state='fail'
      findings="${findings}${findings:+$'\n'}extension_unavailable"
    }
    relay_listener_ok "$lane_value" || {
      route_state='fail'
      findings="${findings}${findings:+$'\n'}relay_listener_mismatch"
    }
    live_access_status "$lane_value"
    case "$access_status_state" in
      unavailable) route_state='fail'; findings="${findings}${findings:+$'\n'}access_mode_live_check_unavailable" ;;
      mismatch|disabled|transitioning) baseline_state='fail'; findings="${findings}${findings:+$'\n'}access_mode_${access_status_state}" ;;
    esac
    baseline_findings_output="$(baseline_findings "$lane_value")"
    while IFS= read -r baseline_finding; do
      [[ -n "$baseline_finding" ]] || continue
      findings="${findings}${findings:+$'\n'}${baseline_finding}"
      [[ "$baseline_finding" == 'extension_allowlist_unreviewed' ]] || baseline_state='fail'
    done <<<"$baseline_findings_output"
    findings="${findings}${findings:+$'\n'}effective_policy_check_unavailable"
    [[ "$baseline_state" == 'fail' ]] || baseline_state='warning'
  fi

  if [[ -n "$findings" ]]; then
    findings_json="$(printf '%s\n' "$findings" | awk 'NF' | sort -u | jq -Rsc 'split("\n") | map(select(length > 0))')"
  else
    findings_json='[]'
  fi

  if [[ "$json" == 'true' ]]; then
    jq -cn \
      --arg run_id "$run_id" \
      --arg lane "$lane" \
      --arg route "$route_state" \
      --arg baseline "$baseline_state" \
      --argjson findings "$findings_json" \
      '{status:(if $route=="pass" and $baseline!="fail" then "ok" else "error" end),run_id:$run_id,data:{lane:$lane,route:$route,baseline:$baseline,findings:$findings}}'
  else
    printf 'lane=%s route=%s baseline=%s findings=%s\n' "$lane" "$route_state" "$baseline_state" "$(jq -r 'join(",")' <<<"$findings_json")"
  fi

  [[ "$route_state" == 'pass' && "$baseline_state" != 'fail' ]] || exit "$EXIT_DRIFT"
}

# One validator owns the private action-plan file contract for every plan
# engine. The engine selects only its display name, its error-code prefix, and
# its in-page allowlist; the Playwright allowlist is the playwright-cli command
# set with a bounded argument count, and the Puppeteer allowlist pins an exact
# arity per command because the lane-owned helper maps each one onto a fixed
# Puppeteer API call.
validate_action_plan() {
  local engine="$1" plan_file="$2" run_id="$3" mode engine_name
  case "$engine" in
    playwright) engine_name='Playwright' ;;
    puppeteer) engine_name='Puppeteer' ;;
    *) emit_error "$EXIT_INVALID_REGISTRY" 'plan_engine_unknown' "$run_id" false \
      'the action-plan engine is not supported' 'Use playwright or puppeteer.' ;;
  esac
  [[ "$plan_file" == /* && -f "$plan_file" && ! -L "$plan_file" ]] ||
    emit_error "$EXIT_USAGE" "${engine}_plan_unsafe" "$run_id" false \
      "the $engine_name plan must be an absolute regular non-symlink file" \
      'Create a private mode-600 JSON plan file and pass its absolute path.'
  mode="$(private_mode "$plan_file")"
  [[ "$mode" == '600' ]] ||
    emit_error "$EXIT_USAGE" "${engine}_plan_permissions" "$run_id" false \
      "$engine_name plan permissions are $mode, expected 600" \
      "Run: chmod 600 $plan_file"
  jq -e --arg engine "$engine" '
    def playwright_command_ok:
      . as $action
      | [
          "snapshot", "find", "click", "dblclick", "type", "fill",
          "drag", "drop", "hover", "select", "check", "uncheck",
          "dialog-accept", "dialog-dismiss", "press", "keydown", "keyup",
          "mousemove", "mousedown", "mouseup", "mousewheel", "console",
          "generate-locator", "highlight"
        ]
      | index($action.command) != null and ($action.args | length <= 10);
    def puppeteer_command_ok:
      . as $action
      | {
          title: [0, 0], snapshot: [0, 0], text: [1, 1], click: [1, 1],
          hover: [1, 1], type: [2, 2], press: [1, 1], select: [2, 10],
          wait: [1, 1]
        } as $arity
      | ($arity[$action.command] != null) and
        (($action.args | length) >= $arity[$action.command][0]) and
        (($action.args | length) <= $arity[$action.command][1]);
    def command_ok:
      if $engine == "puppeteer" then puppeteer_command_ok else playwright_command_ok end;
    . as $plan |
    (.schema_version == 1 or .schema_version == 2) and
    (.actions | type == "array" and length >= 1 and length <= 50) and
    all(.actions[];
      (type == "object") and
      ((keys | sort) == ["args", "command"]) and
      (.command | type == "string") and
      (.args | type == "array") and
      (if .command == "evaluate" then
        $plan.schema_version == 2 and (.args | length == 1) and
        all(.args[]; type == "string" and length > 0 and length <= 65536 and
          (contains("\u0000") | not))
      else
        all(.args[];
          type == "string" and length <= 4096 and
          (test("[\\r\\n]") | not) and (startswith("-") | not)
        ) and command_ok
      end)
    )
  ' "$plan_file" >/dev/null 2>&1 ||
    emit_error "$EXIT_USAGE" "${engine}_plan_invalid" "$run_id" false \
      "the $engine_name plan failed its schema or action allowlist" \
      'Use schema_version 1 for fixed actions or 2 for evaluate with one function source; keep 1 through 50 actions and private mode-600 input.'
}

action_plan_temp_file=''

cleanup_action_plan_file() {
  [[ -n "${action_plan_temp_file:-}" ]] || return 0
  rm -f "$action_plan_temp_file"
  action_plan_temp_file=''
}

# Snapshot the caller's plan into private lane state and revalidate the copy,
# so the executed bytes are the validated bytes even if the caller's file
# changes after validation.
snapshot_action_plan() {
  local engine="$1" plan_file="$2" run_id="$3"
  action_plan_temp_file="$(mktemp "$state_root/${engine}-plan.XXXXXX")"
  chmod 600 "$action_plan_temp_file"
  /bin/cp "$plan_file" "$action_plan_temp_file"
  chmod 600 "$action_plan_temp_file"
  validate_action_plan "$engine" "$action_plan_temp_file" "$run_id"
}

# The Puppeteer helper lives beside this executable's real location, so the
# installed symlink and the checkout path resolve the same file.
puppeteer_helper_path() {
  local script_real
  script_real="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null)" || return 1
  printf '%s/lib/browser-lane-puppeteer.js' "$(dirname "$script_real")"
}

playwright_child_error() {
  local exit_code="$1" code="$2" message="$3" next="$4"
  printf '%s: %s\n' "$PROGRAM" "$message" >&2
  jq -cn \
    --arg status 'error' \
    --arg run_id "${BROWSER_LANE_RUN_ID:-unknown}" \
    --arg code "$code" \
    --arg message "$message" \
    --arg next "$next" \
    '{status:$status,run_id:$run_id,error:{code:$code,retry_safe:false,message:$message,next:$next}}' >&2
  return "$exit_code"
}

playwright_child() {
  local plan_file="${BROWSER_LANE_PLAYWRIGHT_PLAN:-}"
  local session_name="${BROWSER_LANE_PLAYWRIGHT_SESSION:-}"
  local expected_url_hash="${BROWSER_LANE_PAGE_URL_SHA256:-}"
  local endpoint="${AGENT_BROWSER_CDP:-}"
  local playwright_cli cli_real cli_root daemon node_bin

  [[ "${BROWSER_LANE_INTERNAL_CHILD:-}" == '1' && -n "$plan_file" && -n "$session_name" &&
      "$expected_url_hash" =~ ^[0-9a-f]{64}$ && -n "$endpoint" ]] || {
    playwright_child_error "$EXIT_INVALID_REGISTRY" 'playwright_child_contract_invalid' \
      'the internal Playwright handoff is incomplete' \
      'Retry through the public browser-lane playwright command.'
    return "$?"
  }

  playwright_cli="$(command -v playwright-cli 2>/dev/null || true)"
  node_bin="$(command -v node 2>/dev/null || true)"
  [[ -n "$playwright_cli" && -n "$node_bin" ]] || {
    playwright_child_error "$EXIT_INVALID_REGISTRY" 'playwright_dependency_missing' \
      'Playwright CLI or Node.js is unavailable inside the relay handoff' \
      'Restore the configured Node.js and @playwright/cli installation.'
    return "$?"
  }
  cli_real="$(realpath "$playwright_cli" 2>/dev/null || true)"
  cli_root="$(dirname "$cli_real")"
  daemon="$cli_root/node_modules/playwright-core/lib/entry/cliDaemon.js"
  [[ -f "$daemon" && ! -L "$daemon" ]] || {
    playwright_child_error "$EXIT_INVALID_REGISTRY" 'playwright_daemon_missing' \
      'the installed Playwright CLI daemon could not be resolved' \
      'Repair the configured @playwright/cli installation.'
    return "$?"
  }

  local helper
  helper="$(dirname "$(realpath "${BASH_SOURCE[0]}")")/lib/browser-lane-playwright.js"
  [[ -f "$helper" && ! -L "$helper" ]] || {
    playwright_child_error "$EXIT_INVALID_REGISTRY" 'playwright_helper_missing' \
      'the lane-owned Playwright helper is unavailable' 'Repair the owning dotfiles checkout.'
    return "$?"
  }
  export BROWSER_LANE_PLAYWRIGHT_CLI="$playwright_cli"
  export BROWSER_LANE_PLAYWRIGHT_DAEMON="$daemon"
  export BROWSER_LANE_PLAYWRIGHT_NODE="$node_bin"
  unset BROWSER_LANE_INTERNAL_CHILD
  exec "$node_bin" "$helper"
}

puppeteer_child_error() {
  local exit_code="$1" code="$2" message="$3" next="$4"
  printf '%s: %s\n' "$PROGRAM" "$message" >&2
  jq -cn \
    --arg status 'error' \
    --arg run_id "${BROWSER_LANE_RUN_ID:-unknown}" \
    --arg code "$code" \
    --arg message "$message" \
    --arg next "$next" \
    '{status:$status,run_id:$run_id,error:{code:$code,retry_safe:false,message:$message,next:$next}}' >&2
  return "$exit_code"
}

# Runs inside MCPorter's one-use relay handoff. The only job here is to prove
# the internal contract and hand the environment to the lane-owned Node helper;
# exec keeps MCPorter's forwarded signals on the helper itself so its bounded
# disconnect owns cleanup.
puppeteer_child() {
  local plan_file="${BROWSER_LANE_PUPPETEER_PLAN:-}"
  local expected_url_hash="${BROWSER_LANE_PAGE_URL_SHA256:-}"
  local endpoint="${AGENT_BROWSER_CDP:-}"
  local node_bin helper
  [[ "${BROWSER_LANE_INTERNAL_CHILD:-}" == '1' && -n "$plan_file" &&
      "$expected_url_hash" =~ ^[0-9a-f]{64}$ && -n "$endpoint" ]] || {
    puppeteer_child_error "$EXIT_INVALID_REGISTRY" 'puppeteer_child_contract_invalid' \
      'the internal Puppeteer handoff is incomplete' \
      'Retry through the public browser-lane puppeteer command.'
    return "$?"
  }
  node_bin="$(command -v node 2>/dev/null || true)"
  [[ -n "$node_bin" ]] || {
    puppeteer_child_error "$EXIT_INVALID_REGISTRY" 'puppeteer_dependency_missing' \
      'Node.js is unavailable inside the relay handoff' \
      'Restore the configured Node.js installation.'
    return "$?"
  }
  helper="$(puppeteer_helper_path)" && [[ -f "$helper" && ! -L "$helper" ]] || {
    puppeteer_child_error "$EXIT_INVALID_REGISTRY" 'puppeteer_helper_missing' \
      'the lane-owned Puppeteer helper could not be resolved' \
      'Repair the dotfiles checkout that owns browser-lane.'
    return "$?"
  }
  unset BROWSER_LANE_INTERNAL_CHILD
  exec "$node_bin" "$helper"
}

relay_child_pid=''
relay_child_status=0

# Wait for the background relay handoff in this shell. A trapped signal makes
# `wait` return early with a status above 128; the signal trap owns that case,
# so the loop keeps waiting while the child is alive and records only the
# child's own status.
wait_for_relay_child() {
  local status
  while :; do
    if wait "$relay_child_pid"; then
      status=0
    else
      status=$?
    fi
    if [[ "$status" -gt 128 ]] && kill -0 "$relay_child_pid" 2>/dev/null; then
      continue
    fi
    break
  done
  relay_child_status="$status"
}

# Parent custody of the relay handoff on HUP, INT, or TERM: forward the stop,
# wait a bounded time for the broker and helper to retire, then exit through
# the EXIT trap that removes the plan snapshot and releases the lease.
relay_parent_signal_cleanup() {
  local attempt
  trap - HUP INT TERM
  if [[ -n "${relay_child_pid:-}" ]] && kill -0 "$relay_child_pid" 2>/dev/null; then
    kill -TERM "$relay_child_pid" 2>/dev/null || true
    for ((attempt = 0; attempt < 120; attempt++)); do
      kill -0 "$relay_child_pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$relay_child_pid" 2>/dev/null; then
      kill -KILL "$relay_child_pid" 2>/dev/null || true
    fi
    wait "$relay_child_pid" 2>/dev/null || true
  fi
  printf '%s: Browser run interrupted; relay handoff retired\n' "$PROGRAM" >&2
  exit 130
}

validate_recovery_usage() {
  local action="$1" lane="$2" retention_days="$3" deletion_owner="$4" snapshot="$5" execute="$6"
  [[ -n "$lane" ]] || die_usage 'recovery requires --lane'
  case "$action" in
    create)
      [[ -z "$snapshot" && "$execute" == 'false' ]] ||
        die_usage 'recovery create does not accept --snapshot or --execute'
      [[ -n "$retention_days" ]] || die_usage 'recovery create requires --retention-days'
      [[ "$retention_days" =~ ^[1-9][0-9]*$ && "$retention_days" -le "$MAX_RETENTION_DAYS" ]] ||
        die_usage "--retention-days must be 1 through $MAX_RETENTION_DAYS"
      [[ -n "$deletion_owner" ]] || die_usage 'recovery create requires --deletion-owner'
      [[ "$deletion_owner" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
        die_usage '--deletion-owner must be a safe owner label' ;;
    verify)
      [[ -z "$retention_days" && -z "$deletion_owner" && "$execute" == 'false' ]] ||
        die_usage 'recovery verify accepts --lane, --snapshot, --run-id, and --json only'
      [[ -n "$snapshot" ]] || die_usage 'recovery verify requires --snapshot' ;;
    expire)
      [[ -z "$retention_days" && -z "$deletion_owner" ]] ||
        die_usage 'recovery expire accepts --lane, --snapshot, --execute, --run-id, and --json only'
      [[ -n "$snapshot" ]] || die_usage 'recovery expire requires --snapshot'
      [[ "$execute" == 'true' ]] || die_usage 'recovery expire requires --execute' ;;
  esac
}

main() {
  local command_name="${1:-}" json='false' lane='' account_role='' run_id='' run_id_set='false' ttl='' ttl_set='false'
  local page_url='' page_url_set='false' next_page_url='' next_page_url_set='false' child_tool='' resolved_page_id=''
  local child_arg='' page_id_routed='false'
  local -a child_argv=()
  local recovery_action='' retention_days='' deletion_owner='' snapshot='' execute='false' recovery_flags='false'
  local plan_file='' plan_file_set='false' scenario=''
  local handoff_action='' task_ref='' window='' window_set='false' nonce='' nonce_output='' reservation='' acknowledgement='' handoff_flags='false'
  [[ -n "$command_name" ]] || { usage; exit "$EXIT_USAGE"; }
  if [[ "$command_name" == '__playwright-child' ]]; then
    [[ "$#" -eq 1 ]] || exit "$EXIT_USAGE"
    playwright_child
    exit "$?"
  fi
  if [[ "$command_name" == '__puppeteer-child' ]]; then
    [[ "$#" -eq 1 ]] || exit "$EXIT_USAGE"
    puppeteer_child
    exit "$?"
  fi
  case "$command_name" in
    -h|--help|help) usage; exit 0 ;;
    list|open|health|inspect|run|agent-browser|playwright|puppeteer) shift ;;
    handoff)
      shift
      handoff_action="${1:-}"
      case "$handoff_action" in
        open|status|resume|release|recover) shift ;;
        -h|--help) usage; exit 0 ;;
        *) die_usage 'handoff requires one of: open, status, resume, release, recover' ;;
      esac ;;
    recovery)
      shift
      recovery_action="${1:-}"
      case "$recovery_action" in
        create|verify|expire) shift ;;
        -h|--help) usage; exit 0 ;;
        *) die_usage 'recovery requires one of: create, verify, expire' ;;
      esac ;;
    *) die_usage "unknown command: $command_name" ;;
  esac

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --json) json='true'; shift ;;
      --lane)
        [[ "$#" -ge 2 ]] || die_usage '--lane requires a value'
        lane="$2"; shift 2 ;;
      --account-role)
        [[ "$#" -ge 2 ]] || die_usage '--account-role requires a value'
        account_role="$2"; shift 2 ;;
      --run-id)
        [[ "$#" -ge 2 ]] || die_usage '--run-id requires a value'
        run_id="$2"; run_id_set='true'; shift 2 ;;
      --ttl)
        [[ "$#" -ge 2 ]] || die_usage '--ttl requires a value'
        ttl="$2"; ttl_set='true'; shift 2 ;;
      --page-url)
        [[ "$#" -ge 2 ]] || die_usage '--page-url requires a value'
        page_url="$2"; page_url_set='true'; shift 2 ;;
      --next-page-url)
        [[ "$#" -ge 2 ]] || die_usage '--next-page-url requires a value'
        next_page_url="$2"; next_page_url_set='true'; shift 2 ;;
      --scenario)
        [[ "$#" -ge 2 && "$2" =~ ^[A-Za-z0-9._-]{1,80}$ ]] || die_usage '--scenario requires 1 through 80 letters, digits, dots, underscores, or hyphens'
        scenario="$2"; shift 2 ;;
      --plan)
        [[ "$#" -ge 2 ]] || die_usage '--plan requires a value'
        plan_file="$2"; plan_file_set='true'; shift 2 ;;
      --task-ref)
        [[ "$#" -ge 2 ]] || die_usage '--task-ref requires a value'
        task_ref="$2"; handoff_flags='true'; shift 2 ;;
      --window)
        [[ "$#" -ge 2 ]] || die_usage '--window requires a value'
        window="$2"; window_set='true'; handoff_flags='true'; shift 2 ;;
      --nonce|--nonce=*)
        die_usage '--nonce is unsafe and no longer accepted; use --nonce-output for open and --nonce-file for resume or release' ;;
      --nonce-file)
        [[ "$#" -ge 2 ]] || die_usage '--nonce-file requires a path'
        nonce="$2"; handoff_flags='true'; shift 2 ;;
      --nonce-output)
        [[ "$#" -ge 2 ]] || die_usage '--nonce-output requires a path'
        nonce_output="$2"; handoff_flags='true'; shift 2 ;;
      --reservation)
        [[ "$#" -ge 2 ]] || die_usage '--reservation requires a fingerprint'
        reservation="$2"; handoff_flags='true'; shift 2 ;;
      --acknowledge)
        [[ "$#" -ge 2 ]] || die_usage '--acknowledge requires the task reference'
        acknowledgement="$2"; handoff_flags='true'; shift 2 ;;
      --retention-days)
        [[ "$#" -ge 2 ]] || die_usage '--retention-days requires a value'
        retention_days="$2"; recovery_flags='true'; shift 2 ;;
      --deletion-owner)
        [[ "$#" -ge 2 ]] || die_usage '--deletion-owner requires a value'
        deletion_owner="$2"; recovery_flags='true'; shift 2 ;;
      --snapshot)
        [[ "$#" -ge 2 ]] || die_usage '--snapshot requires a value'
        snapshot="$2"; recovery_flags='true'; shift 2 ;;
      --execute) execute='true'; if [[ "$command_name" == 'handoff' ]]; then handoff_flags='true'; else recovery_flags='true'; fi; shift ;;
      --) shift; break ;;
      -h|--help) usage; exit 0 ;;
      *) die_usage "unknown argument: $1" ;;
    esac
  done

  # Recovery usage is settled before any registry, lane, or state check so an
  # invalid invocation never creates recovery state.
  if [[ "$command_name" == 'recovery' ]]; then
    [[ -z "$account_role" && "$ttl_set" == 'false' && "$page_url_set" == 'false' && "$plan_file_set" == 'false' && "$handoff_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'recovery does not accept --account-role, --ttl, --page-url, --plan, or a command after --'
    validate_recovery_usage "$recovery_action" "$lane" "$retention_days" "$deletion_owner" "$snapshot" "$execute"
  fi

  if [[ "$command_name" == 'open' ]]; then
    [[ -n "$lane" ]] || die_usage 'open requires --lane'
    [[ -n "$account_role" ]] || die_usage 'open requires --account-role'
    [[ "$page_url_set" == 'true' ]] || die_usage 'open requires --page-url'
    [[ "$page_url" =~ ^https?://[^[:space:]]+$ && ! "$page_url" =~ ^https?://[^/?#[:space:]]*@ ]] ||
      die_usage '--page-url must be an ordinary HTTP or HTTPS URL without embedded user information'
    [[ "$run_id_set" == 'false' && "$ttl_set" == 'false' && "$plan_file_set" == 'false' && -z "$scenario" && "$recovery_flags" == 'false' && "$handoff_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'open accepts --lane, --account-role, --page-url, and --json only'
  fi

  [[ "$command_name" == 'agent-browser' || "$next_page_url_set" == 'false' ]] ||
    die_usage '--next-page-url is only accepted by agent-browser'

  # Handoff usage is settled before any state check so malformed invocations
  # cannot create private reservation state or contact the relay.
  if [[ -n "$scenario" ]]; then
    case "$command_name" in run|agent-browser|playwright|puppeteer) ;; *) die_usage '--scenario is only for browser adapter runs' ;; esac
  fi
  if [[ "$command_name" == 'handoff' ]]; then
    [[ -n "$lane" ]] || die_usage 'handoff requires --lane'
    [[ "$ttl_set" == 'false' && "$plan_file_set" == 'false' && "$recovery_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'handoff does not accept --ttl, --plan, recovery flags, or a command after --'
    [[ "$handoff_action" == 'open' || -z "$nonce_output" ]] || die_usage '--nonce-output is only accepted by handoff open'
    [[ "$handoff_action" == 'recover' || ( -z "$reservation" && -z "$acknowledgement" && "$execute" == 'false' ) ]] || die_usage 'recovery acknowledgement flags are only accepted by handoff recover'
    case "$handoff_action" in
      open)
        [[ -n "$account_role" ]] || die_usage 'handoff open requires --account-role'
        [[ -n "$task_ref" ]] || die_usage 'handoff open requires --task-ref'
        [[ "$task_ref" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] ||
          die_usage '--task-ref must be a safe task label'
        [[ -z "$nonce" ]] || die_usage 'handoff open does not accept --nonce-file'
        if [[ "$page_url_set" == 'true' ]]; then
          [[ "$page_url" =~ ^https?://[^[:space:]]+$ && ! "$page_url" =~ ^https?://[^/?#[:space:]]*@ ]] ||
            die_usage '--page-url must be an ordinary HTTP or HTTPS URL without embedded user information'
        fi
        [[ "$window_set" == 'true' ]] || window="$DEFAULT_HANDOFF_WINDOW_SECONDS"
        [[ "$window" =~ ^[1-9][0-9]*$ && "$window" -le "$MAX_HANDOFF_WINDOW_SECONDS" ]] ||
          die_usage "--window must be 1 through $MAX_HANDOFF_WINDOW_SECONDS seconds"
        [[ -n "$nonce_output" ]] || die_usage 'handoff open requires --nonce-output in a private directory' ;;
      status)
        [[ "$page_url_set" == 'false' && -z "$account_role" && -z "$task_ref" && "$window_set" == 'false' && -z "$nonce" ]] ||
          die_usage 'handoff status accepts --lane, --run-id, and --json only' ;;
      resume)
        [[ -n "$account_role" ]] || die_usage 'handoff resume requires --account-role'
        [[ -n "$nonce" ]] || die_usage 'handoff resume requires --nonce-file'
        [[ "$page_url_set" == 'true' ]] || die_usage 'handoff resume requires --page-url'
        [[ "$page_url" =~ ^https?://[^[:space:]]+$ && ! "$page_url" =~ ^https?://[^/?#[:space:]]*@ ]] ||
          die_usage '--page-url must be an ordinary HTTP or HTTPS URL without embedded user information'
        [[ -z "$task_ref" && "$window_set" == 'false' ]] ||
          die_usage 'handoff resume does not accept --task-ref or --window' ;;
      release)
        [[ -n "$nonce" ]] || die_usage 'handoff release requires --nonce-file'
        [[ "$page_url_set" == 'false' && -z "$account_role" && -z "$task_ref" && "$window_set" == 'false' ]] ||
          die_usage 'handoff release accepts --lane, --nonce-file, --run-id, and --json only' ;;
      recover)
        [[ -z "$nonce" && -z "$account_role" && -z "$task_ref" && "$window_set" == 'false' && "$page_url_set" == 'false' ]] || die_usage 'handoff recover accepts lane, reservation, acknowledge, execute, run-id, and json only'
        if [[ "$execute" == 'true' ]]; then
          [[ "$reservation" =~ ^[0-9a-f]{64}$ && "$acknowledgement" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die_usage 'handoff recover --execute requires --reservation from preview and --acknowledge TASKREF'
        else
          [[ -z "$reservation" && -z "$acknowledgement" ]] || die_usage 'preview omits --reservation and --acknowledge; execution also requires --execute'
        fi ;;
    esac
  fi

  [[ -n "$run_id" ]] || run_id="$(generated_run_id)"
  [[ "$run_id" =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$ ]] || die_usage 'run id is invalid'
  require_command jq "$run_id"
  load_free_mode "$run_id"
  if [[ -n "$snapshot" ]]; then
    validate_snapshot_id "$snapshot" ||
      emit_error "$EXIT_USAGE" 'invalid_snapshot_id' "$run_id" false \
        "snapshot id is invalid" "Use the snapshot id returned by recovery create."
  fi
  if [[ "$command_name" != 'handoff' || "$handoff_action" != 'recover' || "$execute" == 'true' ]]; then
    mkdir -p "$state_root" "$leases_root"
    chmod 700 "$state_root" "$leases_root"
    prepare_handoffs_root "$run_id"
  fi
  validate_registry "$run_id"

  if [[ "$command_name" == 'list' ]]; then
    [[ -z "$lane" && -z "$account_role" && "$ttl_set" == 'false' && "$page_url_set" == 'false' && "$plan_file_set" == 'false' && "$recovery_flags" == 'false' && "$handoff_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'list accepts only --json'
    list_lanes "$json" "$run_id"
    return
  fi

  [[ -n "$lane" ]] || die_usage "$command_name requires --lane"
  lane_value="$(require_lane "$lane" "$run_id")"

  if [[ "$command_name" == 'open' ]]; then
    open_profile_page "$lane" "$lane_value" "$account_role" "$page_url" "$json" "$run_id"
  fi

  if [[ "$command_name" == 'handoff' ]]; then
    case "$handoff_action" in
      open) open_handoff "$lane" "$lane_value" "$account_role" "$task_ref" "$window" "$page_url" "$json" "$run_id" "$nonce_output" ;;
      status) status_handoff "$lane" "$lane_value" "$json" "$run_id" ;;
      resume) resume_handoff "$lane" "$lane_value" "$account_role" "$nonce" "$page_url" "$json" "$run_id" ;;
      release) release_handoff "$lane" "$lane_value" "$nonce" "$json" "$run_id" ;;
      recover) recover_handoff "$lane" "$lane_value" "$json" "$run_id" "$reservation" "$acknowledgement" "$execute" ;;
    esac
    return
  fi

  if [[ "$command_name" == 'health' ]]; then
    [[ -z "$account_role" && "$ttl_set" == 'false' && "$page_url_set" == 'false' && "$plan_file_set" == 'false' && "$recovery_flags" == 'false' && "$handoff_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'health accepts --lane and --json only'
    require_command openclaw "$run_id"
    require_command "$mcporter_bin" "$run_id"
    health_lane "$lane" "$lane_value" "$json" "$run_id"
    return
  fi

  if [[ "$command_name" == 'recovery' ]]; then
    case "$recovery_action" in
      create)
        acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
        trap 'release_lease "$lane" "$run_id"' EXIT HUP INT TERM
        refuse_while_handoff "$lane" "$lane_value" "$run_id"
        create_recovery_snapshot "$lane" "$lane_value" "$retention_days" "$deletion_owner" "$json" "$run_id"
        exit 0 ;;
      verify) verify_recovery_snapshot "$lane" "$snapshot" "$json" "$run_id" ;;
      expire)
        acquire_lease "$lane" "$run_id" "$DEFAULT_TTL_SECONDS"
        trap 'release_lease "$lane" "$run_id"' EXIT HUP INT TERM
        refuse_while_handoff "$lane" "$lane_value" "$run_id"
        expire_recovery_snapshot "$lane" "$snapshot" "$execute" "$json" "$run_id"
        exit 0 ;;
    esac
    return
  fi

  if [[ "$command_name" == 'inspect' ]]; then
    [[ "$recovery_flags" == 'false' && "$plan_file_set" == 'false' && "$handoff_flags" == 'false' && "$#" -eq 0 ]] ||
      die_usage 'inspect does not accept a plan, recovery flags, or a child command'
    [[ -n "$account_role" ]] || die_usage 'inspect requires --account-role'
    expected_role="$(jq -r '.account_role' <<<"$lane_value")"
    [[ "$account_role" == "$expected_role" ]] ||
      emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
        "selected account role does not match lane $lane" "Use the role reported by '$PROGRAM list'."
    [[ "$ttl_set" == 'true' ]] || ttl="$DEFAULT_TTL_SECONDS"
    [[ "$ttl" =~ ^[1-9][0-9]*$ && "$ttl" -le "$MAX_TTL_SECONDS" ]] ||
      die_usage "--ttl must be 1 through $MAX_TTL_SECONDS seconds"
    if [[ "$page_url_set" == 'true' && ! "$page_url" =~ ^https?://[^[:space:]]+$ ]]; then
      die_usage '--page-url must be an absolute http or https URL'
    fi
    require_command openclaw "$run_id"
    require_command "$mcporter_bin" "$run_id"
    acquire_lease "$lane" "$run_id" "$ttl"
    trap 'cleanup_page_list_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
    if [[ "$page_url_set" == 'true' ]]; then
      refuse_while_handoff "$lane" "$lane_value" "$run_id"
    fi
    route_preflight "$lane" "$lane_value" "$run_id"
    inspect_lane "$lane_value" "$page_url" "$json" "$run_id"
    # Exit while main's lane/run locals are still in scope for the EXIT trap.
    exit 0
  fi

  if [[ "$command_name" == 'playwright' ]]; then
    [[ "$recovery_flags" == 'false' && "$handoff_flags" == 'false' ]] ||
      die_usage 'playwright does not accept recovery or handoff flags'
    [[ "$json" == 'false' ]] || die_usage 'playwright forwards action output and does not accept --json'
    [[ -n "$account_role" ]] || die_usage 'playwright requires --account-role'
    expected_role="$(jq -r '.account_role' <<<"$lane_value")"
    [[ "$account_role" == "$expected_role" ]] ||
      emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
        "selected account role does not match lane $lane" \
        "Use the role reported by '$PROGRAM list'."
    [[ "$ttl_set" == 'true' ]] || ttl="$DEFAULT_TTL_SECONDS"
    [[ "$ttl" =~ ^[1-9][0-9]*$ && "$ttl" -le "$MAX_TTL_SECONDS" ]] ||
      die_usage "--ttl must be 1 through $MAX_TTL_SECONDS seconds"
    [[ "$page_url_set" == 'true' ]] || die_usage 'playwright requires --page-url'
    [[ "$page_url" =~ ^https?://[^[:space:]]+$ ]] ||
      die_usage '--page-url must be an absolute http or https URL'
    [[ "$plan_file_set" == 'true' ]] || die_usage 'playwright requires --plan'
    [[ "$#" -eq 0 ]] || die_usage 'playwright accepts no command after --'
    validate_action_plan playwright "$plan_file" "$run_id"
    require_command openclaw "$run_id"
    require_command "$mcporter_bin" "$run_id"
    require_command playwright-cli "$run_id"
    require_command node "$run_id"
    require_command realpath "$run_id"

    snapshot_action_plan playwright "$plan_file" "$run_id"

    acquire_lease "$lane" "$run_id" "$ttl"
    trap 'cleanup_page_list_file; cleanup_action_plan_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
    refuse_while_handoff "$lane" "$lane_value" "$run_id"
    route_preflight "$lane" "$lane_value" "$run_id"
    resolve_admitted_page "$lane_value" "$page_url" "$run_id"
    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    start_lane_activity "http://127.0.0.1:$relay_port" "$run_id" 'playwright' "$ttl"

    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    safe_run_id="${run_id//:/-}"
    session_name="browser-lane-${lane}-${safe_run_id:0:80}-$$"
    export BROWSER_LANE_NAME="$lane"
    export BROWSER_LANE_RUN_ID="$run_id"
    export BROWSER_LANE_INTERNAL_CHILD='1'
    export BROWSER_LANE_PLAYWRIGHT_PLAN="$action_plan_temp_file"
    export BROWSER_LANE_PLAYWRIGHT_SESSION="$session_name"
    export BROWSER_LANE_PLAYWRIGHT_TTL_SECONDS="$ttl"
    export BROWSER_LANE_PAGE_URL_SHA256
    BROWSER_LANE_PAGE_URL_SHA256="$(printf '%s' "$page_url" | shasum -a 256 | awk '{print $1}')"
    set +e
    "$mcporter_bin" chrome-relay exec --relay-url "http://127.0.0.1:$relay_port" -- \
      "$0" __playwright-child &
    relay_child_pid=$!
    trap 'relay_parent_signal_cleanup' HUP INT TERM
    wait_for_relay_child
    child_status="$relay_child_status"
    set -e
    unset BROWSER_LANE_INTERNAL_CHILD BROWSER_LANE_PLAYWRIGHT_PLAN \
      BROWSER_LANE_PLAYWRIGHT_SESSION BROWSER_LANE_PLAYWRIGHT_TTL_SECONDS BROWSER_LANE_PAGE_URL_SHA256
    exit "$child_status"
  fi

  if [[ "$command_name" == 'puppeteer' ]]; then
    [[ "$recovery_flags" == 'false' && "$handoff_flags" == 'false' ]] ||
      die_usage 'puppeteer does not accept recovery or handoff flags'
    [[ "$json" == 'false' ]] || die_usage 'puppeteer prints one JSON line per action and does not accept --json'
    [[ -n "$account_role" ]] || die_usage 'puppeteer requires --account-role'
    expected_role="$(jq -r '.account_role' <<<"$lane_value")"
    [[ "$account_role" == "$expected_role" ]] ||
      emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
        "selected account role does not match lane $lane" \
        "Use the role reported by '$PROGRAM list'."
    [[ "$ttl_set" == 'true' ]] || ttl="$DEFAULT_TTL_SECONDS"
    [[ "$ttl" =~ ^[1-9][0-9]*$ && "$ttl" -le "$MAX_TTL_SECONDS" ]] ||
      die_usage "--ttl must be 1 through $MAX_TTL_SECONDS seconds"
    [[ "$page_url_set" == 'true' ]] || die_usage 'puppeteer requires --page-url'
    [[ "$page_url" =~ ^https?://[^[:space:]]+$ ]] ||
      die_usage '--page-url must be an absolute http or https URL'
    [[ "$plan_file_set" == 'true' ]] || die_usage 'puppeteer requires --plan'
    [[ "$#" -eq 0 ]] || die_usage 'puppeteer accepts no command after --'
    validate_action_plan puppeteer "$plan_file" "$run_id"
    require_command openclaw "$run_id"
    require_command "$mcporter_bin" "$run_id"
    require_command node "$run_id"
    require_command realpath "$run_id"
    puppeteer_helper="$(puppeteer_helper_path)" && [[ -f "$puppeteer_helper" && ! -L "$puppeteer_helper" ]] ||
      emit_error "$EXIT_INVALID_REGISTRY" 'puppeteer_helper_missing' "$run_id" false \
        'the lane-owned Puppeteer helper could not be resolved' \
        'Repair the dotfiles checkout that owns browser-lane.'

    snapshot_action_plan puppeteer "$plan_file" "$run_id"

    acquire_lease "$lane" "$run_id" "$ttl"
    trap 'cleanup_page_list_file; cleanup_action_plan_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
    refuse_while_handoff "$lane" "$lane_value" "$run_id"
    route_preflight "$lane" "$lane_value" "$run_id"
    resolve_admitted_page "$lane_value" "$page_url" "$run_id"
    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    start_lane_activity "http://127.0.0.1:$relay_port" "$run_id" 'puppeteer' "$ttl"

    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    export BROWSER_LANE_NAME="$lane"
    export BROWSER_LANE_RUN_ID="$run_id"
    export BROWSER_LANE_INTERNAL_CHILD='1'
    export BROWSER_LANE_PUPPETEER_PLAN="$action_plan_temp_file"
    export BROWSER_LANE_PUPPETEER_TTL_SECONDS="$ttl"
    export BROWSER_LANE_PAGE_URL_SHA256
    BROWSER_LANE_PAGE_URL_SHA256="$(printf '%s' "$page_url" | shasum -a 256 | awk '{print $1}')"
    # The relay handoff runs as a background job so a signal to this process
    # is forwarded to it at once instead of waiting for the current action to
    # finish; the parent then waits for the child to be gone before its EXIT
    # trap removes the plan snapshot and releases the lease.
    set +e
    "$mcporter_bin" chrome-relay exec --relay-url "http://127.0.0.1:$relay_port" -- \
      "$0" __puppeteer-child &
    relay_child_pid=$!
    trap 'relay_parent_signal_cleanup' HUP INT TERM
    wait_for_relay_child
    child_status="$relay_child_status"
    set -e
    trap 'cleanup_page_list_file; cleanup_action_plan_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
    unset BROWSER_LANE_INTERNAL_CHILD BROWSER_LANE_PUPPETEER_PLAN \
      BROWSER_LANE_PUPPETEER_TTL_SECONDS BROWSER_LANE_PAGE_URL_SHA256
    exit "$child_status"
  fi

  if [[ "$command_name" == 'agent-browser' ]]; then
    [[ "$recovery_flags" == 'false' && "$handoff_flags" == 'false' ]] ||
      die_usage 'agent-browser does not accept recovery or handoff flags'
    [[ "$plan_file_set" == 'false' ]] || die_usage 'agent-browser does not accept --plan'
    [[ "$json" == 'false' ]] || die_usage 'agent-browser forwards child output and does not accept --json'
    [[ -n "$account_role" ]] || die_usage 'agent-browser requires --account-role'
    expected_role="$(jq -r '.account_role' <<<"$lane_value")"
    [[ "$account_role" == "$expected_role" ]] ||
      emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
        "selected account role does not match lane $lane" \
        "Use the role reported by '$PROGRAM list'."
    [[ "$ttl_set" == 'true' ]] || ttl="$DEFAULT_TTL_SECONDS"
    [[ "$ttl" =~ ^[1-9][0-9]*$ && "$ttl" -le "$MAX_TTL_SECONDS" ]] ||
      die_usage "--ttl must be 1 through $MAX_TTL_SECONDS seconds"
    [[ "$page_url_set" == 'true' ]] || die_usage 'agent-browser requires --page-url'
    [[ "$page_url" =~ ^https?://[^[:space:]]+$ ]] ||
      die_usage '--page-url must be an absolute http or https URL'
    if [[ "$next_page_url_set" == 'true' ]]; then
      [[ "$next_page_url" =~ ^https?://[^[:space:]]+$ ]] ||
        die_usage '--next-page-url must be an absolute http or https URL'
      [[ "$#" -eq 1 ]] || die_usage '--next-page-url requires exactly one terminal batch command'
      start_origin="$(origin_from_page_url "$page_url")" || die_usage '--page-url has an unusable origin'
      next_origin="$(origin_from_page_url "$next_page_url")" || die_usage '--next-page-url has an unusable origin'
      [[ "$start_origin" == "$next_origin" && "$page_url" != "$next_page_url" ]] ||
        die_usage '--next-page-url must be a different URL on the same origin as --page-url'
    fi
    [[ "$#" -ge 1 ]] || die_usage 'agent-browser requires one or more batch commands after --'
    for child_arg in "$@"; do
      agent_browser_command_allowed "$child_arg" ||
        emit_error "$EXIT_USAGE" 'prohibited_agent_browser_command' "$run_id" false \
          'an Agent Browser batch command can change browser or tab custody' \
          'Use commands that operate inside the already admitted page.'
    done
    require_command openclaw "$run_id"
    require_command "$mcporter_bin" "$run_id"
    require_command agent-browser "$run_id"

    acquire_lease "$lane" "$run_id" "$ttl"
    trap 'cleanup_page_list_file; cleanup_agent_browser_temp_dir; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
    refuse_while_handoff "$lane" "$lane_value" "$run_id"
    route_preflight "$lane" "$lane_value" "$run_id"
    resolve_admitted_page "$lane_value" "$page_url" "$run_id"
    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    start_lane_activity "http://127.0.0.1:$relay_port" "$run_id" 'agent-browser' "$ttl"

    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    # Agent Browser uses the session name in a Unix socket path (max 103 bytes).
    # Hash the full identity instead of truncating it into a long filename.
    session_hash="$(printf '%s:%s' "$lane" "$run_id" | shasum -a 256 | cut -c 1-24)"
    session_name="browser-lane-${session_hash}-$$"
    page_url_hash="$(printf '%s' "$page_url" | shasum -a 256 | awk '{print $1}')"
    export BROWSER_LANE_NAME="$lane"
    export BROWSER_LANE_RUN_ID="$run_id"
    set +e
    next_page_hash=''
    [[ "$next_page_url_set" == 'false' ]] || next_page_hash="$(printf '%s' "$next_page_url" | shasum -a 256 | awk '{print $1}')"
    run_agent_browser_staged "http://127.0.0.1:$relay_port" "$session_name" "$page_url_hash" "$next_page_hash" "$@"
    child_status=$?
    set -e
    local action_outcome='unknown' cleanup_outcome='unknown' outcome_code="$child_status"
    case "${AGENT_BROWSER_STAGED_PHASE:-unknown}" in
      work|navigation|cleanup_failed)
        action_outcome='failed'; [[ "$AGENT_BROWSER_STAGED_STATUS" != '0' ]] || action_outcome='completed'
        cleanup_outcome='confirmed'; [[ "$AGENT_BROWSER_STAGED_PHASE" != cleanup_failed ]] || cleanup_outcome='unconfirmed'
        outcome_code="$AGENT_BROWSER_STAGED_STATUS"
        [[ "$cleanup_outcome" != unconfirmed || "$outcome_code" != 0 ]] || outcome_code=17 ;;
      attach_failed|url_unreadable|url_mismatch|transition_unreadable) action_outcome='failed'; cleanup_outcome='confirmed'; outcome_code="$AGENT_BROWSER_STAGED_STATUS" ;;
      *_cleanup_failed) action_outcome='failed'; cleanup_outcome='unconfirmed'; outcome_code="$AGENT_BROWSER_STAGED_STATUS" ;;
    esac
    record_lane_outcome "$action_outcome" "$cleanup_outcome" "$outcome_code"
    case "${AGENT_BROWSER_STAGED_PHASE:-unknown}" in
      attach_failed|attach_cleanup_failed)
        [[ "${AGENT_BROWSER_STAGED_PHASE:-}" != 'attach_cleanup_failed' ]] ||
          printf '%s: Agent Browser retirement remained unresolved after attach failure\n' "$PROGRAM" >&2
        cleanup_agent_browser_temp_dir
        emit_error "$EXIT_LIFECYCLE_UNRESOLVED" 'agent_browser_attach_failed' "$run_id" true \
          'Agent Browser could not attach its run-scoped session to the admitted page' \
          'Check the run-scoped Agent Browser runtime and socket directory; exact-page readiness already passed.'
        ;;
      url_unreadable|url_unreadable_cleanup_failed)
        [[ "${AGENT_BROWSER_STAGED_PHASE:-}" != 'url_unreadable_cleanup_failed' ]] ||
          printf '%s: Agent Browser retirement remained unresolved after page-read failure\n' "$PROGRAM" >&2
        cleanup_agent_browser_temp_dir
        emit_error "$EXIT_PAGE_UNRESOLVED" 'agent_browser_page_unreadable' "$run_id" false \
          'Agent Browser could not read the page bound to its run-scoped session' \
          "Observe the intended tab's current ordinary URL in the declared profile, then inspect that exact URL and verify the action's effect. Do not replay an uncertain mutation or re-admit solely because navigation ended the old attachment. Honor Stop or revoked access."
        ;;
      transition_unreadable|transition_unreadable_cleanup_failed)
        [[ "${AGENT_BROWSER_STAGED_PHASE:-}" != 'transition_unreadable_cleanup_failed' ]] ||
          printf '%s: Agent Browser retirement remained unresolved after transition proof failure\n' "$PROGRAM" >&2
        cleanup_agent_browser_temp_dir
        emit_error "$EXIT_PAGE_UNRESOLVED" 'agent_browser_page_unreadable' "$run_id" false \
          'Agent Browser could not prove the explicit destination after the action' \
          "Observe the intended tab's current ordinary URL and verify the action's effect. Do not replay the action. Honor Stop or revoked access."
        ;;
      url_mismatch|url_mismatch_cleanup_failed)
        [[ "${AGENT_BROWSER_STAGED_PHASE:-}" != 'url_mismatch_cleanup_failed' ]] ||
          printf '%s: Agent Browser retirement remained unresolved after page-mismatch failure\n' "$PROGRAM" >&2
        cleanup_agent_browser_temp_dir
        emit_error "$EXIT_PAGE_UNRESOLVED" 'agent_browser_page_mismatch' "$run_id" false \
          'Agent Browser bound a page that does not match the admitted page' \
          "Observe the intended tab's current ordinary URL in the declared profile, then inspect that exact URL and verify the action's effect. Do not replay an uncertain mutation or re-admit solely because navigation ended the old attachment. Honor Stop or revoked access."
        ;;
      cleanup_failed)
        if [[ "${AGENT_BROWSER_STAGED_STATUS:-0}" == '0' ]]; then
          cleanup_agent_browser_temp_dir
          emit_error "$EXIT_LIFECYCLE_UNRESOLVED" 'agent_browser_lifecycle_unresolved' "$run_id" false \
            'Agent Browser cleanup could not prove and retire its run-scoped session before relay handoff exit' \
            'Inspect the exact run-scoped Agent Browser session before retrying.'
        fi
        if [[ "${AGENT_BROWSER_STAGED_STATUS:-0}" != '0' ]]; then
          printf '%s: Agent Browser retirement remained unresolved after child failure\n' "$PROGRAM" >&2
          child_status="$AGENT_BROWSER_STAGED_STATUS"
        fi
        ;;
      work)
        child_status="$AGENT_BROWSER_STAGED_STATUS"
        ;;
      navigation)
        child_status="$AGENT_BROWSER_STAGED_STATUS"
        printf '%s\n' '{"status":"ok","action":"completed","page":"transitioned","remaining":0,"cleanup":"confirmed"}'
        ;;
      *)
        cleanup_agent_browser_temp_dir
        emit_error "$EXIT_LIFECYCLE_UNRESOLVED" 'agent_browser_lifecycle_unresolved' "$run_id" false \
          'Agent Browser session outcome could not be verified before relay handoff exit' \
          'Inspect the exact run-scoped Agent Browser session before retrying.'
        ;;
    esac
    cleanup_agent_browser_temp_dir
    exit "$child_status"
  fi

  [[ "$recovery_flags" == 'false' && "$handoff_flags" == 'false' ]] ||
    die_usage 'run does not accept recovery or handoff flags'
  [[ "$plan_file_set" == 'false' ]] || die_usage 'run does not accept --plan'
  [[ "$json" == 'false' ]] || die_usage 'run forwards child output and does not accept --json'
  [[ -n "$account_role" ]] || die_usage 'run requires --account-role'
  expected_role="$(jq -r '.account_role' <<<"$lane_value")"
  [[ "$account_role" == "$expected_role" ]] ||
    emit_error "$EXIT_PROFILE_MISMATCH" 'account_role_mismatch' "$run_id" false \
      "selected account role does not match lane $lane" \
      "Use the role reported by '$PROGRAM list'."
  [[ "$ttl_set" == 'true' ]] || ttl="$DEFAULT_TTL_SECONDS"
  [[ "$ttl" =~ ^[1-9][0-9]*$ && "$ttl" -le "$MAX_TTL_SECONDS" ]] ||
    die_usage "--ttl must be 1 through $MAX_TTL_SECONDS seconds"
  [[ "$#" -ge 3 ]] || die_usage 'run requires a command after --'
  [[ "${1##*/}" == 'mcporter' && "$2" == 'call' && "$3" == chrome-devtools.* ]] ||
    die_usage 'run accepts only: mcporter call chrome-devtools.TOOL ...'
  child_tool="${3#chrome-devtools.}"
  if [[ "$free_mode" == false ]] && is_prohibited_tool "$child_tool"; then
    emit_error "$EXIT_USAGE" 'prohibited_tool' "$run_id" false \
      "chrome-devtools tool is prohibited inside a lane run: $child_tool" \
      "Use a tool that stays inside the selected exact task page; page creation, navigation, selection, closing, PWA lifecycle, extension lifecycle, and out-of-band execution are not lane-run actions."
  fi
  if [[ "$free_mode" == false ]] && has_remembered_page_identifier "$@"; then
    emit_error "$EXIT_USAGE" 'remembered_page_identifier' "$run_id" false \
      'child arguments carry a remembered page identifier' \
      'Remove pageId and pageIdx; the lane resolves its admitted page for every run.'
  fi
  if [[ "$page_url_set" == 'true' ]] && [[ ! "$page_url" =~ ^https?://[^[:space:]]+$ ]]; then
    die_usage '--page-url must be an absolute http or https URL'
  fi
  if [[ "$free_mode" == false && "$child_tool" != 'list_pages' && "$page_url_set" == 'false' ]]; then
    emit_error "$EXIT_USAGE" 'page_url_required' "$run_id" false \
      "this chrome-devtools tool accesses page content and requires --page-url: $child_tool" \
      'Pass --page-url with the exact URL of the selected task page.'
  fi
  require_command openclaw "$run_id"
  require_command "$mcporter_bin" "$run_id"

  unset BROWSER_LANE_PAGE_ID
  acquire_lease "$lane" "$run_id" "$ttl"
  trap 'cleanup_page_list_file; release_lease "$lane" "$run_id"' EXIT HUP INT TERM
  refuse_while_handoff "$lane" "$lane_value" "$run_id"
  route_preflight "$lane" "$lane_value" "$run_id"
  if [[ "$free_mode" == false && "$page_url_set" == 'true' ]]; then
    resolve_admitted_page "$lane_value" "$page_url" "$run_id"
    export BROWSER_LANE_PAGE_ID="$resolved_page_id"
  fi
  if [[ "$free_mode" == true || "$page_url_set" == 'true' ]]; then
    relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
    start_lane_activity "http://127.0.0.1:$relay_port" "$run_id" 'chrome-devtools' "$ttl"
  fi

  # mcporter does not read BROWSER_LANE_PAGE_ID as tool input, so the resolved
  # index is the functional handoff only when it is routed onto the child
  # command line as a named argument. Every permitted chrome-devtools tool
  # except `list_pages` requires `pageId`, and `list_pages` accepts no input at
  # all, so the injection is scoped to the tools that take it. Caller-supplied
  # `pageId` and `pageIdx` are already refused before the lease, so the routed
  # value is the only page identifier the child can ever see. mcporter stops
  # reading named arguments at a literal `--`, so a child that carries its own
  # terminator gets the routed argument inserted before it.
  child_argv=("$@")
  if [[ -n "$resolved_page_id" && "$child_tool" != 'list_pages' ]]; then
    child_argv=()
    page_id_routed='false'
    for child_arg in "$@"; do
      if [[ "$page_id_routed" == 'false' && "$child_arg" == '--' ]]; then
        child_argv+=("pageId=$resolved_page_id")
        page_id_routed='true'
      fi
      child_argv+=("$child_arg")
    done
    [[ "$page_id_routed" == 'true' ]] || child_argv+=("pageId=$resolved_page_id")
  fi
  child_argv[0]="$mcporter_bin"

  relay_port="$(jq -r '.relay_port' <<<"$lane_value")"
  export BROWSER_LANE_NAME="$lane"
  export BROWSER_LANE_RUN_ID="$run_id"
  set +e
  MCPORTER_NO_KEEPALIVE='*' \
    MCPORTER_CHROME_DEVTOOLS_RELAY_POLICY='require' \
    MCPORTER_CHROME_DEVTOOLS_RELAY_URL="http://127.0.0.1:$relay_port" \
    "${child_argv[@]}"
  child_status=$?
  set -e
  local action_outcome='failed'
  [[ "$child_status" != '0' ]] || action_outcome='completed'
  record_lane_outcome "$action_outcome" 'unknown' "$child_status"
  exit "$child_status"
}

main "$@"
