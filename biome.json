{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/docs/**/*.html",
			"!config/agents/skills/personal/classic-cinema/references/assets/ticket-template.html",
			"!config/agents/skills/personal/browser-use/src/prototypes",
			"!config/herdr/plugins",
			"!**/actions/assets",
			"!**/dist",
			"!**/coverage",
			"!config/tmuxinator/*.yml",
			"!config/opencode",
			"!config/superwhisper",
			"!config/para-obsidian",
			"!config/vault-manager",
			"!config/vscode",
			"!config/gspread",
			"!config/notion-cli",
			"!config/gogcli",
			"!config/uv",
			"!config/fish",
			"!misc",
			"!pnpm-lock.yaml",
			"!PROJECT_INDEX.json",
			"!.worktrees",
			"!.claude/worktrees",
			"!config/raycast",
			"!.agents/*",
			".agents/skills",
			"!.agents/skills/*",
			".agents/runtime",
			"!.agents/runtime/*",
			".agents/runtime/browser-connect",
			".agents/runtime/setup",
			".agents/runtime/warm-chrome"
		]
	},
	"formatter": {
		"enabled": false,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": false,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["config/vscode/**/*.json", "config/karabiner/**/*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},
		{
			"includes": ["config/karabiner/**/*.json"],
			"formatter": { "enabled": false }
		}
	]
}
