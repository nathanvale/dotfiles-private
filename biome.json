{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!config/tmuxinator/*.yml",
			"!config/opencode",
			"!config/superwhisper",
			"!config/para-obsidian",
			"!config/vault-manager",
			"!config/vscode",
			"!config/gspread",
			"!config/notion-cli",
			"!config/gogcli",
			"!config/uv",
			"!config/fish",
			"!misc",
			"!pnpm-lock.yaml",
			"!PROJECT_INDEX.json"
		]
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["config/vscode/**/*.json", "config/karabiner/**/*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},
		{
			"includes": ["config/karabiner/**/*.json"],
			"formatter": { "enabled": false }
		}
	]
}
