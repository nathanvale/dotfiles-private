{
	"$schema": "https://biomejs.dev/schemas/2.4.4/schema.json",
	"files": {
		"includes": [
			"**",
			"!config/tmuxinator/*.yml",
			"!config/opencode",
			"!config/superwhisper",
			"!config/para-obsidian",
			"!config/vault-manager",
			"!config/vscode",
			"!config/gspread",
			"!config/notion-cli",
			"!config/gogcli",
			"!config/uv",
			"!config/fish",
			"!misc",
			"!pnpm-lock.yaml",
			"!PROJECT_INDEX.json",
			"!.worktrees",
			"!.claude/worktrees",
			"!config/raycast",
			"!.agents/skills",
			"!.agents/runtime/agent-worktree",
			"!.agents/runtime/browser-connect",
			"!.agents/runtime/browser-use-security",
			"!.agents/runtime/cli-command-facade",
			"!.agents/runtime/cli-test-fixtures",
			"!.agents/runtime/mcporter-transport",
			"!.agents/runtime/session-corpus",
			"!.agents/runtime/vault-git-transaction-manager",
			"!.agents/runtime/warm-chrome",
			"!.agents/runtime/agent-native-state-machine-generator/prototypes",
			"!.agents/runtime/agent-native-state-machine-generator/fixtures"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["config/vscode/**/*.json", "config/karabiner/**/*.json"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		},
		{
			"includes": ["config/karabiner/**/*.json"],
			"formatter": { "enabled": false }
		}
	]
}
